At":"2026-03-30T04:43:25.299Z","langs":["en"],"reply":{"parent":{"cid":"bafyreienxlda3ma6wxrwvxyti7qomhqfdkotx5iplrsxcd3twcedetc2gm","uri":"at://did:plc:ygyvxq2zj37swjm7fe3ylmuc/app.bsky.feed.post/3miatuxpkcs2p"},"root":{"cid":"bafyreiauxgyxtkxuk6rgonxiam6ukfzq736cak2ramkoyrtu3t56vdzwq4","uri":"at://did:plc:qc6xzgctorfsm35w6i3vdebx/app.bsky.feed.post/3miabmrzhh22m"}},"text":"Maybe you don’t follow Ed enough to know how he has been lying about this. I don’t care about the phrase, the point is where the gross margins are."},"bookmarkCount":0,"replyCount":3,"repostCount":0,"likeCount":4,"quoteCount":0,"indexedAt":"2026-03-30T04:43:25.657Z","labels":[]},"parent":{"post":{"uri":"at://did:plc:ygyvxq2zj37swjm7fe3ylmuc/app.bsky.feed.post/3miatuxpkcs2p","cid":"bafyreienxlda3ma6wxrwvxyti7qomhqfdkotx5iplrsxcd3twcedetc2gm","author":{"did":"did:plc:ygyvxq2zj37swjm7fe3ylmuc","handle":"andymorrish.bsky.social","displayName":"Andy Morrish","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:ygyvxq2zj37swjm7fe3ylmuc/bafkreigp4wnygnxschz725vswz2ehdm2rjo2ry2askppbl4sj6a3nhclyq","associated":{"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[],"createdAt":"2024-11-12T03:08:36.007Z"},"record":{"$type":"app.bsky.feed.post","createdAt":"2026-03-30T04:41:12.723Z","embed":{"$type":"app.bsky.embed.images","images":[{"alt":"Quote from Dario Amodei: Think about it this way. Again, these are stylized facts. These numbers are not exact. I’m just trying to make a toy model here. Let’s say half of your compute is for training and half of your compute is for inference. The inference has some gross margin that’s more than 50%.\n\nSo what that means is that if you were in steady-state, you build a data center and if you knew exactly the demand you were getting, you would get a certain amount of revenue. Let’s say you pay $100 billion a year for compute. On $50 billion a year you support $150 billion of revenue. The other $50 billion is used for training. Basically you’re profitable and you make $50 billion of profit. Those are the economics of the industry today, or not today but where we’re projecting forward in a year or two.","aspectRatio":{"height":1591,"width":1170},"image":{"$type":"blob","ref":{"$link":"bafkreidbfjkhzdu45ykhfzio3npkfc7m6nf5tm247kelai3dica4r6hldi"},"mimeType":"image/jpeg","size":972861}}]},"langs":["en"],"reply":{"parent":{"cid":"bafyreieye4hyrnmvqc5e5idgssvgkr5iperb2e3nuexa3wrrwxikmpnpu4","uri":"at://did:plc:z7oad4td5k4tfb4dttzjym7r/app.bsky.feed.post/3miath4tx4224"},"root":{"cid":"bafyreiauxgyxtkxuk6rgonxiam6ukfzq736cak2ramkoyrtu3t56vdzwq4","uri":"at://did:plc:qc6xzgctorfsm35w6i3vdebx/app.bsky.feed.post/3miabmrzhh22m"}},"text":"Here is the quote from Amodei… not seeing the lie in what Ed said. Ed says Amodei called it “stylized facts” which is exactly what the quote says. Maybe I’m not enough of a tech billionaire to understand?"},"embed":{"images":[{"thumb":"https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:ygyvxq2zj37swjm7fe3ylmuc/bafkreidbfjkhzdu45ykhfzio3npkfc7m6nf5tm247kelai3dica4r6hldi","fullsize":"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:ygyvxq2zj37swjm7fe3ylmuc/bafkreidbfjkhzdu45ykhfzio3npkfc7m6nf5tm247kelai3dica4r6hldi","alt":"Quote from Dario Amodei: Think about it this way. Again, these are stylized facts. These numbers are not exact. I’m just trying to make a toy model here. Let’s say half of your compute is for training and half of your compute is for inference. The inference has some gross margin that’s more than 50%.\n\nSo what that means is that if you were in steady-state, you build a data center and if you knew exactly the demand you were getting, you would get a certain amount of revenue. Let’s say you pay $100 billion a year for compute. On $50 billion a year you support $150 billion of revenue. The other $50 billion is used for training. Basically you’re profitable and you make $50 billion of profit. Those are the economics of the industry today, or not today but where we’re projecting forward in a year or two.","aspectRatio":{"height":1591,"width":1170}}],"$type":"app.bsky.embed.images#view"},"bookmarkCount":0,"replyCount":1,"repostCount":0,"likeCount":7,"quoteCount":0,"indexedAt":"2026-03-30T04:41:16.255Z","labels":[]},"threadContext":{},"$type":"app.bsky.feed.defs#threadViewPost"},"threadContext":{},"$type":"app.bsky.feed.defs#threadViewPost"},"threadContext":{},"$type":"app.bsky.feed.defs#threadViewPost"},"replies":[{"post":{"uri":"at://did:plc:ygyvxq2zj37swjm7fe3ylmuc/app.bsky.feed.post/3miawzte2sk27","cid":"bafyreiho5b6bi762o2cuss5ifmj4iemlnxfooymhzrtozeezk376abmkim","author":{"did":"did:plc:ygyvxq2zj37swjm7fe3ylmuc","handle":"andymorrish.bsky.social","displayName":"Andy Morrish","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:ygyvxq2zj37swjm7fe3ylmuc/bafkreigp4wnygnxschz725vswz2ehdm2rjo2ry2askppbl4sj6a3nhclyq","associated":{"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[],"createdAt":"2024-11-12T03:08:36.007Z"},"record":{"$type":"app.bsky.feed.post","createdAt":"2026-03-30T05:37:37.163Z","langs":["en"],"reply":{"parent":{"cid":"bafyreihsyj553osq4sfces6nnnm3u2quv7gvfu53b7w5cigcco55obt7ou","uri":"at://did:plc:z7oad4td5k4tfb4dttzjym7r/app.bsky.feed.post/3miawblqk7224"},"root":{"cid":"bafyreiauxgyxtkxuk6rgonxiam6ukfzq736cak2ramkoyrtu3t56vdzwq4","uri":"at://did:plc:qc6xzgctorfsm35w6i3vdebx/app.bsky.feed.post/3miabmrzhh22m"}},"text":"Well, I’m convinced. The “just trust us” argument is working!"},"bookmarkCount":0,"replyCount":1,"repostCount":0,"likeCount":8,"quoteCount":0,"indexedAt":"2026-03-30T05:37:38.151Z","labels":[]},"threadContext":{},"$type":"app.bsky.feed.defs#threadViewPost"}],"threadContext":{},"$type":"app.bsky.feed.defs#threadViewPost"}}