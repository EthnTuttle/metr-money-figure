fiedStatus":"valid","trustedVerifierStatus":"none"}},"record":{"$type":"app.bsky.feed.post","createdAt":"2026-09-11T14:14:51.347Z","langs":["en"],"reply":{"parent":{"cid":"bafyreiazql5hkgzsip3rzo7j4r4fr4dfzo4ilesq4h727cvwj7dhg35jnq","uri":"at://did:plc:z7oad4td5k4tfb4dttzjym7r/app.bsky.feed.post/3mvaqtffuwc2o"},"root":{"cid":"bafyreidh5pjgnine2ggah3mv2wadmwtcurondjkl5jpbt7m2ice2clf22i","uri":"at://did:plc:bjaceaxgoto5p7gor2rcov3g/app.bsky.feed.post/3mvalidmqoc24"}},"text":"Generally I think things need to slow down and there are a lot of ways to do that, all complicated. The data center opposition is actually helpful from my POV!"},"bookmarkCount":0,"replyCount":0,"repostCount":0,"likeCount":0,"quoteCount":0,"indexedAt":"2026-09-11T14:14:52.168Z","labels":[]},"threadContext":{},"$type":"app.bsky.feed.defs#threadViewPost"},{"post":{"uri":"at://did:plc:bjaceaxgoto5p7gor2rcov3g/app.bsky.feed.post/3mvar242vjc22","cid":"bafyreiaxg5ge3hlhklkwjsqfesdmriqktyggzfgjvpntvcvl5anwbnmfma","author":{"did":"did:plc:bjaceaxgoto5p7gor2rcov3g","handle":"yetanotheruseless.com","displayName":"jake","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:bjaceaxgoto5p7gor2rcov3g/bafkreid2mupigj6y73b6fsmvfrqkaq6tnkhwpuuitcoh34miem3audxf6e","associated":{"chat":{"allowIncoming":"all","allowGroupInvites":"all"},"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[],"createdAt":"2023-05-13T04:19:35.099Z"},"record":{"$type":"app.bsky.feed.post","createdAt":"2026-09-11T14:17:55.010Z","langs":["en"],"reply":{"parent":{"cid":"bafyreiazql5hkgzsip3rzo7j4r4fr4dfzo4ilesq4h727cvwj7dhg35jnq","uri":"at://did:plc:z7oad4td5k4tfb4dttzjym7r/app.bsky.feed.post/3mvaqtffuwc2o"},"root":{"cid":"bafyreidh5pjgnine2ggah3mv2wadmwtcurondjkl5jpbt7m2ice2clf22i","uri":"at://did:plc:bjaceaxgoto5p7gor2rcov3g/app.bsky.feed.post/3mvalidmqoc24"}},"text":"Agent swarms are very real and have completely plausible negative consequences, totally independent of extinction\n\nI’m looking for an answer to “how should someone worried about the end of humanity, specifically, best allocate their efforts to mitigate *that*?”\n\nAny not *also* solving smaller dooms?"},"bookmarkCount":0,"replyCount":1,"repostCount":0,"likeCount":0,"quoteCount":0,"indexedAt":"2026-09-11T14:17:55.869Z","labels":[]},"threadContext":{},"$type":"app.bsky.feed.defs#threadViewPost"}],"threadContext":{},"$type":"app.bsky.feed.defs#threadViewPost"}}