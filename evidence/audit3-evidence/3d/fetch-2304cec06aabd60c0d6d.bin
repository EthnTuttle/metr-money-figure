      <iframe
        id="html-snippet-871519-89414-frame"
        class="w-full border-0 overflow-hidden"
        style="width: 100%; border: 0; display: block;"
        loading="lazy"
        sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
        srcdoc="&lt;&#x21;DOCTYPE&#x20;html&gt;&#x0D;&#x0A;&lt;html&#x20;lang&#x3D;&quot;en&quot;&gt;&#x0D;&#x0A;&lt;head&gt;&#x0D;&#x0A;&lt;meta&#x20;charset&#x3D;&quot;utf-8&quot;&gt;&#x0D;&#x0A;&lt;meta&#x20;name&#x3D;&quot;viewport&quot;&#x20;content&#x3D;&quot;width&#x3D;device-width,&#x20;initial-scale&#x3D;1&quot;&gt;&#x0D;&#x0A;&lt;title&gt;Founder&#x20;Projects&#x20;Database&lt;&#x2F;title&gt;&#x0D;&#x0A;&#x0D;&#x0A;&lt;&#x21;--&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;Coefficient&#x20;Giving&#x20;&#x2014;&#x20;Initiatives&#x3A;&#x20;CAROUSEL&#x20;&#x2B;&#x20;PROJECT&#x20;DATABASE&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;---------------------------------------------------------------------&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;Two&#x20;previously&#x20;separate&#x20;embeds&#x20;in&#x20;one&#x20;component&#x3A;&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;1.&#x20;the&#x20;focus-areas&#x20;quote&#x20;carousel&#x20;&#x28;headerless&#x20;variant&#x29;,&#x20;on&#x20;top&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;2.&#x20;the&#x20;founder-projects&#x20;database&#x20;&#x2014;&#x20;accordion&#x20;&#x2B;&#x20;contents&#x20;nav&#x20;&#x2014;&#x20;below&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;They&#x20;remain&#x20;two&#x20;self-contained,&#x20;independently&#x20;portable&#x20;blocks&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x28;.cg-fac2&#x20;and&#x20;.cg-fpg,&#x20;each&#x20;carrying&#x20;its&#x20;own&#x20;&lt;style&gt;&#x20;and&#x20;&lt;script&gt;&#x29;.&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;What&#x20;the&#x20;combination&#x20;buys&#x20;is&#x20;that&#x20;a&#x20;click&#x20;on&#x20;a&#x20;carousel&#x20;card&#x20;is&#x20;now&#x20;a&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;SAME-DOCUMENT&#x20;deep&#x20;link&#x3A;&#x20;it&#x20;opens&#x20;the&#x20;matching&#x20;project&#x20;in&#x20;the&#x20;database&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;below&#x20;and&#x20;scrolls&#x20;to&#x20;it,&#x20;instead&#x20;of&#x20;navigating&#x20;the&#x20;browser.&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;Three&#x20;things&#x20;differ&#x20;from&#x20;the&#x20;two&#x20;standalone&#x20;files,&#x20;each&#x20;marked&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;COMBINED&#x20;BUILD&quot;&#x20;in&#x20;the&#x20;code&#x3A;&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2022;&#x20;Card&#x20;links&#x20;are&#x20;bare&#x20;&#x60;&#x23;&lt;project-slug&gt;&#x60;&#x20;fragments&#x20;resolved&#x20;in&#x20;THIS&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;document,&#x20;so&#x20;a&#x20;click&#x20;never&#x20;navigates&#x20;or&#x20;opens&#x20;a&#x20;tab.&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2022;&#x20;The&#x20;database&#x20;reads&#x20;both&#x20;this&#x20;document&#x27;s&#x20;hash&#x20;and&#x20;the&#x20;host&#x20;page&#x27;s,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;and&#x20;uses&#x20;whichever&#x20;resolves.&#x20;The&#x20;carousel&#x20;sets&#x20;ours&#x3B;&#x20;a&#x20;pasted&#x20;share&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;URL&#x20;lands&#x20;on&#x20;the&#x20;host&#x27;s.&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2022;&#x20;ONE&#x20;iframe&#x20;resizer,&#x20;in&#x20;the&#x20;database&#x20;block,&#x20;measuring&#x20;to&#x20;the&#x20;bottom&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;of&#x20;the&#x20;page&#x20;so&#x20;the&#x20;height&#x20;includes&#x20;the&#x20;carousel.&#x20;Two&#x20;resizers&#x20;would&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;fight&#x20;over&#x20;it,&#x20;so&#x20;the&#x20;carousel&#x20;only&#x20;nudges&#x20;a&#x20;resize&#x20;event&#x20;when&#x20;its&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;own&#x20;layout&#x20;changes.&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;TO&#x20;EMBED&#x3A;&#x20;paste&#x20;this&#x20;whole&#x20;file&#x20;into&#x20;a&#x20;code&#x20;embed&#x20;&#x2F;&#x20;custom-HTML&#x20;block,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;or&#x20;iframe&#x20;it&#x20;&#x2014;&#x20;it&#x20;auto-sizes&#x20;and&#x20;suppresses&#x20;its&#x20;own&#x20;scrollbar.&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x20;--&gt;&#x0D;&#x0A;&#x0D;&#x0A;&lt;&#x21;--&#x20;Default&#x20;target&#x20;for&#x20;any&#x20;link&#x20;that&#x20;doesn&#x27;t&#x20;set&#x20;its&#x20;own,&#x20;so&#x20;a&#x20;genuinely&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;external&#x20;link&#x20;added&#x20;later&#x20;escapes&#x20;the&#x20;embed&#x20;iframe&#x20;instead&#x20;of&#x20;loading&#x20;a&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;page&#x20;inside&#x20;a&#x20;page.&#x20;Everything&#x20;currently&#x20;here&#x20;sets&#x20;its&#x20;own&#x20;target&#x20;and&#x20;is&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;unaffected&#x3A;&#x20;the&#x20;carousel&#x27;s&#x20;cards&#x20;are&#x20;in-page&#x20;fragments&#x20;&#x28;&quot;_self&quot;&#x29;,&#x20;and&#x20;the&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;database&#x27;s&#x20;author&#x20;&#x2F;&#x20;Download&#x20;&#x2F;&#x20;body&#x20;links&#x20;are&#x20;all&#x20;&quot;_blank&quot;.&#x20;--&gt;&#x0D;&#x0A;&lt;base&#x20;target&#x3D;&quot;_top&quot;&gt;&#x0D;&#x0A;&#x0D;&#x0A;&lt;link&#x20;rel&#x3D;&quot;preconnect&quot;&#x20;href&#x3D;&quot;https&#x3A;&#x2F;&#x2F;fonts.gstatic.com&quot;&#x20;crossorigin&gt;&#x0D;&#x0A;&#x0D;&#x0A;&lt;&#x21;--&#x20;Document-level&#x20;reset,&#x20;hoisted&#x20;out&#x20;of&#x20;the&#x20;carousel&#x20;block.&#x20;Standalone-preview&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;only&#x3B;&#x20;NOT&#x20;part&#x20;of&#x20;either&#x20;embed&#x20;block.&#x20;--&gt;&#x0D;&#x0A;&lt;style&gt;&#x0D;&#x0A;&#x20;&#x20;html,&#x20;body&#x20;&#x7B;&#x20;margin&#x3A;&#x20;0&#x3B;&#x20;padding&#x3A;&#x20;0&#x3B;&#x20;&#x7D;&#x0D;&#x0A;&#x20;&#x20;html&#x20;&#x7B;&#x20;-webkit-text-size-adjust&#x3A;&#x20;100&#x25;&#x3B;&#x20;&#x7D;&#x0D;&#x0A;&lt;&#x2F;style&gt;&#x0D;&#x0A;&#x0D;&#x0A;&lt;&#x21;--&#x20;The&#x20;one&#x20;styling&#x20;decision&#x20;the&#x20;combination&#x20;forces&#x3A;&#x20;breathing&#x20;room&#x20;between&#x20;the&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;carousel&#x27;s&#x20;arrow&#x20;controls&#x20;and&#x20;the&#x20;database&#x27;s&#x20;top&#x20;rule.&#x20;On&#x20;its&#x20;own&#x20;the&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;carousel&#x20;ends&#x20;10px&#x20;below&#x20;its&#x20;buttons,&#x20;which&#x20;reads&#x20;as&#x20;cramped&#x20;against&#x20;the&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;rule.&#x20;This&#x20;is&#x20;the&#x20;knob&#x20;to&#x20;turn&#x20;if&#x20;you&#x20;want&#x20;them&#x20;tighter&#x20;or&#x20;further&#x20;apart.&#x20;--&gt;&#x0D;&#x0A;&lt;style&gt;&#x0D;&#x0A;&#x20;&#x20;&#x23;cgfac2-root&#x20;&#x7B;&#x20;padding-bottom&#x3A;&#x20;36px&#x3B;&#x20;&#x7D;&#x0D;&#x0A;&lt;&#x2F;style&gt;&#x0D;&#x0A;&lt;&#x2F;head&gt;&#x0D;&#x0A;&lt;body&gt;&#x0D;&#x0A;&#x0D;&#x0A;&lt;&#x21;--&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x20;BLOCK&#x20;1&#x20;&#x2014;&#x20;CAROUSEL&#x20;&#x28;start&#x29;&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x20;--&gt;&#x0D;&#x0A;&lt;div&#x20;class&#x3D;&quot;cg-fac2&quot;&#x20;id&#x3D;&quot;cgfac2-root&quot;&gt;&#x0D;&#x0A;&lt;style&gt;&#x0D;&#x0A;&#x20;&#x20;&#x2F;&#x2A;&#x20;Space&#x20;Grotesk&#x20;&#x2014;&#x20;same&#x20;&#x40;import&#x20;URL&#x20;as&#x20;the&#x20;database&#x20;block&#x20;below,&#x20;so&#x20;the&#x20;two&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;blocks&#x20;share&#x20;a&#x20;single&#x20;font&#x20;request.&#x20;Must&#x20;be&#x20;the&#x20;first&#x20;rule&#x20;in&#x20;the&#x20;sheet.&#x20;&#x2A;&#x2F;&#x0D;&#x0A;&#x20;&#x20;&#x40;import&#x20;url&#x28;&#x27;https&#x3A;&#x2F;&#x2F;fonts.googleapis.com&#x2F;css2&#x3F;family&#x3D;Space&#x2B;Grotesk&#x3A;wght&#x40;300&#x3B;400&#x3B;500&#x3B;700&amp;display&#x3D;swap&#x27;&#x29;&#x3B;&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x2F;&#x2A;&#x20;----------&#x20;Brand&#x20;fonts&#x20;&#x28;production&#x20;CDN&#x29;&#x20;----------&#x20;&#x2A;&#x2F;&#x0D;&#x0A;&#x20;&#x20;&#x40;font-face&#x20;&#x7B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;font-family&#x3A;&#x20;&quot;FK&#x20;Grotesk&#x20;Neue&quot;&#x3B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;src&#x3A;&#x20;url&#x28;&quot;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;wp-content&#x2F;themes&#x2F;coefficient-giving&#x2F;public&#x2F;fonts&#x2F;FK&#x25;20Grotesk&#x25;20Neue&#x2F;FKGroteskNeue-Regular.woff2&quot;&#x29;&#x20;format&#x28;&quot;woff2&quot;&#x29;&#x3B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;font-weight&#x3A;&#x20;400&#x20;500&#x3B;&#x20;font-style&#x3A;&#x20;normal&#x3B;&#x20;font-display&#x3A;&#x20;swap&#x3B;&#x0D;&#x0A;&#x20;&#x20;&#x7D;&#x0D;&#x0A;&#x20;&#x20;&#x40;font-face&#x20;&#x7B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;font-family&#x3A;&#x20;&quot;FK&#x20;Grotesk&#x20;Neue&quot;&#x3B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;src&#x3A;&#x20;url&#x28;&quot;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;wp-content&#x2F;themes&#x2F;coefficient-giving&#x2F;public&#x2F;fonts&#x2F;FK&#x25;20Grotesk&#x25;20Neue&#x2F;FKGroteskNeue-Italic.woff2&quot