    fs-sans-md py-4 px-6 z-9999" href="#content">Skip to Content</a>

    
<header
	data-theme="blue-dark"	data-sticky-subnav	class="site-header sticky top-0 min-[600px]:top-[var(--wp-admin-bar-height,0px)] max-w-main mx-auto px-1 pt-1 lg:pt-2 lg:px-2 z-50 motion-reduce:transition-[color,background-color,border-color] transition-[color,background-color,border-color,transform] duration-300" x-data="{
				menuOpen: false,
				init() {
					const mediaQuery = window.matchMedia('(min-width: 64rem)');
					mediaQuery.onchange = (e) => {
						$dispatch('resize');
						if (e.matches && this.menuOpen) {
							this.menuOpen = false;
						}
					};

					// Use RAF for performant scroll updates
					const updateScroll = () => {
						document.documentElement.style.setProperty('--scroll-y', `${window.scrollY}px`);
						document.documentElement.toggleAttribute('data-scrolled', window.scrollY > 40);
					};
					updateScroll();
					let ticking = false;
					window.addEventListener('scroll', () => {
						if (!ticking) {
							window.requestAnimationFrame(() => {
								updateScroll();
								ticking = false;
							});
							ticking = true;
						}
					}, { passive: true });
				}
			}" x-init="init">


  <div
    class="
      top-[4px] min-[600px]:max-[1023px]:top-[calc(4px+var(--wp-admin-bar-height,0px))] lg:top-[calc(8px+var(--wp-admin-bar-height,0px))]
      max-w-main
