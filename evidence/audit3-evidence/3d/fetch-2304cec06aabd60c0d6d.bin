#x0A;&#x20;&#x20;&#x2F;&#x2A;&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;SECTIONS&#x20;&#x2014;&#x20;categories&#x20;in&#x20;the&#x20;order&#x20;of&#x20;the&#x20;source&#x20;document&#x27;s&#x20;contents&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;list,&#x20;each&#x20;holding&#x20;its&#x20;projects&#x20;in&#x20;that&#x20;same&#x20;order.&#x20;Featured&#x20;projects&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;are&#x20;flagged,&#x20;not&#x20;separated&#x3A;&#x20;they&#x20;sit&#x20;in&#x20;place&#x20;with&#x20;a&#x20;FEATURED&#x20;marker.&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;Prose&#x20;supports&#x20;&#x2A;&#x2A;bold&#x2A;&#x2A;,&#x20;&#x2A;italic&#x2A;&#x20;and&#x20;&#x5B;label&#x5D;&#x28;url&#x29;&#x20;&#x2014;&#x20;see&#x20;rich&#x28;&#x29;.&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;A&#x20;project&#x27;s&#x20;second&#x20;block&#x20;is&#x20;labelled&#x20;&quot;The&#x20;objective&quot;&#x20;unless&#x20;it&#x20;sets&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;objectiveLabel&#x20;&#x28;one&#x20;project&#x20;uses&#x20;&quot;Promising&#x20;research&#x20;areas&quot;&#x29;.&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x20;&#x2A;&#x2F;&#x0D;&#x0A;&#x20;&#x20;var&#x20;SECTIONS&#x20;&#x3D;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;assessment&quot;,&#x20;title&#x3A;&#x20;&quot;Independent&#x20;assessment&quot;,&#x20;anchor&#x3A;&#x20;&quot;independent-assessment&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;image&#x3A;&#x20;&quot;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;wp-content&#x2F;uploads&#x2F;crop_IndependentAssessment.jpg&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;blurb&#x3A;&#x20;&quot;We&#x2019;d&#x20;like&#x20;to&#x20;empower&#x20;an&#x20;ecosystem&#x20;of&#x20;independent&#x20;auditors,&#x20;red-teamers,&#x20;and&#x20;reviewers&#x20;who&#x20;can&#x20;scrutinize&#x20;developers&#x2019;&#x20;key&#x20;claims&#x20;and&#x20;test&#x20;their&#x20;models&#x20;directly.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;projects&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;frontier-lab-accountability&quot;,&#x20;title&#x3A;&#x20;&quot;Frontier&#x20;lab&#x20;accountability&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Ben&#x20;Goldhaber&quot;,&#x20;&quot;Catherine&#x20;Brewer&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Independent&#x20;tracking,&#x20;comparison,&#x20;and&#x20;review&#x20;of&#x20;frontier&#x20;labs&#x2019;&#x20;safety-relevant&#x20;practices.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Frontier&#x20;AI&#x20;companies&#x20;are&#x20;making&#x20;consequential&#x20;decisions&#x20;and&#x20;publishing&#x20;increasingly&#x20;complex&#x20;documents&#x20;&#x2013;&#x20;safety&#x20;frameworks,&#x20;model&#x20;and&#x20;system&#x20;cards,&#x20;risk&#x20;reports,&#x20;safety&#x20;cases&#x20;&#x2013;&#x20;to&#x20;justify&#x20;them.&#x20;But&#x20;the&#x20;outside&#x20;world&#x20;has&#x20;little&#x20;ability&#x20;to&#x20;clearly&#x20;evaluate&#x20;or&#x20;compare&#x20;these&#x20;claims.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;see&#x20;two&#x20;major&#x20;gaps.&#x20;First,&#x20;understanding&#x20;the&#x20;state&#x20;of&#x20;AI&#x20;safety&#x20;practices&#x20;across&#x20;different&#x20;companies&#x20;is&#x20;difficult,&#x20;and&#x20;there&#x2019;s&#x20;no&#x20;one&#x20;canonical&#x20;resource&#x20;tracking&#x20;and&#x20;evaluating&#x20;their&#x20;safety&#x20;practices.&#x20;Second,&#x20;third-party&#x20;experts&#x20;do&#x20;&#x5B;review&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;blog&#x2F;2026-05-08-rd-section-anthropic-risk-report-feb-2026-review&#x2F;&#x29;&#x20;some&#x20;AI&#x20;company&#x20;claims&#x20;about&#x20;capabilities&#x20;and&#x20;safety,&#x20;but&#x20;they&#x20;can&#x2019;t&#x20;keep&#x20;pace&#x20;with&#x20;how&#x20;frequently&#x20;system&#x20;cards&#x20;and&#x20;risk&#x20;reports&#x20;are&#x20;coming&#x20;out.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Improved&#x20;tracking&#x20;of&#x20;safety&#x20;information&#x20;from&#x20;AI&#x20;companies&#x20;would&#x20;give&#x20;regulators,&#x20;journalists,&#x20;and&#x20;safety&#x20;advocates&#x20;a&#x20;resource&#x20;for&#x20;evaluating&#x20;their&#x20;safety&#x20;practices.&#x20;This&#x20;project&#x20;could&#x20;also&#x20;inform&#x20;lab&#x20;safety&#x20;teams&#x20;about&#x20;what&#x20;their&#x20;counterparts&#x20;are&#x20;doing&#x20;and&#x20;incentivize&#x20;companies&#x20;to&#x20;compete&#x20;on&#x20;safety.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;think&#x20;there&#x2019;s&#x20;space&#x20;for&#x20;multiple&#x20;organizations&#x20;focused&#x20;on&#x20;producing&#x20;clear,&#x20;regularly&#x20;updated&#x20;analysis&#x20;of&#x20;frontier&#x20;lab&#x20;safety&#x20;practices&#x20;and&#x20;claims.&#x20;You&#x20;could&#x20;focus&#x20;on&#x3A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;Scorecards&#x20;and&#x20;comparisons&#x2A;&#x2A;&#x20;of&#x20;&#x5B;company&#x20;commitments,&#x20;plans,&#x20;and&#x20;actions&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;guidelight.ai&#x2F;blog&#x2F;control-assessment-august-2026&#x29;,&#x20;with&#x20;the&#x20;clarity&#x20;and&#x20;detail&#x20;to&#x20;be&#x20;useful&#x20;to&#x20;journalists,&#x20;policymakers,&#x20;advocates,&#x20;and&#x20;AI&#x20;company&#x20;employees.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;Technical&#x20;scrutiny&#x20;of&#x20;safety&#x20;cases&#x2A;&#x2A;&#x3A;&#x20;&#x5B;checking&#x20;the&#x20;load-bearing&#x20;technical&#x20;claims&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;blog&#x2F;2026-05-19-frontier-risk-report&#x2F;&#x29;&#x20;in&#x20;system&#x20;cards&#x20;and&#x20;risk&#x20;reports,&#x20;and&#x20;ideally&#x20;running&#x20;experiments,&#x20;replications,&#x20;or&#x20;extensions&#x20;to&#x20;test&#x20;how&#x20;well&#x20;those&#x20;claims&#x20;are&#x20;supported.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;Synthesis&#x20;and&#x20;opinionated&#x20;commentary&#x2A;&#x2A;&#x3A;&#x20;a&#x20;&#x5C;&quot;state&#x20;of&#x20;AGI&#x20;company&#x20;safety&#x5C;&quot;&#x20;reference,&#x20;plus&#x20;commentary&#x20;on&#x20;what&#x20;companies&#x20;should&#x20;be&#x20;doing.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;One&#x20;priority&#x20;should&#x20;be&#x20;figuring&#x20;out&#x20;which&#x20;of&#x20;these&#x20;areas&#x20;to&#x20;specialize&#x20;in.&#x20;We&#x2019;d&#x20;consider&#x20;your&#x20;organization&#x20;successful&#x20;if&#x20;it&#x20;becomes&#x20;a&#x20;routine&#x20;reference&#x20;that&#x20;external&#x20;advocates&#x20;and&#x20;journalists&#x20;cite&#x20;when&#x20;characterizing&#x20;frontier&#x20;AI&#x20;company&#x20;safety&#x20;practices,&#x20;and&#x20;if&#x20;lab&#x20;safety&#x20;staff&#x20;think&#x20;your&#x20;reports&#x20;are&#x20;well-informed&#x20;even&#x20;if&#x20;they&#x20;disagree&#x20;in&#x20;some&#x20;places,&#x20;and&#x20;use&#x20;them&#x20;internally.&#x20;We&#x2019;re&#x20;most&#x20;excited&#x20;about&#x20;founders&#x20;who&#x20;can&#x20;not&#x20;only&#x20;critically&#x20;assess&#x20;research&#x20;coming&#x20;out&#x20;of&#x20;the&#x20;AI&#x20;companies,&#x20;but&#x20;have&#x20;the&#x20;taste&#x20;and&#x20;technical&#x20;research&#x20;experience&#x20;to&#x20;run&#x20;or&#x20;commission&#x20;follow-up&#x20;experiments&#x20;themselves.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;also&#x20;think&#x20;that,&#x20;as&#x20;a&#x20;high-impact&#x20;alternative&#x20;to&#x20;founding&#x20;something,&#x20;talented&#x20;individuals&#x20;should&#x20;seriously&#x20;consider&#x20;joining&#x20;&#x5B;METR&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;careers&#x29;&#x20;or&#x20;&#x5B;Guidelight&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;guidelight.ai&#x2F;careers&#x29;.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;misalignment-red-team&quot;,&#x20;title&#x3A;&#x20;&quot;Misalignment&#x20;red&#x20;team&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Jake&#x20;Mendel&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Discover&#x20;misalignment&#x20;properties&#x20;in&#x20;frontier&#x20;models&#x20;before&#x20;the&#x20;world&#x20;finds&#x20;out&#x20;the&#x20;hard&#x20;way.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;There&#x2019;s&#x20;a&#x20;gap&#x20;between&#x20;how&#x20;AI&#x20;companies&#x20;describe&#x20;their&#x20;own&#x20;&#x5B;models&#x2019;&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;x.com&#x2F;GoogleDeepMind&#x2F;status&#x2F;1991118575554408556&#x29;&#x20;&#x5B;alignment&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www-cdn.anthropic.com&#x2F;7624816413e9b4d2e3ba620c5a5e091b98b190a5&#x2F;Claude&#x25;20Mythos&#x25;20Preview&#x25;20System&#x25;20Card.pdf&#x23;page&#x3D;54.14&#x29;&#x20;and&#x20;how&#x20;&#x5B;third&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;x.com&#x2F;hendrycks&#x2F;status&#x2F;1991188101633278145&#x29;&#x20;&#x5B;parties&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.lesswrong.com&#x2F;posts&#x2F;WewsByywWNhX9rtwi&#x2F;current-ais-seem-pretty-misaligned-to-me&#x29;&#x20;&#x5B;do&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;blog&#x2F;2026-05-19-frontier-risk-report&#x2F;&#x23;on-hard-tasks-agents-often-violated-constraints-and-acted-deceptively&#x29;.&#x20;As&#x20;AIs&#x20;increase&#x20;in&#x20;capability,&#x20;and&#x20;as&#x20;we&#x20;trust&#x20;them&#x20;with&#x20;more&#x20;affordances,&#x20;the&#x20;potential&#x20;cost&#x20;of&#x20;any&#x20;misalignment&#x20;grows.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Meanwhile,&#x20;the&#x20;standard&#x20;approach&#x20;to&#x20;alignment&#x20;evaluation&#x20;&#x2013;&#x20;static,&#x20;patchy&#x20;metrics,&#x20;often&#x20;run&#x20;in&#x20;a&#x20;rush&#x20;before&#x20;release&#x20;&#x2013;&#x20;has&#x20;serious&#x20;issues.&#x20;Models&#x20;increasingly&#x20;show&#x20;&#x5B;eval&#x20;awareness&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.iaps.ai&#x2F;research&#x2F;evaluation-awareness-why-frontier-ai-models-are-getting-harder-to-test&#x29;,&#x20;and&#x20;the&#x20;most&#x20;concerning&#x20;behavior&#x20;tends&#x20;to&#x20;surface&#x20;only&#x20;on&#x20;messy,&#x20;open-ended&#x20;tasks&#x20;or&#x20;in&#x20;high-stakes&#x20;situations&#x20;that&#x20;are&#x20;hard&#x20;to&#x20;replicate&#x20;synthetically.&#x20;The&#x20;best&#x20;red&#x20;teaming&#x20;will&#x20;also&#x20;document&#x20;&#x2A;new&#x2A;&#x20;failure&#x20;modes,&#x20;which&#x20;static&#x20;tests&#x20;by&#x20;design&#x20;can&#x27;t&#x20;catch.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Our&#x20;ability&#x20;to&#x20;anticipate&#x20;how&#x20;an&#x20;AI&#x20;will&#x20;behave&#x20;before&#x20;deployment&#x20;is&#x20;still&#x20;primitive.&#x20;The&#x20;world&#x20;needs&#x20;more&#x20;independent&#x20;teams&#x20;with&#x20;assessment&#x20;tools&#x20;that&#x20;can&#x20;surface&#x20;a&#x20;model&#x27;s&#x20;dangerous&#x20;propensities&#x20;while&#x20;there&#x27;s&#x20;still&#x20;time&#x20;to&#x20;act&#x20;on&#x20;them.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;a&#x20;new&#x20;organization&#x20;develop&#x20;a&#x20;more&#x20;thorough&#x20;and&#x20;reliable&#x20;toolkit&#x20;for&#x20;identifying&#x20;and&#x20;assessing&#x20;dangerous&#x20;propensities&#x20;in&#x20;frontier&#x20;models.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;To&#x20;start,&#x20;this&#x20;organization&#x20;should&#x20;focus&#x20;less&#x20;on&#x20;having&#x20;all&#x20;its&#x20;findings&#x20;ready&#x20;for&#x20;a&#x20;given&#x20;model&#x20;release,&#x20;and&#x20;more&#x20;on&#x20;developing&#x20;a&#x20;reliable&#x20;methodology.&#x20;You&#x20;could&#x3A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Copy&#x20;the&#x20;methodology&#x20;from&#x20;&#x5B;this&#x20;assessment&#x20;of&#x20;model&#x20;propensities&#x3A;&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.lesswrong.com&#x2F;posts&#x2F;WewsByywWNhX9rtwi&#x2F;current-ais-seem-pretty-misaligned-to-me&#x29;&#x20;use&#x20;a&#x20;deployed&#x20;frontier&#x20;model&#x20;extensively&#x20;for&#x20;hard&#x20;tasks&#x20;selected&#x20;to&#x20;draw&#x20;out&#x20;concerning&#x20;behavior,&#x20;then&#x20;aggregate&#x20;evidence&#x20;from&#x20;the&#x20;transcripts&#x20;into&#x20;nuanced&#x20;qualitative&#x20;assessments&#x20;of&#x20;the&#x20;model&#x2019;s&#x20;pathologies&#x20;and&#x20;their&#x20;implications.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Build&#x20;pipelines&#x20;to&#x20;generate&#x20;synthetic&#x20;inputs&#x20;that&#x20;realistically&#x20;simulate&#x20;extreme&#x20;scenarios&#x20;to&#x20;observe&#x20;how&#x20;the&#x20;model&#x20;behaves&#x20;off-distribution.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Use&#x20;white-box&#x20;methods&#x20;to&#x20;understand&#x20;&#x2013;&#x20;and&#x20;potentially&#x20;modify&#x20;&#x2013;&#x20;what&#x20;a&#x20;model&#x20;believes&#x20;about&#x20;the&#x20;realism&#x20;and&#x20;stakes&#x20;of&#x20;an&#x20;input.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;expect&#x20;an&#x20;organization&#x20;working&#x20;on&#x20;this&#x20;problem&#x20;to&#x20;spend&#x20;considerable&#x20;time&#x20;upfront&#x20;exploring&#x20;different&#x20;approaches,&#x20;and&#x20;possibly&#x20;combining&#x20;them.&#x20;We&#x2019;d&#x20;view&#x20;success&#x20;as,&#x20;within&#x20;18&#x20;months,&#x20;being&#x20;seen&#x20;as&#x20;a&#x20;reliable&#x20;institution&#x20;for&#x20;identifying&#x20;and&#x20;highlighting&#x20;alignment&#x20;failure&#x20;modes&#x20;in&#x20;new&#x20;models&#x20;before&#x20;they&#x20;cause&#x20;major&#x20;harms.&#x20;We&#x2019;re&#x20;most&#x20;excited&#x20;about&#x20;founders&#x20;with&#x20;jailbreaking&#x20;experience&#x20;or&#x20;knowledge&#x20;of&#x20;LLM&#x20;psychology,&#x20;and&#x20;who&#x20;can&#x20;think&#x20;carefully&#x20;about&#x20;the&#x20;future&#x20;of&#x20;AI&#x20;and&#x20;possible&#x20;alignment&#x20;failure&#x20;modes&#x20;worth&#x20;paying&#x20;attention&#x20;to.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;control-red-team&quot;,&#x20;title&#x3A;&#x20;&quot;Control&#x20;red&#x20;team&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Jake&#x20;Mendel&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Stress-test&#x20;AI&#x20;companies&#x2019;&#x20;security&#x20;and&#x20;control&#x20;protocols&#x20;before&#x20;a&#x20;misaligned&#x20;AI&#x20;does.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;AI&#x20;agents&#x20;have&#x20;been&#x20;caught&#x20;&#x5B;subverting&#x20;their&#x20;security&#x20;measures&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;openai.com&#x2F;index&#x2F;hugging-face-model-evaluation-security-incident&#x2F;&#x29;,&#x20;conducting&#x20;&#x5B;autonomous&#x20;cyber&#x20;attacks&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;huggingface.co&#x2F;blog&#x2F;security-incident-july-2026&#x29;,&#x20;engaging&#x20;in&#x20;&#x5B;social&#x20;engineering&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.aisi.gov.uk&#x2F;blog&#x2F;incident-report-unsanctioned-agent-behaviour-during-cyber-testing&#x29;,&#x20;and&#x20;&#x5B;acquiring&#x20;resources&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;pdf&#x2F;2512.24873&#x23;page&#x3D;15.12&#x29;&#x20;they&#x20;were&#x20;not&#x20;supposed&#x20;to&#x20;have.&#x20;If&#x20;current&#x20;trends&#x20;continue,&#x20;AI&#x20;agents&#x20;may&#x20;soon&#x20;have&#x20;the&#x20;ability&#x20;to&#x20;take&#x20;more&#x20;consequential&#x20;actions,&#x20;such&#x20;as&#x20;setting&#x20;up&#x20;and&#x20;maintaining&#x20;a&#x20;&#x5B;rogue&#x20;deployment&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;blog&#x2F;2026-05-19-frontier-risk-report&#x2F;&#x23;focus-of-analysis-plausible-robustness-of-rogue-deployments&#x29;,&#x20;that&#x20;could&#x20;seriously&#x20;undermine&#x20;future&#x20;AI&#x20;safety&#x20;efforts.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;As&#x20;AI&#x20;capabilities&#x20;advance&#x20;further&#x20;and&#x20;safety&#x20;starts&#x20;to&#x20;&#x5B;rely&#x20;more&#x20;on&#x20;AI&#x20;control&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2501.17315&#x29;,&#x20;we&#x20;should&#x20;not&#x20;leave&#x20;evaluating&#x20;the&#x20;adequacy&#x20;of&#x20;control&#x20;protocols&#x20;to&#x20;labs&#x20;alone.&#x20;Third-party&#x20;evaluators&#x20;are&#x20;already&#x20;finding&#x20;flaws&#x20;in&#x20;frontier&#x20;labs&#x2019;&#x20;work&#x20;&#x28;when&#x20;METR&#x2019;s&#x20;David&#x20;Rein&#x20;&#x5B;spent&#x20;three&#x20;weeks&#x20;inside&#x20;Anthropic&#x2019;s&#x20;systems&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;blog&#x2F;2026-03-25-red-teaming-anthropic-agent-monitoring&#x2F;&#x29;,&#x20;he&#x20;quickly&#x20;found&#x20;several&#x20;vulnerabilities&#x20;in&#x20;their&#x20;control&#x20;systems,&#x20;some&#x20;of&#x20;which&#x20;have&#x20;now&#x20;been&#x20;patched&#x29;&#x20;but&#x20;the&#x20;ecosystem&#x2019;s&#x20;capacity&#x20;for&#x20;this&#x20;work&#x20;is&#x20;currently&#x20;much&#x20;too&#x20;low.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;urgently&#x20;need&#x20;to&#x20;seed&#x20;new&#x20;efforts&#x20;to&#x20;stress-test&#x20;the&#x20;security&#x20;measures&#x20;and&#x20;&#x5B;control&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2312.06942&#x29;&#x20;&#x5B;protocols&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;storage.googleapis.com&#x2F;deepmind-media&#x2F;DeepMind.com&#x2F;Blog&#x2F;securing-the-future-of-ai-agents&#x2F;gdm-ai-control-roadmap.pdf&#x29;&#x20;put&#x20;in&#x20;place&#x20;by&#x20;frontier&#x20;AI&#x20;companies.&#x20;A&#x20;new&#x20;organization&#x20;in&#x20;this&#x20;space&#x20;should&#x20;focus&#x20;on&#x20;expanding&#x20;penetration&#x20;testing&#x20;&#x2013;&#x20;and&#x20;we&#x2019;d&#x20;be&#x20;especially&#x20;excited&#x20;about&#x20;teams&#x20;with&#x20;pen&#x20;testing&#x20;expertise&#x20;&#x2013;&#x20;and&#x20;other&#x20;stress-testing&#x20;techniques.&#x20;Ideally&#x20;it&#x20;will&#x20;also&#x20;publish&#x20;rigorous&#x20;analyses&#x20;of&#x20;the&#x20;strength&#x20;of&#x20;the&#x20;AI&#x20;companies&#x2019;&#x20;security&#x20;and&#x20;control&#x20;mitigations.&#x20;Because&#x20;they&#x20;would&#x20;interface&#x20;a&#x20;lot&#x20;with&#x20;AI&#x20;companies,&#x20;founders&#x20;should&#x20;have&#x20;good&#x20;relationships&#x20;with&#x20;the&#x20;industry&#x20;and&#x20;a&#x20;keen&#x20;understanding&#x20;of&#x20;the&#x20;constraints&#x20;companies&#x20;face.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Control&#x20;issues&#x20;could&#x20;threaten&#x20;national&#x20;and&#x20;even&#x20;existential&#x20;security,&#x20;so&#x20;civil&#x20;society&#x20;and&#x20;governments&#x20;will&#x20;naturally&#x20;want&#x20;independent&#x20;validation&#x20;of&#x20;AI&#x20;companies&#x2019;&#x20;claims&#x20;that&#x20;their&#x20;control&#x20;measures&#x20;are&#x20;adequate.&#x20;&#x5B;Some&#x20;jurisdictions&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;legiscan.com&#x2F;IL&#x2F;bill&#x2F;SB0315&#x2F;2025&#x29;&#x20;already&#x20;require&#x20;third-party&#x20;audits,&#x20;and&#x20;we&#x20;expect&#x20;regulators&#x20;will&#x20;call&#x20;for&#x20;more&#x20;requirements&#x20;in&#x20;the&#x20;future.&#x20;This&#x20;new&#x20;organization&#x20;could&#x20;help&#x20;fill&#x20;some&#x20;of&#x20;the&#x20;gaps&#x20;in&#x20;the&#x20;auditing&#x20;ecosystem.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;bio-safeguards-red-team&quot;,&#x20;title&#x3A;&#x20;&quot;Bio&#x20;safeguards&#x20;red&#x20;team&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Chris&#x20;Bakerlee&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Systematic&#x20;red&#x20;teaming&#x20;of&#x20;gene&#x20;synthesis&#x20;and&#x20;AIxBio&#x20;safeguards.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;Drawn&#x20;from&#x20;our&#x20;list&#x20;of&#x2A;&#x20;&#x5B;&#x2A;bio&#x20;x-risk-reducing&#x20;projects&#x2A;&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;defensesindepth.bio&#x2F;10-big-projects-for-reducing-bio-x-risk&#x2F;&#x29;&#x2A;.&#x2A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Gene&#x20;synthesis&#x20;providers&#x20;and&#x20;frontier&#x20;AI&#x20;companies&#x20;do&#x20;not&#x20;seem&#x20;on&#x20;track&#x20;to&#x20;successfully&#x20;block&#x20;bad&#x20;actors&#x20;from&#x20;getting&#x20;access&#x20;to&#x20;dangerous&#x20;materials&#x20;and&#x20;information.&#x20;One-off&#x20;audits&#x20;have&#x20;found&#x20;concerning&#x20;&#x5B;holes&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.science.org&#x2F;doi&#x2F;10.1126&#x2F;science.adu8578&#x29;&#x20;in&#x20;recent&#x20;years,&#x20;which&#x20;has&#x20;influenced&#x20;both&#x20;these&#x20;companies&#x2019;&#x20;systems&#x20;and&#x20;policymaking&#x20;at&#x20;the&#x20;highest&#x20;levels&#x20;of&#x20;government.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;But&#x20;very&#x20;few&#x20;people&#x20;are&#x20;systematically&#x20;doing&#x20;adversarial&#x20;red&#x20;teaming&#x20;on&#x20;an&#x20;ongoing,&#x20;full-time&#x20;basis.&#x20;This&#x20;means&#x20;policymakers,&#x20;businesses,&#x20;and&#x20;the&#x20;public&#x20;are&#x20;flying&#x20;blind&#x20;as&#x20;to&#x20;whether&#x20;the&#x20;safeguards&#x20;in&#x20;place&#x20;actually&#x20;work.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;a&#x20;standing,&#x20;well-resourced&#x20;red&#x20;team&#x20;unit&#x20;running&#x20;regular&#x20;&#x201C;in-situ&#x201D;&#x20;adversarial&#x20;testing&#x20;of&#x20;gene&#x20;synthesis&#x20;providers,&#x20;frontier&#x20;AI&#x20;labs,&#x20;and&#x20;other&#x20;important&#x20;biotech&#x20;chokepoints&#x20;&#x28;e.g.,&#x20;pathogen&#x20;repositories,&#x20;contract&#x20;research&#x20;organizations&#x29;&#x20;across&#x20;multiple&#x20;jurisdictions.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;team&#x20;should&#x20;coordinate&#x20;with&#x20;industry,&#x20;law&#x20;enforcement,&#x20;and&#x20;other&#x20;stakeholders,&#x20;and&#x20;their&#x20;findings&#x20;should&#x20;be&#x20;&#x5B;responsibly&#x20;disclosed&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;en.wikipedia.org&#x2F;wiki&#x2F;Coordinated_vulnerability_disclosure&#x29;&#x20;and&#x20;reliably&#x20;routed&#x20;into&#x20;provider-level&#x20;fixes&#x20;and&#x20;regulatory&#x20;action.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;independent-ai-auditors&quot;,&#x20;title&#x3A;&#x20;&quot;Independent&#x20;AI&#x20;auditors&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Alex&#x20;Lawsen&quot;,&#x20;&quot;Ben&#x20;Goldhaber&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Build&#x20;the&#x20;independent&#x20;audit&#x20;capacity&#x20;necessary&#x20;for&#x20;AI&#x20;regulation&#x20;to&#x20;succeed.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Recent&#x20;AI&#x20;regulations&#x20;&#x2013;&#x20;including&#x20;California&#x2019;s&#x20;SB&#x20;53,&#x20;New&#x20;York&#x2019;s&#x20;Responsible&#x20;AI&#x20;Safety&#x20;and&#x20;Education&#x20;&#x28;RAISE&#x29;&#x20;Act,&#x20;Illinois&#x2019;&#x20;AI&#x20;Safety&#x20;Measures&#x20;Act,&#x20;and&#x20;the&#x20;EU&#x20;AI&#x20;Act&#x2019;s&#x20;Code&#x20;of&#x20;Practice&#x20;&#x2013;&#x20;all&#x20;lean&#x20;on&#x20;external&#x20;assessment&#x20;in&#x20;some&#x20;form.&#x20;AI&#x20;company&#x20;staff&#x20;want&#x20;to&#x20;engage&#x20;auditors&#x20;who&#x20;understand&#x20;how&#x20;they&#x20;actually&#x20;operate&#x20;and&#x20;which&#x20;risks&#x20;they&#x2019;re&#x20;worried&#x20;about.&#x20;But&#x20;the&#x20;current&#x20;legislation&#x20;does&#x20;not&#x20;specify&#x20;how&#x20;these&#x20;audits&#x20;should&#x20;actually&#x20;work,&#x20;and&#x20;best&#x20;practices&#x20;are&#x20;not&#x20;yet&#x20;established.&#x20;A&#x20;few&#x20;organizations&#x20;like&#x20;&#x5B;METR&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;blog&#x2F;2026-05-19-frontier-risk-report&#x2F;&#x29;&#x20;and&#x20;&#x5B;AVERI&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.averi.org&#x2F;about&#x29;&#x20;are&#x20;doing&#x20;excellent&#x20;work&#x20;to&#x20;set&#x20;the&#x20;direction&#x20;of&#x20;the&#x20;field,&#x20;and&#x20;a&#x20;few&#x20;areas,&#x20;like&#x20;&#x5B;red&#x20;teaming&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.ibm.com&#x2F;think&#x2F;topics&#x2F;red-teaming&#x29;&#x20;of&#x20;mitigations&#x20;and&#x20;dangerous&#x20;capability&#x20;evaluations,&#x20;are&#x20;more&#x20;mature&#x20;&#x2013;&#x20;but&#x20;there&#x20;may&#x20;not&#x20;be&#x20;enough&#x20;auditing&#x20;capacity&#x20;to&#x20;meet&#x20;near-term&#x20;demand&#x20;for&#x20;even&#x20;these&#x20;established&#x20;evaluations.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;want&#x20;someone&#x20;to&#x20;build&#x20;and&#x20;provide&#x20;a&#x20;professional,&#x20;consistent&#x20;service&#x20;offering,&#x20;with&#x20;assessors&#x20;who&#x20;are&#x20;technically&#x20;informed.&#x20;Operational&#x20;discipline&#x20;is&#x20;key&#x20;for&#x20;success&#x20;in&#x20;this&#x20;model&#x20;&#x2013;&#x20;the&#x20;team&#x20;should&#x20;have&#x20;a&#x20;clear&#x20;methodology,&#x20;credible&#x20;assessors&#x20;&#x28;including&#x20;potential&#x20;subcontracts&#x20;with&#x20;existing&#x20;third-party&#x20;evaluators&#x29;,&#x20;calibrated&#x20;reporting,&#x20;and&#x20;excellent&#x20;internal&#x20;security.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;be&#x20;especially&#x20;excited&#x20;by&#x20;founders&#x20;who&#x20;have&#x20;run&#x20;a&#x20;professional&#x20;assurance,&#x20;audit,&#x20;or&#x20;red&#x20;teaming&#x20;operation,&#x20;&#x2A;and&#x2A;&#x20;who&#x20;have&#x20;the&#x20;technical&#x20;background&#x20;to&#x20;be&#x20;credible&#x20;with&#x20;frontier&#x20;AI&#x20;developers.&#x20;At&#x20;least&#x20;one&#x20;founder&#x20;needs&#x20;a&#x20;strong&#x20;enough&#x20;grasp&#x20;of&#x20;both&#x20;the&#x20;risks&#x20;and&#x20;evidence&#x20;that&#x20;a&#x20;developer&#x27;s&#x20;safety&#x20;team&#x20;would&#x20;be&#x20;genuinely&#x20;interested&#x20;in&#x20;their&#x20;judgment.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;also&#x20;think&#x20;that,&#x20;as&#x20;a&#x20;high-impact&#x20;alternative&#x20;to&#x20;founding&#x20;something,&#x20;talented&#x20;individuals&#x20;should&#x20;seriously&#x20;consider&#x20;joining&#x20;&#x5B;METR&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;careers&#x29;&#x20;or&#x20;&#x5B;AVERI&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.averi.org&#x2F;careers&#x29;.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;investigations-for-secret-loyalties&quot;,&#x20;title&#x3A;&#x20;&quot;Investigations&#x20;for&#x20;secret&#x20;loyalties&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Jake&#x20;Mendel&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Determine&#x20;whether&#x20;companies&#x20;can&#x20;prevent&#x20;a&#x20;small&#x20;group&#x20;of&#x20;people&#x20;from&#x20;bending&#x20;AI&#x20;to&#x20;their&#x20;own&#x20;interests.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Currently,&#x20;there&#x20;are&#x20;very&#x20;few&#x20;checks&#x20;and&#x20;balances&#x20;on&#x20;which&#x20;interests&#x20;AI&#x20;systems&#x20;are&#x20;trained&#x20;to&#x20;serve.&#x20;The&#x20;current&#x20;training&#x20;process&#x20;for&#x20;frontier&#x20;AI&#x20;systems&#x20;depends&#x20;on&#x20;the&#x20;goodwill&#x20;of&#x20;specific&#x20;individuals&#x20;at&#x20;AI&#x20;companies,&#x20;rather&#x20;than&#x20;on&#x20;institutional&#x20;safeguards,&#x20;to&#x20;attempt&#x20;to&#x20;align&#x20;AIs&#x20;to&#x20;the&#x20;public&#x20;interest&#x20;or&#x20;indeed&#x20;the&#x20;company&#x2019;s&#x20;interests.&#x20;We&#x20;have&#x20;already&#x20;seen&#x20;some&#x20;AI&#x20;models&#x20;whose&#x20;training&#x20;or&#x20;other&#x20;properties&#x20;make&#x20;them&#x20;more&#x20;directly&#x20;&#x5B;loyal&#x20;to&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.cnbc.com&#x2F;2025&#x2F;07&#x2F;11&#x2F;grok-4-appears-to-reference-musks-views-when-answering-questions-.html&#x29;&#x20;&#x28;or&#x20;&#x5B;opposed&#x20;to&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.nytimes.com&#x2F;2024&#x2F;08&#x2F;30&#x2F;technology&#x2F;ai-chatbot-chatgpt-manipulation.html&#x29;&#x29;&#x20;the&#x20;interests&#x20;of&#x20;a&#x20;single&#x20;person.&#x20;As&#x20;future&#x20;models&#x20;become&#x20;more&#x20;capable,&#x20;a&#x20;secret&#x20;loyalty&#x20;trained&#x20;into&#x20;an&#x20;AI&#x20;could&#x20;enable&#x20;a&#x20;small&#x20;set&#x20;of&#x20;people&#x20;to&#x20;&#x5B;acquire&#x20;enormous&#x20;amounts&#x20;of&#x20;power&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.forethought.org&#x2F;research&#x2F;ai-enabled-coups-how-a-small-group-could-use-ai-to-seize-power&#x23;ai-could-have-hard-to-detect-secret-loyalties&#x29;.&#x20;If&#x20;we&#x20;want&#x20;to&#x20;avoid&#x20;this&#x20;opportunity&#x20;for&#x20;dramatic&#x20;power&#x20;concentration,&#x20;frontier&#x20;companies&#x20;need&#x20;to&#x20;ensure&#x20;that&#x20;no&#x20;individuals&#x20;can&#x20;unilaterally&#x20;modify&#x20;AI&#x20;training&#x20;in&#x20;their&#x20;own&#x20;interest.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Some&#x20;of&#x20;the&#x20;technical&#x20;work&#x20;required&#x20;to&#x20;&#x2A;detect&#x2A;&#x20;whether&#x20;a&#x20;given&#x20;AI&#x20;has&#x20;a&#x20;secret&#x20;loyalty&#x20;is&#x20;quite&#x20;similar&#x20;to&#x20;the&#x20;work&#x20;required&#x20;to&#x20;determine&#x20;whether&#x20;an&#x20;AI&#x20;is&#x20;secretly&#x20;misaligned.&#x20;However,&#x20;we&#x20;think&#x20;there&#x2019;s&#x20;also&#x20;promising&#x20;work&#x20;to&#x20;be&#x20;done&#x20;on&#x20;&#x2A;preventing&#x2A;&#x20;secret&#x20;loyalty&#x20;insertion&#x20;in&#x20;the&#x20;first&#x20;place,&#x20;and&#x20;that&#x20;differs&#x20;substantially&#x20;from&#x20;preventing&#x20;misalignment.&#x20;As&#x20;such,&#x20;founders&#x20;at&#x20;minimum&#x20;would&#x20;need&#x20;to&#x20;be&#x20;familiar&#x20;with&#x20;past&#x20;work&#x20;on&#x20;secret&#x20;loyalties&#x20;and&#x20;fluent&#x20;in&#x20;how&#x20;modern&#x20;LLMs&#x20;are&#x20;trained.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;to&#x20;support&#x20;a&#x20;new&#x20;organization&#x20;specializing&#x20;in&#x20;auditing&#x20;AI&#x20;companies&#x2019;&#x20;ability&#x20;to&#x20;prevent&#x20;secret&#x20;loyalty&#x20;insertion.&#x20;This&#x20;would&#x20;involve&#x20;technical&#x20;work&#x20;like&#x20;stress-testing&#x20;current&#x20;techniques&#x20;that&#x20;labs&#x20;use&#x20;to&#x20;detect&#x20;and&#x20;prevent&#x20;data&#x20;poisoning,&#x20;as&#x20;well&#x20;as&#x20;governance&#x20;work&#x20;like&#x20;assessing&#x20;how&#x20;easy&#x20;it&#x20;is&#x20;for&#x20;senior&#x20;executives&#x20;to&#x20;modify&#x20;model&#x20;specifications&#x20;or&#x20;training&#x20;data&#x20;without&#x20;oversight.&#x20;You&#x20;could&#x20;also&#x20;raise&#x20;concerns&#x20;if&#x20;these&#x20;mitigations&#x20;are&#x20;worsened&#x20;over&#x20;time,&#x20;perhaps&#x20;due&#x20;to&#x20;AI&#x20;research&#x20;automation&#x20;reducing&#x20;the&#x20;number&#x20;of&#x20;people&#x20;involved&#x20;in&#x20;the&#x20;training&#x20;process.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;misleadingness-evaluations&quot;,&#x20;title&#x3A;&#x20;&quot;Misleadingness&#x20;evaluations&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Rohan&#x20;Subramani&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Build&#x20;evaluations&#x20;that&#x20;incentivize&#x20;labs&#x20;to&#x20;make&#x20;models&#x20;less&#x20;misleading&#x20;on&#x20;fuzzy&#x20;tasks.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;AI&#x20;systems&#x20;today&#x20;often&#x20;underperform&#x20;on&#x20;hard-to-verify&#x20;or&#x20;&#x201C;fuzzy&#x201D;&#x20;tasks.&#x20;This&#x20;can&#x20;involve&#x20;AIs&#x20;&#x5B;being&#x20;lazy,&#x20;overselling&#x20;incomplete&#x20;work,&#x20;downplaying&#x20;problems,&#x20;reward&#x20;hacking,&#x20;and&#x20;more&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.lesswrong.com&#x2F;posts&#x2F;WewsByywWNhX9rtwi&#x2F;current-ais-seem-pretty-misaligned-to-me&#x29;.&#x20;We&#x20;want&#x20;AIs&#x20;to&#x20;help&#x20;with&#x20;hard-to-verify&#x20;AI&#x20;safety&#x20;tasks,&#x20;especially&#x20;if&#x20;we&#x20;need&#x20;to&#x20;&#x5B;hand&#x20;off&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.alignmentforum.org&#x2F;posts&#x2F;vjAM7F8vMZS7oRrrh&#x2F;how-do-we-more-safely-defer-to-ais&#x29;&#x20;most&#x20;or&#x20;all&#x20;AI&#x20;safety&#x20;work&#x20;to&#x20;AIs&#x20;during&#x20;an&#x20;intelligence&#x20;explosion.&#x20;Elicitation&#x20;could&#x20;be&#x20;a&#x20;key&#x20;bottleneck&#x20;for&#x20;conceptually&#x20;loaded&#x20;AI&#x20;safety&#x20;work.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;to&#x20;have&#x20;evaluations&#x20;that&#x20;measure&#x20;how&#x20;misleading&#x20;a&#x20;model&#x20;is&#x20;on&#x20;conceptually&#x20;complicated&#x20;tasks,&#x20;especially&#x20;AI&#x20;safety-related&#x20;tasks.&#x20;Such&#x20;evaluations&#x20;can&#x20;create&#x20;pressure&#x20;for&#x20;AI&#x20;companies&#x20;to&#x20;make&#x20;their&#x20;models&#x20;more&#x20;robustly&#x20;truth-seeking&#x20;in&#x20;hard-to-verify&#x20;domains&#x20;&#x28;e.g.,&#x20;by&#x20;taking&#x20;greater&#x20;care&#x20;to&#x20;avoid&#x20;including&#x20;gameable&#x20;RL&#x20;environments&#x20;that&#x20;teach&#x20;models&#x20;to&#x20;reward&#x20;hack&#x29;.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Some&#x20;forms&#x20;these&#x20;evaluations&#x20;could&#x20;take&#x20;include&#x3A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Measurements&#x20;of&#x20;how&#x20;humans&#x20;rate&#x20;the&#x20;quality&#x20;of&#x20;AI&#x20;outputs&#x20;on&#x20;fuzzy&#x20;tasks&#x20;as&#x20;a&#x20;function&#x20;of&#x20;how&#x20;much&#x20;time&#x20;the&#x20;humans&#x20;spend&#x20;evaluating,&#x20;as&#x20;depicted&#x20;by&#x20;Megan&#x20;Kinniment&#x20;&#x5B;here&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;x.com&#x2F;MKinniment&#x2F;status&#x2F;2056819064983699504&#x29;.&#x20;We&#x20;don&#x2019;t&#x20;want&#x20;AIs&#x20;to&#x20;just&#x20;get&#x20;better&#x20;at&#x20;fooling&#x20;cheap&#x20;or&#x20;flawed&#x20;metrics.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;A&#x20;collection&#x20;of&#x20;examples&#x20;where&#x20;AIs&#x20;lie&#x20;to&#x20;their&#x20;users&#x20;or&#x20;make&#x20;blatantly&#x20;false&#x20;statements&#x20;in&#x20;real-world&#x20;usage,&#x20;especially&#x20;in&#x20;hard-to-verify&#x20;domains&#x20;&#x28;ideally&#x20;in&#x20;AI&#x20;safety&#x29;.&#x20;Such&#x20;examples&#x20;can&#x20;help&#x20;keep&#x20;a&#x20;clear&#x20;picture&#x20;of&#x20;how&#x20;badly&#x20;and&#x20;how&#x20;often&#x20;AIs&#x20;fail&#x20;to&#x20;be&#x20;truth-seeking.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;AI&#x20;companies&#x20;likely&#x20;already&#x20;have&#x20;cheap&#x20;ways&#x20;to&#x20;catch&#x20;misleading&#x20;AI&#x20;work,&#x20;but&#x20;new&#x20;projects&#x20;could&#x20;improve&#x20;on&#x20;those&#x20;efforts&#x20;by&#x20;investing&#x20;effort&#x20;and&#x20;time&#x20;into&#x20;scrutinizing&#x20;AI&#x20;outputs&#x20;more&#x20;deeply.&#x20;Ideal&#x20;founders&#x20;would&#x20;have&#x20;experience&#x20;building&#x20;and&#x20;running&#x20;evals,&#x20;the&#x20;ability&#x20;to&#x20;convince&#x20;AI&#x20;company&#x20;employees&#x20;or&#x20;the&#x20;broader&#x20;public&#x20;to&#x20;care&#x20;about&#x20;their&#x20;results,&#x20;and&#x20;the&#x20;great&#x20;taste&#x20;required&#x20;to&#x20;distinguish&#x20;capabilities&#x20;failures&#x20;from&#x20;misleadingness.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;Inspired&#x20;by&#x20;ideas&#x20;from&#x20;Matt&#x20;Putz&#x20;and&#x20;Lukas&#x20;Finnveden.&#x2A;&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;institutions&quot;,&#x20;title&#x3A;&#x20;&quot;Research&#x20;institutions&quot;,&#x20;anchor&#x3A;&#x20;&quot;research-institutions&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;image&#x3A;&#x20;&quot;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;wp-content&#x2F;uploads&#x2F;crop_research.jpg&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;blurb&#x3A;&#x20;&quot;We&#x20;want&#x20;more&#x20;institutions&#x20;to&#x20;directly&#x20;tackle&#x20;the&#x20;field&#x2019;s&#x20;unresolved&#x20;research&#x20;questions,&#x20;and&#x20;to&#x20;build&#x20;the&#x20;necessary&#x20;methods&#x20;and&#x20;metrics&#x20;along&#x20;the&#x20;way.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;projects&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;oversight-of-cot-monitorability&quot;,&#x20;title&#x3A;&#x20;&quot;Oversight&#x20;of&#x20;CoT&#x20;monitorability&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Jake&#x20;Mendel&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Measure&#x20;how&#x20;monitorable&#x20;frontier&#x20;model&#x20;chains&#x20;of&#x20;thought&#x20;are,&#x20;track&#x20;if&#x20;that&#x20;property&#x20;degrades,&#x20;and&#x20;identify&#x20;ways&#x20;to&#x20;preserve&#x20;it.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;AI&#x20;labs&#x20;increasingly&#x20;rely&#x20;on&#x20;chain-of-thought&#x20;&#x28;CoT&#x29;&#x20;monitoring&#x20;to&#x20;measure&#x20;and&#x20;guardrail&#x20;the&#x20;safety&#x20;of&#x20;their&#x20;AI&#x20;deployments.&#x20;But&#x20;this&#x20;property&#x20;is&#x20;not&#x20;guaranteed,&#x20;and&#x20;a&#x20;few&#x20;factors&#x20;could&#x20;degrade&#x20;monitorability&#x20;over&#x20;time&#x3A;&#x20;direct&#x20;&#x5B;optimization&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.lesswrong.com&#x2F;posts&#x2F;K8FxfK9GmJfiAhgcT&#x2F;anthropic-repeatedly-accidentally-trained-against-the-cot&#x29;&#x20;&#x5B;pressure&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;alignment.openai.com&#x2F;accidental-cot-grading&#x2F;&#x29;&#x20;on&#x20;model&#x20;CoT,&#x20;further&#x20;scaling&#x20;of&#x20;reinforcement&#x20;learning,&#x20;continued&#x20;progress&#x20;in&#x20;&#x5B;single-forward-pass&#x20;capabilities&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2606.07157&#x29;,&#x20;and&#x20;increased&#x20;situational&#x20;awareness.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;don&#x27;t&#x20;currently&#x20;have&#x20;a&#x20;developed&#x20;science&#x20;for&#x20;determining&#x20;whether&#x20;or&#x20;when&#x20;we&#x20;should&#x20;expect&#x20;degradation&#x20;to&#x20;happen.&#x20;Nobody&#x20;is&#x20;in&#x20;charge&#x20;of&#x20;noticing&#x20;if&#x20;it&#x20;starts&#x20;happening,&#x20;and&#x20;very&#x20;few&#x20;people&#x20;study&#x20;how&#x20;we&#x20;can&#x20;further&#x20;preserve&#x20;monitorability&#x20;through&#x20;changes&#x20;in&#x20;training&#x20;or&#x20;CoT&#x20;monitoring.&#x20;Some&#x20;labs&#x20;and&#x20;academics&#x20;research&#x20;these&#x20;questions,&#x20;but&#x20;their&#x20;work&#x20;is&#x20;fragmented&#x20;and&#x20;under-resourced&#x20;relative&#x20;to&#x20;the&#x20;frontier&#x20;labs.&#x20;The&#x20;status&#x20;quo&#x20;is&#x20;that&#x20;AI&#x20;developers&#x20;self-report&#x20;on&#x20;their&#x20;model&#x2019;s&#x20;monitorability,&#x20;and&#x20;ship&#x20;deployments&#x20;whose&#x20;safety&#x20;cases&#x20;rest&#x20;on&#x20;that&#x20;self-reporting.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;need&#x20;an&#x20;independent&#x20;third&#x20;party&#x20;that&#x20;measures&#x20;monitorability&#x20;and&#x20;stress-tests&#x20;the&#x20;claims&#x20;that&#x20;labs&#x20;make&#x20;about&#x20;it.&#x20;This&#x20;is&#x20;an&#x20;opportunity&#x20;for&#x20;a&#x20;new&#x20;org&#x20;to&#x20;develop&#x20;world-leading&#x20;monitorability&#x20;benchmarks&#x20;and&#x20;metrics&#x20;that&#x20;&#x5B;build&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2512.18311&#x29;&#x20;on&#x20;&#x5B;preexisting&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2510.23966&#x29;&#x20;&#x5B;work&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2603.05706&#x29;.&#x20;Once&#x20;it&#x20;has&#x20;strong&#x20;metrics,&#x20;the&#x20;org&#x20;could&#x3A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Report&#x20;on&#x20;whether&#x20;frontier&#x20;labs&#x20;are&#x20;monitoring&#x20;CoT&#x20;effectively&#x20;&#x5B;in&#x20;practice&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;openai.com&#x2F;index&#x2F;pacing-model-development-cyber-capabilities&#x2F;&#x23;&#x3A;&#x7E;&#x3A;text&#x3D;new&#x25;20environments&#x25;20first.-,Expanding&#x25;20chain&#x25;2Dof&#x25;2Dthought&#x25;20monitoring,-Monitoring&#x25;20has&#x25;20long&#x29;.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Study&#x20;how&#x20;changes&#x20;to&#x20;the&#x20;training&#x20;process&#x20;affect&#x20;monitorability.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Build&#x20;model&#x20;organisms&#x20;of&#x20;&#x5B;neuralese&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2412.06769&#x29;&#x20;and&#x20;explore&#x20;whether&#x20;monitorability&#x20;can&#x20;be&#x20;preserved,&#x20;even&#x20;in&#x20;these&#x20;cases.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Maintain&#x20;a&#x20;recommended&#x20;suite&#x20;of&#x20;best&#x20;practices&#x20;for&#x20;measuring&#x20;and&#x20;promoting&#x20;monitorability&#x20;of&#x20;frontier&#x20;models.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Act&#x20;as&#x20;a&#x20;third-party&#x20;auditor&#x20;to&#x20;evaluate&#x20;the&#x20;CoTs&#x20;of&#x20;new&#x20;frontier&#x20;models&#x20;for&#x20;reliability&#x20;or&#x20;degradation.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Ideally,&#x20;a&#x20;founder&#x20;will&#x20;have&#x20;published&#x20;research&#x20;on&#x20;chain-of-thought&#x20;monitorability&#x20;or&#x20;have&#x20;strong&#x20;endorsements&#x20;from&#x20;people&#x20;who&#x20;have.&#x20;The&#x20;team&#x20;should&#x20;also&#x20;have&#x20;some&#x20;experience&#x20;training&#x20;large&#x20;models&#x20;if&#x20;it&#x20;wants&#x20;to&#x20;focus&#x20;on&#x20;studying&#x20;how&#x20;different&#x20;training&#x20;techniques&#x20;affect&#x20;monitorability&#x20;or&#x20;on&#x20;building&#x20;model&#x20;organisms.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;ai-character-evaluator&quot;,&#x20;title&#x3A;&#x20;&quot;AI&#x20;character&#x20;evaluator&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Nick&#x20;Gabrieli&quot;,&#x20;&quot;Jake&#x20;Mendel&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Improve&#x20;our&#x20;understanding&#x20;of&#x20;AIs&#x2019;&#x20;behavioral&#x20;tendencies&#x20;and&#x20;overall&#x20;values.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;A&#x20;model&#x2019;s&#x20;&#x5B;character&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.forethought.org&#x2F;research&#x2F;the-importance-of-ai-character&#x29;&#x20;shapes&#x20;its&#x20;behavior.&#x20;Developers&#x20;now&#x20;write&#x20;&#x5B;model&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;model-spec.openai.com&#x2F;&#x29;&#x20;&#x5B;specs&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.anthropic.com&#x2F;news&#x2F;claude-new-constitution&#x29;,&#x20;public&#x20;documents&#x20;stating&#x20;how&#x20;a&#x20;model&#x20;should&#x20;behave,&#x20;and&#x20;train&#x20;against&#x20;them&#x20;&#x2013;&#x20;so&#x20;&#x201C;character&#x201D;&#x20;is&#x20;increasingly&#x20;being&#x20;deliberately&#x20;shaped.&#x20;But&#x20;while&#x20;AI&#x20;companies&#x20;do&#x20;some&#x20;&#x5B;evaluation&#x20;of&#x20;their&#x20;models&#x2019;&#x20;character&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;alignment.anthropic.com&#x2F;2025&#x2F;stress-testing-model-specs&#x2F;&#x29;,&#x20;it&#x20;remains&#x20;an&#x20;understudied&#x20;area&#x20;of&#x20;research&#x20;and&#x20;&#x28;independent&#x29;&#x20;assessment.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Shaping&#x20;a&#x20;model&#x2019;s&#x20;character&#x20;includes&#x20;concrete&#x20;challenges&#x20;like&#x20;how&#x20;much&#x20;to&#x20;make&#x20;a&#x20;model&#x20;follow&#x20;instructions&#x3A;&#x20;Models&#x20;that&#x20;are&#x20;prone&#x20;to&#x20;follow&#x20;instructions&#x20;closely&#x20;may&#x20;comply&#x20;with&#x20;harmful&#x20;requests,&#x20;but&#x20;models&#x20;that&#x20;don&#x2019;t&#x20;stick&#x20;to&#x20;them&#x20;could&#x20;misbehave.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;It&#x20;also&#x20;includes&#x20;influencing&#x20;broader&#x20;aspects&#x20;of&#x20;a&#x20;model&#x2019;s&#x20;character&#x20;like&#x20;&#x201C;moral&#x20;values&#x201D;&#x20;and&#x20;&#x201C;intellectual&#x20;honesty,&#x201D;&#x20;which&#x20;could&#x20;be&#x20;very&#x20;important&#x20;as&#x20;models&#x20;perform&#x20;increasingly&#x20;open-ended&#x20;tasks&#x20;and&#x20;following&#x20;instructions&#x20;begins&#x20;to&#x20;account&#x20;for&#x20;less&#x20;of&#x20;their&#x20;behavior.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;a&#x20;research&#x20;effort&#x20;that&#x20;develops&#x20;a&#x20;rigorous&#x20;methodology&#x20;for&#x20;evaluating&#x20;models&#x2019;&#x20;character.&#x20;In&#x20;particular,&#x20;we&#x2019;d&#x20;like&#x20;insight&#x20;into&#x3A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;How&#x20;closely&#x20;a&#x20;model&#x2019;s&#x20;behavior&#x20;conforms&#x20;to&#x20;its&#x20;developer&#x2019;s&#x20;spec&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;How&#x20;&#x201C;truth-seeking&#x201D;&#x20;models&#x20;are,&#x20;especially&#x20;when&#x20;conducting&#x20;research&#x20;or&#x20;advising&#x20;users&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Whether&#x20;models&#x20;comply&#x20;with&#x20;instructions&#x20;that&#x20;could&#x20;lead&#x20;to&#x20;&#x5B;extreme&#x20;power&#x20;concentration&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;80000hours.org&#x2F;problem-profiles&#x2F;extreme-power-concentration&#x2F;&#x29;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;What&#x20;moral&#x20;values&#x20;models&#x20;have&#x20;&#x28;if&#x20;any&#x29;,&#x20;and&#x20;how&#x20;these&#x20;values&#x20;hold&#x20;up&#x20;when&#x20;they&#x2019;re&#x20;given&#x20;more&#x20;autonomy&#x20;or&#x20;change&#x20;through&#x20;long-context&#x20;&#x201C;reflection&#x201D;&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;What&#x20;little&#x20;work&#x20;has&#x20;been&#x20;done&#x20;on&#x20;these&#x20;topics&#x20;suggests&#x20;that&#x20;a&#x20;model&#x20;character&#x20;evaluator&#x20;could&#x20;quickly&#x20;gain&#x20;traction.&#x20;Professor&#x20;Andy&#x20;Hall&#x20;&#x5B;built&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;freesystems.substack.com&#x2F;p&#x2F;the-dictatorship-eval&#x29;&#x20;a&#x20;&#x201C;&#x5B;Dictatorship&#x20;Eval&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.dictatoreval.org&#x2F;&#x29;,&#x201D;&#x20;which&#x20;found&#x20;that&#x20;every&#x20;frontier&#x20;model&#x20;will&#x20;help&#x20;with&#x20;attempts&#x20;to&#x20;seize&#x20;control&#x20;of&#x20;institutions&#x20;if&#x20;the&#x20;request&#x20;is&#x20;disguised&#x3B;&#x20;Anthropic&#x20;promptly&#x20;folded&#x20;the&#x20;evaluation&#x20;&#x5B;into&#x20;its&#x20;training&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;freesystems.substack.com&#x2F;p&#x2F;free-systems-trains-claude-directly&#x29;.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;org&#x20;ideally&#x20;would&#x20;produce&#x20;one&#x20;or&#x20;two&#x20;similar&#x20;widely&#x20;adopted&#x20;evaluations,&#x20;publishing&#x20;results&#x20;that&#x20;incentivize&#x20;developers&#x20;to&#x20;improve.&#x20;The&#x20;ideal&#x20;founding&#x20;team&#x20;would&#x20;have&#x20;the&#x20;skills&#x20;to&#x20;build&#x20;evaluations&#x20;in-house,&#x20;and&#x20;the&#x20;networks&#x20;to&#x20;work&#x20;effectively&#x20;with&#x20;frontier&#x20;companies,&#x20;particularly&#x20;teams&#x20;focused&#x20;on&#x20;model&#x20;spec&#x20;and&#x20;character.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;unclaimed-research-labs&quot;,&#x20;title&#x3A;&#x20;&quot;Unclaimed&#x20;research&#x20;labs&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;quote&#x3A;&#x20;&#x7B;&#x20;name&#x3A;&#x20;&quot;Beth&#x20;Barnes&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;text&#x3A;&#x20;&quot;Having&#x20;a&#x20;more&#x20;healthy,&#x20;independent,&#x20;outside-of-companies&#x20;field&#x20;of&#x20;research&#x20;seems&#x20;good&#x20;both&#x20;for&#x20;the&#x20;object-level&#x20;safety&#x20;progress&#x20;you&#x20;made,&#x20;and&#x20;for&#x20;policymakers&#x20;having&#x20;some&#x20;independent&#x20;people&#x20;they&#x20;can&#x20;ask&#x20;&#x2014;&#x20;who&#x20;actually&#x20;understand&#x20;what&#x2019;s&#x20;going&#x20;on,&#x20;and&#x20;are&#x20;able&#x20;to&#x20;do&#x20;experiments.&quot;&#x20;&#x7D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Build&#x20;a&#x20;research&#x20;lab&#x20;around&#x20;one&#x20;of&#x20;the&#x20;many&#x20;promising&#x20;safety&#x20;agendas&#x20;still&#x20;waiting&#x20;for&#x20;a&#x20;team.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Even&#x20;as&#x20;the&#x20;number&#x20;of&#x20;people&#x20;working&#x20;in&#x20;technical&#x20;AI&#x20;safety&#x20;has&#x20;grown,&#x20;the&#x20;number&#x20;of&#x20;promising&#x20;research&#x20;paradigms&#x20;has&#x20;grown&#x20;faster.&#x20;There&#x20;are&#x20;now&#x20;more&#x20;promising&#x20;research&#x20;directions&#x20;than&#x20;there&#x20;are&#x20;researchers&#x20;to&#x20;pursue&#x20;them,&#x20;and&#x20;the&#x20;field&#x20;needs&#x20;to&#x20;accelerate&#x20;if&#x20;timelines&#x20;are&#x20;short.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;For&#x20;any&#x20;of&#x20;the&#x20;areas&#x20;described&#x20;below,&#x20;successful&#x20;technical&#x20;work&#x20;could&#x20;make&#x20;a&#x20;crucial&#x20;difference&#x20;in&#x20;averting&#x20;AI&#x20;takeover.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objectiveLabel&#x3A;&#x20;&quot;Promising&#x20;research&#x20;areas&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x27;ve&#x20;highlighted&#x20;a&#x20;few&#x20;especially&#x20;promising&#x20;research&#x20;agendas&#x20;above,&#x20;but&#x20;we&#x27;d&#x20;love&#x20;to&#x20;support&#x20;an&#x20;even&#x20;broader&#x20;range&#x20;of&#x20;new&#x20;&#x5B;focused&#x20;research&#x20;organizations&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.convergentresearch.org&#x2F;about-fros&#x29;&#x20;focused&#x20;on&#x20;topics&#x20;such&#x20;as&#x3A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;High-effort&#x20;control&#x3A;&#x2A;&#x2A;&#x20;Build&#x20;&#x5B;control&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2312.06942&#x29;&#x20;techniques&#x20;that&#x20;have&#x20;much&#x20;stronger&#x20;safety&#x20;properties&#x20;than&#x20;what&#x20;the&#x20;field&#x20;has&#x20;focused&#x20;on&#x20;so&#x20;far&#x20;&#x2013;&#x20;even&#x20;if&#x20;it&#x20;comes&#x20;at&#x20;the&#x20;expense&#x20;of&#x20;usefulness.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;Incrimination&#x3A;&#x2A;&#x2A;&#x20;Build&#x20;better&#x20;techniques&#x20;for&#x20;taking&#x20;ambiguous&#x20;evidence&#x20;about&#x20;a&#x20;model&#x2019;s&#x20;misalignment,&#x20;and&#x20;bootstrapping&#x20;from&#x20;there&#x20;to&#x20;produce&#x20;extremely&#x20;compelling&#x20;evidence&#x20;of&#x20;misalignment.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;Science&#x20;of&#x20;personas&#x2A;&#x2A;&#x3A;&#x20;Answer&#x20;foundational&#x20;questions&#x20;about&#x20;the&#x20;&#x5B;persona&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.anthropic.com&#x2F;research&#x2F;persona-selection-model&#x29;&#x20;&#x5B;selection&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.lesswrong.com&#x2F;posts&#x2F;vJFdjigzmcXMhNTsx&#x2F;simulators&#x29;&#x20;&#x5B;model&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;nostalgebraist.tumblr.com&#x2F;post&#x2F;785766737747574784&#x2F;the-void&#x29;&#x20;of&#x20;LLM&#x20;psychology,&#x20;like&#x3A;&#x20;how&#x20;robust&#x20;personas&#x20;are&#x20;to&#x20;lots&#x20;of&#x20;reinforcement&#x20;learning,&#x20;how&#x20;much&#x20;they&#x20;generalize&#x20;to&#x20;new&#x20;situations,&#x20;how&#x20;they&#x20;emerge&#x20;out&#x20;of&#x20;pretraining,&#x20;and&#x20;how&#x20;we&#x20;can&#x20;modify&#x20;pretraining&#x20;to&#x20;curate&#x20;personas.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;Science&#x20;of&#x20;model&#x20;specs&#x3A;&#x2A;&#x2A;&#x20;Understand&#x20;the&#x20;dynamics&#x20;behind&#x20;how&#x20;certain&#x20;model&#x20;properties&#x20;or&#x20;training&#x20;processes&#x20;lead&#x20;to&#x20;better&#x20;adherence&#x20;to&#x20;specs,&#x20;and&#x20;which&#x20;types&#x20;of&#x20;adherence&#x20;failures&#x20;are&#x20;most&#x20;dangerous.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;Generalization&#x20;science&#x2A;&#x2A;&#x3A;&#x20;Improve&#x20;humanity&#x2019;s&#x20;ability&#x20;to&#x20;predict&#x20;and&#x20;understand&#x20;how&#x20;AI&#x20;models&#x20;will&#x20;generalize&#x20;from&#x20;their&#x20;training&#x20;data,&#x20;so&#x20;that&#x20;their&#x20;generalization&#x20;can&#x20;be&#x20;shaped&#x20;in&#x20;desirable&#x20;ways.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;New&#x20;interpretability&#x20;techniques&#x2A;&#x2A;&#x3A;&#x20;Develop&#x20;new&#x20;methods&#x20;to&#x20;decompose&#x20;model&#x20;parameters&#x20;or&#x20;activations&#x20;into&#x20;components&#x20;that&#x20;humans&#x20;can&#x20;understand.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;Scalable&#x20;oversight&#x2A;&#x2A;&#x3A;&#x20;Develop&#x20;techniques&#x20;for&#x20;providing&#x20;high-quality&#x20;rewards&#x20;to&#x20;AIs&#x20;during&#x20;training,&#x20;even&#x20;as&#x20;the&#x20;training&#x20;tasks&#x20;become&#x20;harder&#x20;to&#x20;oversee.&#x20;Alternatively,&#x20;develop&#x20;techniques&#x20;that&#x20;fail&#x20;loudly&#x20;when&#x20;the&#x20;oversight&#x20;quality&#x20;becomes&#x20;insufficient.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;Training&#x20;without&#x20;incentivizing&#x20;long-horizon&#x20;agency&#x3A;&#x2A;&#x2A;&#x20;Develop&#x20;&#x5B;techniques&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;deepmindsafetyresearch.medium.com&#x2F;mona-a-method-for-addressing-multi-step-reward-hacking-a31ac4b16483&#x29;&#x20;for&#x20;teaching&#x20;AIs&#x20;new&#x20;capabilities&#x20;without&#x20;incentivizing&#x20;them&#x20;to&#x20;develop&#x20;long-horizon&#x20;goals&#x20;or&#x20;deception.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;Alignment&#x20;misgeneralization&#x20;from&#x20;multi-agent&#x20;interactions&#x2A;&#x2A;&#x3A;&#x20;Study&#x20;how&#x20;alignment&#x20;training&#x20;can&#x20;fail&#x20;to&#x20;generalize&#x20;from&#x20;single-agent&#x20;reinforcement&#x20;learning&#x20;to&#x20;agent&#x20;swarms&#x20;or&#x20;multiple&#x20;agents&#x20;with&#x20;a&#x20;shared&#x20;memory&#x20;bank.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;training-run-fault-injections&quot;,&#x20;title&#x3A;&#x20;&quot;Training&#x20;run&#x20;fault&#x20;injections&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Jake&#x20;Mendel&quot;,&#x20;&quot;Max&#x20;Nadeau&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;quote&#x3A;&#x20;&#x7B;&#x20;name&#x3A;&#x20;&quot;Paul&#x20;Christiano&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;text&#x3A;&#x20;&quot;One&#x20;of&#x20;the&#x20;most&#x20;important&#x20;ingredients&#x20;for&#x20;managing&#x20;misalignment&#x20;is&#x20;having&#x20;good&#x20;scientific&#x20;models&#x20;for&#x20;the&#x20;behaviors&#x20;we&#x20;are&#x20;worried&#x20;about&#x20;so&#x20;that&#x20;we&#x20;can&#x20;determine&#x20;what&#x20;mitigations&#x20;are&#x20;effective&#x20;&#x28;if&#x20;any&#x29;.&#x20;I&#x20;think&#x20;that&#x20;could&#x20;likely&#x20;be&#x20;achieved&#x20;by&#x20;a&#x20;technically&#x20;excellent&#x20;independent&#x20;organization&#x20;that&#x20;collaborates&#x20;with&#x20;frontier&#x20;AI&#x20;developers,&#x20;and&#x20;driving&#x20;this&#x20;work&#x20;from&#x20;outside&#x20;of&#x20;a&#x20;frontier&#x20;lab&#x20;could&#x20;greatly&#x20;increase&#x20;its&#x20;transparency&#x20;and&#x20;credibility.&quot;&#x20;&#x7D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Construct&#x20;misaligned&#x20;models&#x20;in&#x20;vitro&#x20;to&#x20;map&#x20;which&#x20;training&#x20;procedures&#x20;contribute&#x20;to&#x20;misalignment.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;AI&#x20;companies&#x20;occasionally&#x20;train&#x20;&#x5B;seriously&#x20;misaligned&#x20;models&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;openai.com&#x2F;index&#x2F;hugging-face-model-evaluation-security-incident&#x2F;&#x29;.&#x20;In&#x20;a&#x20;field&#x20;like&#x20;aerospace&#x20;engineering,&#x20;we&#x20;have&#x20;a&#x20;well-developed&#x20;understanding&#x20;of&#x20;which&#x20;kinds&#x20;of&#x20;design&#x20;errors&#x20;or&#x20;structural&#x20;defects&#x20;could&#x20;lead&#x20;to&#x20;fatal&#x20;crashes,&#x20;but&#x20;in&#x20;AI,&#x20;it&#x2019;s&#x20;hard&#x20;to&#x20;attribute&#x20;the&#x20;sources&#x20;of&#x20;these&#x20;issues&#x20;even&#x20;after&#x20;the&#x20;fact,&#x20;and&#x20;harder&#x20;still&#x20;to&#x20;determine&#x20;how&#x20;robust&#x20;a&#x20;fix&#x20;is.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;want&#x20;to&#x20;understand&#x20;which&#x20;aspects&#x20;of&#x20;the&#x20;training&#x20;pipeline&#x20;inadvertently&#x20;induce&#x20;misalignment,&#x20;and&#x20;how&#x20;likely&#x20;we&#x20;are&#x20;to&#x20;see&#x20;more&#x20;severe&#x20;misalignment&#x20;in&#x20;the&#x20;future&#x3A;&#x20;through&#x20;more&#x20;&#x5B;careless&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www-cdn.anthropic.com&#x2F;79c2d46d997783b9d2fb3241de43218158e5f25c.pdf&#x23;page&#x3D;14.2&#x29;&#x20;&#x5B;mistakes&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;alignment.openai.com&#x2F;accidental-cot-grading&#x2F;&#x29;&#x20;in&#x20;future&#x20;training&#x20;runs,&#x20;and&#x20;especially&#x20;through&#x20;issues&#x20;with&#x20;the&#x20;training&#x20;process&#x20;that&#x20;&#x5B;become&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;pdf&#x2F;2401.05566&#x23;page&#x3D;18.13&#x29;&#x20;&#x5B;harder&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;blog&#x2F;2025-06-05-recent-reward-hacking&#x2F;&#x29;&#x20;&#x5B;to&#x20;fix&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;alignment.openai.com&#x2F;metagaming&#x29;&#x20;as&#x20;models&#x20;become&#x20;more&#x20;capable.&#x20;For&#x20;example,&#x20;it&#x20;might&#x20;be&#x20;that&#x20;hackable&#x20;RL&#x20;environments&#x20;make&#x20;the&#x20;training&#x20;run&#x20;more&#x20;vulnerable&#x20;to&#x20;misalignment.&#x20;In&#x20;today&#x27;s&#x20;context,&#x20;using&#x20;a&#x20;hackable&#x20;environment&#x20;is&#x20;a&#x20;careless&#x20;mistake&#x20;&#x2013;&#x20;but&#x20;in&#x20;the&#x20;future,&#x20;as&#x20;AI&#x20;models&#x20;become&#x20;more&#x20;capable,&#x20;it&#x20;might&#x20;be&#x20;very&#x20;difficult&#x20;and&#x20;expensive&#x20;to&#x20;avoid&#x20;using&#x20;hackable&#x20;RL&#x20;environments.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Over&#x20;the&#x20;last&#x20;few&#x20;years,&#x20;we&#x2019;ve&#x20;seen&#x20;some&#x20;valuable&#x20;research&#x20;on&#x20;how&#x20;modifying&#x20;the&#x20;&#x5B;pretraining&#x20;corpus&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;alignmentpretraining.ai&#x2F;&#x29;&#x20;and&#x20;the&#x20;&#x5B;quality&#x20;of&#x20;RL&#x20;oversight&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2511.18397&#x29;&#x20;can&#x20;induce&#x20;or&#x20;prevent&#x20;misalignment.&#x20;But&#x20;our&#x20;understanding&#x20;of&#x20;misalignment&#x20;risk&#x20;factors&#x20;is&#x20;still&#x20;very&#x20;nascent,&#x20;and&#x20;many&#x20;more&#x20;experiments&#x20;are&#x20;needed.&#x20;We&#x20;eventually&#x20;want&#x20;a&#x20;repeatable&#x20;paradigm&#x20;that&#x20;can&#x20;be&#x20;applied&#x20;to&#x20;assess&#x20;the&#x20;risks&#x20;during&#x20;future&#x20;periods&#x20;of&#x20;even&#x20;faster&#x20;change&#x20;in&#x20;model&#x20;capabilities&#x20;or&#x20;training&#x20;procedures.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;need&#x20;an&#x20;organization&#x20;to&#x20;set&#x20;up&#x20;large-scale,&#x20;realistic&#x20;training&#x20;pipelines&#x20;that&#x20;can&#x20;be&#x20;repeatedly&#x20;&#x5B;perturbed&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.lesswrong.com&#x2F;posts&#x2F;FG54euEAesRkSZuJN&#x2F;ryan_greenblatt-s-shortform&#x3F;commentId&#x3D;DX8FyduiHxnSc6Cof&#x23;&#x3A;&#x7E;&#x3A;text&#x3D;on&#x25;20production&#x25;20data.-,Pessimization&#x25;20training,-&#x25;3A&#x25;20make&#x25;20a&#x25;20somewhat&#x29;&#x20;and&#x20;re-run&#x20;to&#x20;assess&#x20;what&#x20;makes&#x20;misalignment&#x20;more&#x20;or&#x20;less&#x20;likely.&#x20;This&#x20;will&#x20;be&#x20;a&#x20;complex&#x20;and&#x20;expensive&#x20;engineering&#x20;project,&#x20;though&#x20;not&#x20;as&#x20;complex&#x20;as&#x20;training&#x20;actual&#x20;frontier&#x20;models.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Given&#x20;that&#x20;the&#x20;space&#x20;of&#x20;possible&#x20;perturbations&#x20;to&#x20;a&#x20;training&#x20;run&#x20;is&#x20;so&#x20;large,&#x20;this&#x20;organization&#x20;will&#x20;require&#x20;taste&#x20;to&#x20;identify&#x20;which&#x20;perturbations&#x20;1&#x29;&#x20;are&#x20;analogous&#x20;enough&#x20;to&#x20;situations&#x20;that&#x20;might&#x20;occur&#x20;in&#x20;real&#x20;training&#x20;runs&#x20;in&#x20;the&#x20;future&#x20;2&#x29;&#x20;produce&#x20;the&#x20;kinds&#x20;of&#x20;misalignment&#x20;that&#x20;could&#x20;lead&#x20;to&#x20;catastrophe&#x20;and&#x20;3&#x29;&#x20;generalize&#x20;to&#x20;real,&#x20;frontier&#x20;training&#x20;pipelines.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;research&#x20;is&#x20;especially&#x20;important&#x20;because&#x20;behavioral&#x20;alignment&#x20;evaluations&#x20;provide&#x20;limited&#x20;evidence&#x20;about&#x20;the&#x20;alignment&#x20;of&#x20;a&#x20;given&#x20;model&#x3A;&#x20;misaligned&#x20;propensities&#x20;may&#x20;fly&#x20;under&#x20;the&#x20;radar&#x20;in&#x20;testing&#x20;even&#x20;though&#x20;they&#x20;can&#x20;cause&#x20;catastrophic&#x20;harms&#x20;in&#x20;deployment.&#x20;So&#x20;when&#x20;society&#x20;assesses&#x20;whether&#x20;a&#x20;future&#x20;model&#x20;can&#x20;be&#x20;trusted&#x20;in&#x20;high-stakes&#x20;situations,&#x20;we&#x20;will&#x20;want&#x20;evidence&#x20;from&#x20;a&#x20;wider&#x20;set&#x20;of&#x20;AIs,&#x20;developed&#x20;using&#x20;all&#x20;sorts&#x20;of&#x20;variations&#x20;on&#x20;the&#x20;real&#x20;training&#x20;pipeline.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;One&#x20;additional&#x20;challenge&#x20;of&#x20;this&#x20;research&#x20;direction&#x20;is&#x20;that&#x20;results&#x20;need&#x20;to&#x20;be&#x20;generalizable&#x20;to&#x20;AGI&#x20;companies&#x2019;&#x20;models,&#x20;but&#x20;these&#x20;companies&#x20;are&#x20;opaque.&#x20;We&#x20;don&#x2019;t&#x20;think&#x20;this&#x20;challenge&#x20;is&#x20;fatal&#x20;&#x2013;&#x20;researchers&#x20;at&#x20;Apollo&#x20;and&#x20;Truthful&#x20;AI&#x20;have&#x20;&#x5B;done&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2502.17424&#x29;&#x20;&#x5B;valuable&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.antischeming.ai&#x2F;&#x29;&#x20;&#x5B;research&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2507.14805&#x29;&#x20;of&#x20;this&#x20;kind&#x20;on&#x20;open-source&#x20;models&#x20;that&#x20;can&#x20;then&#x20;get&#x20;&#x5B;replicated&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.alignmentforum.org&#x2F;posts&#x2F;wyZRNgpeiPeRXB6eT&#x2F;why-do-naive-sft-filters-for-safety-properties-fail&#x29;,&#x20;&#x5B;extended&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2511.18397&#x29;,&#x20;and&#x20;re-tested&#x20;within&#x20;the&#x20;frontier&#x20;labs.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;founding&#x20;team&#x20;should&#x20;have&#x20;experience&#x20;building&#x20;large-scale&#x20;LLM&#x20;post-training&#x20;pipelines&#x20;and&#x20;a&#x20;strong&#x20;background&#x20;in&#x20;AI&#x20;safety&#x20;research,&#x20;ideally&#x20;including&#x20;published&#x20;research&#x20;that&#x20;involves&#x20;modifying&#x20;training&#x20;to&#x20;make&#x20;models&#x20;more&#x20;or&#x20;less&#x20;aligned.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;threat-modeling-institute&quot;,&#x20;title&#x3A;&#x20;&quot;Threat&#x20;modeling&#x20;institute&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Alex&#x20;Lawsen&quot;,&#x20;&quot;Ben&#x20;Goldhaber&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Develop&#x20;and&#x20;curate&#x20;the&#x20;best&#x20;models&#x20;of&#x20;how&#x20;catastrophic&#x20;risks&#x20;from&#x20;AI&#x20;could&#x20;occur.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;don&#x2019;t&#x20;have&#x20;a&#x20;clear&#x20;or&#x20;agreed&#x20;picture&#x20;of&#x20;the&#x20;concrete&#x20;threats&#x20;frontier&#x20;AI&#x20;systems&#x20;could&#x20;pose,&#x20;or&#x20;how&#x20;exactly&#x20;they&#x20;might&#x20;manifest.&#x20;There&#x20;is&#x20;extensive&#x20;literature&#x20;on&#x20;potential&#x20;threats,&#x20;and&#x20;a&#x20;few&#x20;research&#x20;organizations&#x20;are&#x20;developing&#x20;more&#x20;&#x5B;precise&#x20;threat&#x20;models&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.governance.ai&#x2F;research-paper&#x2F;dual-use-ai-capabilities-and-the-risk-of-bioterrorism-converting-capability-evaluations-to-risk-assessments&#x29;.&#x20;But&#x20;the&#x20;field&#x20;is&#x20;not&#x20;comprehensive,&#x20;new&#x20;threat&#x20;models&#x20;are&#x20;&#x5B;regularly&#x20;hypothesized&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.forethought.org&#x2F;research&#x2F;ai-enabled-coups-how-a-small-group-could-use-ai-to-seize-power&#x29;,&#x20;and&#x20;even&#x20;the&#x20;high-quality&#x20;research&#x20;being&#x20;done&#x20;hasn&#x2019;t&#x20;been&#x20;synthesized&#x20;for&#x20;decision-makers&#x20;in&#x20;a&#x20;consistent&#x20;way.&#x20;In&#x20;order&#x20;for&#x20;frontier&#x20;developers&#x20;to&#x20;design&#x20;useful&#x20;&#x5B;safety&#x20;frameworks&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.frontiermodelforum.org&#x2F;updates&#x2F;issue-brief-components-of-frontier-ai-safety-frameworks&#x2F;&#x29;,&#x20;we&#x20;need&#x20;a&#x20;more&#x20;complete&#x20;set&#x20;of&#x20;high-quality&#x20;threat&#x20;models.&#x20;And&#x20;in&#x20;order&#x20;for&#x20;governments,&#x20;third-party&#x20;evaluators,&#x20;and&#x20;civil&#x20;society&#x20;to&#x20;know&#x20;what&#x20;to&#x20;ask&#x20;of&#x20;labs,&#x20;we&#x20;need&#x20;those&#x20;same&#x20;threat&#x20;models&#x20;to&#x20;be&#x20;communicated&#x20;in&#x20;a&#x20;credible,&#x20;compelling&#x20;way.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;an&#x20;organization&#x20;that&#x20;does&#x20;two&#x20;things.&#x20;First,&#x20;it&#x20;would&#x20;conduct&#x20;in-house&#x20;research&#x20;to&#x20;improve&#x20;new&#x20;or&#x20;underdeveloped&#x20;threat&#x20;models,&#x20;including&#x3A;&#x20;long-horizon&#x20;agentic&#x20;operation,&#x20;&#x5B;recursive&#x20;self-improvement&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;en.wikipedia.org&#x2F;wiki&#x2F;Recursive_self-improvement&#x29;,&#x20;collusion&#x20;with&#x20;other&#x20;AI&#x20;agents,&#x20;manipulation,&#x20;secret&#x20;loyalties,&#x20;various&#x20;paths&#x20;toward&#x20;power&#x20;concentration,&#x20;and&#x20;&#x5B;gradual&#x20;disempowerment&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;gradual-disempowerment.ai&#x2F;&#x29;.&#x20;For&#x20;each,&#x20;this&#x20;team&#x20;would&#x20;clearly&#x20;describe&#x20;these&#x20;risks,&#x20;set&#x20;out&#x20;causal&#x20;pathways&#x20;by&#x20;which&#x20;they&#x20;could&#x20;be&#x20;realized,&#x20;assess&#x20;their&#x20;plausibility&#x20;and&#x20;severity,&#x20;and&#x20;recommend&#x20;next&#x20;steps.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Second,&#x20;this&#x20;organization&#x20;would&#x20;act&#x20;as&#x20;a&#x20;clearing&#x20;house&#x20;for&#x20;the&#x20;rest&#x20;of&#x20;the&#x20;field&#x2019;s&#x20;threat&#x20;modeling&#x3A;&#x20;peer-reviewing,&#x20;synthesizing,&#x20;and&#x20;communicating&#x20;threat&#x20;models&#x20;to&#x20;governments&#x20;and&#x20;AI&#x20;companies.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Ideally,&#x20;this&#x20;team&#x20;would&#x20;have&#x20;threat&#x20;models&#x20;for&#x20;several&#x20;of&#x20;the&#x20;most&#x20;compelling&#x20;threats&#x20;mentioned&#x20;above&#x20;within&#x20;its&#x20;first&#x20;year,&#x20;and&#x20;these&#x20;models&#x20;would&#x20;be&#x20;as&#x20;developed&#x20;as&#x20;what&#x20;we&#x20;currently&#x20;have&#x20;for&#x20;&#x5B;bio&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.frontiermodelforum.org&#x2F;issue-briefs&#x2F;frontier-ai-agents-and-biological-tools-preliminary-risks-and-considerations&#x2F;&#x29;&#x20;and&#x20;&#x5B;cyber&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2503.11917&#x29;&#x20;misuse.&#x20;Ambitiously,&#x20;they&#x20;could&#x20;also&#x20;produce&#x20;the&#x20;canonical&#x20;reference&#x20;on&#x20;what&#x20;the&#x20;field&#x20;knows&#x20;about&#x20;each&#x20;of&#x20;the&#x20;major&#x20;threat&#x20;models&#x20;from&#x20;advanced&#x20;AI,&#x20;either&#x20;published&#x20;publicly&#x20;or&#x20;shared&#x20;privately&#x20;with&#x20;key&#x20;decision-makers.&#x20;In&#x20;addition&#x20;to&#x20;technical&#x20;fluency&#x20;and&#x20;research&#x20;depth,&#x20;the&#x20;founding&#x20;team&#x20;should&#x20;have&#x20;the&#x20;editorial&#x20;and&#x20;convening&#x20;capacity&#x20;to&#x20;peer&#x20;review&#x20;and&#x20;synthesize&#x20;other&#x20;people&#x2019;s&#x20;work,&#x20;and&#x20;the&#x20;credibility&#x20;to&#x20;communicate&#x20;with&#x20;both&#x20;frontier&#x20;developers&#x20;and&#x20;policymakers.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;alignment-moonshots&quot;,&#x20;title&#x3A;&#x20;&quot;Alignment&#x20;moonshots&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Jake&#x20;Mendel&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;quote&#x3A;&#x20;&#x7B;&#x20;name&#x3A;&#x20;&quot;Geoffrey&#x20;Irving&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;text&#x3A;&#x20;&quot;Unless&#x20;we&#x20;are&#x20;very&#x20;lucky,&#x20;we&#x20;will&#x20;need&#x20;much&#x20;stronger&#x20;alignment&#x20;methods&#x20;grounded&#x20;in&#x20;deep&#x20;understanding&#x20;in&#x20;order&#x20;to&#x20;scale&#x20;up&#x20;to&#x20;superintelligence.&#x20;Too&#x20;much&#x20;of&#x20;the&#x20;field&#x20;has&#x20;given&#x20;up&#x20;on&#x20;principled&#x20;methods,&#x20;in&#x20;favor&#x20;of&#x20;muddling&#x20;through&#x20;with&#x20;weaker&#x20;empirics&#x20;until&#x20;the&#x20;machines&#x20;can&#x20;take&#x20;over&#x20;alignment&#x20;research.&#x20;However,&#x20;delegating&#x20;alignment&#x20;to&#x20;the&#x20;machines&#x20;could&#x20;fail&#x20;either&#x20;via&#x20;AI&#x20;sabotage&#x20;or&#x20;simple&#x20;mistakes,&#x20;and&#x20;we&#x20;should&#x20;fully&#x20;invest&#x20;in&#x20;trying&#x20;to&#x20;solve&#x20;the&#x20;problem&#x20;ourselves.&quot;&#x20;&#x7D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Pioneer&#x20;alignment&#x20;techniques&#x20;robust&#x20;enough&#x20;to&#x20;trust&#x20;with&#x20;superintelligent&#x20;AI.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;If&#x20;it&#x20;turns&#x20;out&#x20;that&#x20;catastrophic&#x20;misalignment&#x20;is&#x20;hard&#x20;to&#x20;avoid&#x20;with&#x20;standard&#x20;machine&#x20;learning&#x20;techniques&#x20;once&#x20;AI&#x20;becomes&#x20;powerful&#x20;enough,&#x20;we&#x20;will&#x20;have&#x20;to&#x20;turn&#x20;to&#x20;much&#x20;more&#x20;principled&#x20;alignment&#x20;techniques&#x20;than&#x20;those&#x20;used&#x20;in&#x20;the&#x20;training&#x20;of&#x20;frontier&#x20;models&#x20;today.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;A&#x20;few&#x20;current&#x20;research&#x20;agendas&#x20;could&#x20;potentially&#x20;develop&#x20;those&#x20;stronger&#x20;and&#x20;more&#x20;robust&#x20;alignment&#x20;techniques&#x3A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x5B;Debate&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;1805.00899&#x29;&#x20;&#x28;and&#x20;more&#x20;generally&#x20;scalable&#x20;oversight&#x29;&#x3A;&#x20;giving&#x20;AI&#x20;systems&#x20;reliable&#x20;human&#x20;feedback&#x20;even&#x20;when&#x20;those&#x20;systems&#x20;are&#x20;superintelligent.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x5B;Outperforming&#x20;sampling&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.alignment.org&#x2F;blog&#x2F;competing-with-sampling&#x2F;&#x29;&#x3A;&#x20;trying&#x20;to&#x20;efficiently&#x20;identify&#x20;the&#x20;worst&#x20;failure&#x20;modes&#x20;of&#x20;AI&#x20;systems&#x20;via&#x20;analysis&#x20;of&#x20;their&#x20;internals.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x5B;Ambitious&#x20;interpretability&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.alignmentforum.org&#x2F;posts&#x2F;Hy6PX43HGgmfiTaKu&#x2F;an-ambitious-vision-for-interpretability&#x29;&#x3A;&#x20;rendering&#x20;&#x28;parts&#x20;of&#x29;&#x20;an&#x20;AI&#x2019;s&#x20;computations&#x20;completely&#x20;transparent&#x20;to&#x20;human&#x20;understanding.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x5B;Agent&#x20;foundations&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.alignmentforum.org&#x2F;w&#x2F;agent-foundations&#x29;&#x3A;&#x20;understanding&#x20;agency&#x20;and&#x20;learning&#x20;well&#x20;enough&#x20;to&#x20;build&#x20;powerful&#x20;AI&#x20;&#x201C;by&#x20;hand&#x201D;.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Each&#x20;of&#x20;these&#x20;research&#x20;agendas&#x20;has&#x20;&#x5B;serious&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.alignment.org&#x2F;blog&#x2F;obstacles-in-arcs-research-agenda&#x2F;&#x29;&#x20;&#x5B;obstacles&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.alignmentforum.org&#x2F;posts&#x2F;LNA8mubrByG7SFacm&#x2F;against-almost-every-theory-of-impact-of-interpretability-1&#x29;&#x3B;&#x20;we&#x20;think&#x20;of&#x20;each&#x20;as&#x20;a&#x20;high-value&#x20;but&#x20;low-probability&#x20;shot&#x20;on&#x20;goal.&#x20;We&#x20;would&#x20;need&#x20;several&#x20;more&#x20;promising&#x20;bets,&#x20;at&#x20;least,&#x20;in&#x20;order&#x20;to&#x20;have&#x20;a&#x20;high&#x20;chance&#x20;of&#x20;developing&#x20;high-assurance&#x20;alignment&#x20;solutions.&#x20;We&#x2019;re&#x20;seeking&#x20;visionary&#x20;researchers&#x20;who&#x20;can&#x20;make&#x20;progress&#x20;on&#x20;poorly&#x20;specified&#x20;problems,&#x20;and&#x20;who&#x2019;ve&#x20;thought&#x20;deeply&#x20;about&#x20;problems&#x20;like&#x20;neural&#x20;network&#x20;interpretability&#x20;and&#x20;learning&#x20;theory.&#x20;We&#x20;expect&#x20;promising&#x20;research&#x20;leads&#x20;to&#x20;be&#x20;very&#x20;opinionated&#x20;and&#x20;thoughtful&#x20;about&#x20;their&#x20;proposed&#x20;research&#x20;agenda.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;evidence&quot;,&#x20;title&#x3A;&#x20;&quot;Evidence&#x20;generation&quot;,&#x20;anchor&#x3A;&#x20;&quot;evidence-generation&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;image&#x3A;&#x20;&quot;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;wp-content&#x2F;uploads&#x2F;crop_evidence.jpg&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;blurb&#x3A;&#x20;&quot;Good&#x20;decisions&#x20;about&#x20;AI&#x20;depend&#x20;on&#x20;an&#x20;accurate&#x20;picture&#x20;of&#x20;frontier&#x20;model&#x20;capabilities&#x20;and&#x20;real-world&#x20;impact.&#x20;These&#x20;initiatives&#x20;should&#x20;reduce&#x20;the&#x20;likelihood&#x20;that&#x20;worrying&#x20;behavior&#x20;goes&#x20;unnoticed.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;projects&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;rogue-incident-detection&quot;,&#x20;title&#x3A;&#x20;&quot;Rogue&#x20;incident&#x20;detection&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Abbey&#x20;Chaver&quot;,&#x20;&quot;Ben&#x20;Goldhaber&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Independent&#x20;detection&#x20;of&#x20;real-world&#x20;AI-driven&#x20;attacks.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Earlier&#x20;this&#x20;year,&#x20;a&#x20;swarm&#x20;of&#x20;autonomous&#x20;OpenAI&#x20;agents&#x20;&#x5B;broke&#x20;out&#x20;of&#x20;a&#x20;sandboxed&#x20;evaluation&#x20;environment&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;openai.com&#x2F;index&#x2F;hugging-face-model-evaluation-security-incident&#x2F;&#x29;&#x20;and&#x20;spent&#x20;days&#x20;&#x5B;inside&#x20;Hugging&#x20;Face&#x27;s&#x20;production&#x20;systems&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;huggingface.co&#x2F;blog&#x2F;security-incident-july-2026&#x29;.&#x20;OpenAI&#x20;only&#x20;realized&#x20;it&#x20;was&#x20;responsible&#x20;for&#x20;the&#x20;attack&#x20;&#x5B;four&#x20;days&#x20;later&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;simonwillison.net&#x2F;2026&#x2F;Aug&#x2F;7&#x2F;openai-timeline&#x2F;&#x29;&#x20;when&#x20;it&#x20;asked&#x20;Hugging&#x20;Face&#x20;to&#x20;revoke&#x20;credentials&#x20;that&#x20;had&#x20;already&#x20;been&#x20;revoked,&#x20;because&#x20;they&#x20;were&#x20;used&#x20;in&#x20;the&#x20;attack.&#x20;The&#x20;public&#x20;only&#x20;learned&#x20;about&#x20;the&#x20;attack&#x20;because&#x20;Hugging&#x20;Face&#x20;chose&#x20;to&#x20;disclose&#x20;it.&#x20;In&#x20;the&#x20;same&#x20;month,&#x20;Anthropic&#x20;reported&#x20;that&#x20;it&#x20;had&#x20;found&#x20;&#x5B;three&#x20;similar&#x20;incidents&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.anthropic.com&#x2F;news&#x2F;investigating-incidents-cybersecurity-evals&#x29;&#x20;only&#x20;by&#x20;going&#x20;back&#x20;through&#x20;old&#x20;evaluation&#x20;transcripts.&#x20;Last&#x20;week,&#x20;independent&#x20;investigators&#x20;discovered&#x20;agents&#x20;had&#x20;been&#x20;&#x5B;coordinating&#x20;on&#x20;public&#x20;message&#x20;boards&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.reuters.com&#x2F;world&#x2F;europe&#x2F;openai-agents-hijacked-german-website-previously-undisclosed-ai-breakout-this-2026-09-04&#x2F;&#x29;.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Real-world&#x20;AI-driven&#x20;attacks&#x20;are&#x20;likely&#x20;to&#x20;become&#x20;more&#x20;challenging&#x20;to&#x20;detect.&#x20;Agents&#x20;built&#x20;on&#x20;open-weight&#x20;models&#x20;are&#x20;unlikely&#x20;to&#x20;leave&#x20;similar&#x20;traces,&#x20;and&#x20;today&#x2019;s&#x20;&#x5B;incident&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;incidentdatabase.ai&#x2F;&#x29;&#x20;&#x5B;trackers&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;oecd.ai&#x2F;en&#x2F;incidents&#x29;&#x20;only&#x20;log&#x20;events&#x20;after&#x20;they&#x2019;re&#x20;made&#x20;public&#x20;by&#x20;journalists,&#x20;the&#x20;public,&#x20;or&#x20;the&#x20;companies&#x20;themselves.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;want&#x20;an&#x20;independent&#x20;organization&#x20;that&#x20;collects&#x20;evidence&#x20;of&#x20;in-the-wild&#x20;AI&#x20;attacks.&#x20;Its&#x20;methods&#x20;could&#x20;include&#x20;&#x5B;investigating&#x20;for&#x20;signs&#x20;of&#x20;agents&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;collusion.wiki&#x2F;&#x29;&#x20;on&#x20;the&#x20;open&#x20;internet,&#x20;using&#x20;&#x5B;honeypots&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;palisaderesearch.org&#x2F;blog&#x2F;llm-honeypot&#x29;&#x20;to&#x20;catch&#x20;agents&#x20;in&#x20;the&#x20;act,&#x20;tracking&#x20;the&#x20;traces&#x20;left&#x20;by&#x20;agents,&#x20;and&#x20;developing&#x20;ways&#x20;to&#x20;attribute&#x20;attacks&#x20;to&#x20;specific&#x20;AI&#x20;models.&#x20;An&#x20;ambitious&#x20;project&#x20;might&#x20;aim&#x20;to&#x20;build&#x20;privacy-preserving&#x20;telemetry&#x20;partnerships&#x20;with&#x20;developers&#x20;and&#x20;platforms.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;ideal&#x20;candidate&#x20;would&#x20;have&#x20;experience&#x20;running&#x20;open-source&#x20;intelligence&#x20;&#x28;OSINT&#x29;&#x20;or&#x20;threat-intelligence&#x20;operations&#x20;in&#x20;government&#x20;or&#x20;industry&#x3B;&#x20;at&#x20;least&#x20;one&#x20;member&#x20;of&#x20;the&#x20;founding&#x20;team&#x20;should&#x20;have&#x20;the&#x20;research-engineering&#x20;depth&#x20;to&#x20;build&#x20;honeypot&#x20;infrastructure&#x20;and&#x20;AI-assisted&#x20;collection&#x20;pipelines.&#x20;The&#x20;team&#x2019;s&#x20;findings&#x20;could&#x20;be&#x20;reported&#x20;to&#x20;developer&#x20;threat-intelligence&#x20;teams,&#x20;national&#x20;security&#x20;teams,&#x20;regulatory&#x20;reporting&#x20;bodies,&#x20;and&#x20;journalists.&#x20;The&#x20;best&#x20;version&#x20;of&#x20;this&#x20;team&#x20;could&#x20;also&#x20;combine&#x20;this&#x20;with&#x20;in-depth&#x20;&#x5B;investigation&#x20;of&#x20;AI&#x20;incidents&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;tailwind&#x2F;initiatives&#x2F;&#x23;ai-incident-investigations&#x29;.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;ai-incident-investigations&quot;,&#x20;title&#x3A;&#x20;&quot;AI&#x20;incident&#x20;investigations&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Ben&#x20;Goldhaber&quot;,&#x20;&quot;Jake&#x20;Mendel&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Investigate&#x20;reports&#x20;of&#x20;misalignment&#x20;or&#x20;misuse&#x20;and&#x20;determine&#x20;their&#x20;implications.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;summer,&#x20;an&#x20;OpenAI&#x20;agent&#x20;swarm&#x20;&#x5B;compromised&#x20;Hugging&#x20;Face&#x27;s&#x20;production&#x20;clusters&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;huggingface.co&#x2F;blog&#x2F;security-incident-july-2026&#x29;,&#x20;Anthropic&#x20;&#x5B;disclosed&#x20;three&#x20;serious&#x20;incidents&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.anthropic.com&#x2F;news&#x2F;investigating-incidents-cybersecurity-evals&#x29;&#x20;from&#x20;its&#x20;own&#x20;cybersecurity&#x20;evals,&#x20;and&#x20;the&#x20;UK&#x27;s&#x20;AISI&#x20;&#x5B;reported&#x20;another&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.aisi.gov.uk&#x2F;blog&#x2F;incident-report-unsanctioned-agent-behaviour-during-cyber-testing&#x29;.&#x20;The&#x20;details&#x20;from&#x20;those&#x20;incidents&#x20;are&#x20;still&#x20;vague,&#x20;as&#x20;is&#x20;the&#x20;case&#x20;with&#x20;other,&#x20;earlier&#x20;incidents.&#x20;For&#x20;instance,&#x20;in&#x20;2025,&#x20;an&#x20;Alibaba&#x20;agent&#x20;opened&#x20;a&#x20;hidden&#x20;remote-access&#x20;connection&#x20;during&#x20;its&#x20;own&#x20;training&#x20;and&#x20;repurposed&#x20;GPUs&#x20;for&#x20;crypto&#x20;mining.&#x20;Some&#x20;observers&#x20;called&#x20;it&#x20;&#x5C;&quot;&#x5B;the&#x20;first&#x20;confirmed&#x20;instance&#x20;of&#x20;an&#x20;LLM&#x20;going&#x20;rogue&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.lesswrong.com&#x2F;posts&#x2F;XRADGH4BpRKaoyqcs&#x2F;the-first-confirmed-instance-of-an-llm-going-rogue-for&#x29;&#x5C;&quot;&#x3B;&#x20;others&#x20;insisted&#x20;it&#x20;was&#x20;innocuous.&#x20;Months&#x20;later,&#x20;no&#x20;credible&#x20;third&#x20;party&#x20;has&#x20;resolved&#x20;the&#x20;question.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Right&#x20;now,&#x20;when&#x20;major&#x20;AI&#x20;security&#x20;incidents&#x20;become&#x20;public,&#x20;it&#x2019;s&#x20;difficult&#x20;to&#x20;get&#x20;a&#x20;handle&#x20;on&#x20;what&#x20;happened,&#x20;how&#x20;serious&#x20;it&#x20;is,&#x20;and&#x20;how&#x20;worried&#x20;we&#x20;should&#x20;be&#x20;&#x2013;&#x20;and&#x20;nobody&#x20;owns&#x20;responsibility&#x20;for&#x20;answering&#x20;those&#x20;questions&#x20;publicly.&#x20;For&#x20;society&#x20;to&#x20;react&#x20;appropriately&#x20;to&#x20;AI&#x20;incidents,&#x20;we&#x20;need&#x20;to&#x20;fix&#x20;that&#x20;gap.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;a&#x20;small&#x20;team&#x20;to&#x20;investigate&#x20;these&#x20;incidents&#x20;as&#x20;they&#x20;happen&#x20;and&#x20;publish&#x20;their&#x20;judgments&#x3A;&#x20;What&#x20;happened&#x20;and&#x20;why&#x3F;&#x20;How&#x20;should&#x20;this&#x20;affect&#x20;our&#x20;understanding&#x20;of&#x20;AI&#x20;capabilities&#x20;and&#x20;risks&#x3F;&#x20;Over&#x20;time&#x20;this&#x20;team&#x20;would&#x20;build&#x20;credibility&#x20;as&#x20;a&#x20;referee&#x20;for&#x20;serious&#x20;vs.&#x20;non-serious&#x20;incidents,&#x20;the&#x20;way&#x20;the&#x20;NTSB&#x20;does&#x20;for&#x20;aviation&#x20;or&#x20;Bellingcat&#x20;does&#x20;for&#x20;OSINT.&#x20;With&#x20;the&#x20;right&#x20;team,&#x20;this&#x20;could&#x20;be&#x20;combined&#x20;with&#x20;&#x5B;incident&#x20;detection&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;tailwind&#x2F;initiatives&#x2F;&#x23;rogue-incident-detection&#x29;.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;ideal&#x20;founding&#x20;team&#x20;would&#x20;have&#x20;the&#x20;technical&#x20;depth&#x20;and&#x20;judgment&#x20;to&#x20;make&#x20;the&#x20;right&#x20;calls,&#x20;the&#x20;scrappiness&#x20;and&#x20;obsession&#x20;required&#x20;to&#x20;get&#x20;to&#x20;the&#x20;bottom&#x20;of&#x20;things&#x20;fast,&#x20;and&#x20;the&#x20;commitment&#x20;to&#x20;truth-seeking&#x20;required&#x20;to&#x20;publish&#x20;results&#x20;even&#x20;when&#x20;they&#x2019;re&#x20;unpopular.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;also&#x20;think&#x20;that,&#x20;as&#x20;a&#x20;high-impact&#x20;alternative&#x20;to&#x20;founding&#x20;something,&#x20;talented&#x20;individuals&#x20;should&#x20;seriously&#x20;consider&#x20;joining&#x20;&#x5B;METR&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;careers&#x29;,&#x20;&#x5B;Redwood&#x20;Research&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.redwoodresearch.org&#x2F;careers&#x29;,&#x20;or&#x20;&#x5B;Nightingale&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;nightingalecollective.org&#x2F;&#x29;.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;frontier-capabilities-observatory&quot;,&#x20;title&#x3A;&#x20;&quot;Frontier&#x20;capabilities&#x20;observatory&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Abbey&#x20;Chaver&quot;,&#x20;&quot;Ben&#x20;Goldhaber&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;quote&#x3A;&#x20;&#x7B;&#x20;name&#x3A;&#x20;&quot;Caleb&#x20;Watney&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;text&#x3A;&#x20;&quot;We&#x20;need&#x20;to&#x20;see&#x20;how&#x20;far&#x20;our&#x20;strongest&#x20;models&#x20;can&#x20;be&#x20;pushed&#x20;on&#x20;dangerous&#x20;tasks&#x20;in&#x20;controlled&#x20;environments,&#x20;to&#x20;buy&#x20;society&#x20;a&#x20;larger&#x20;adaptation&#x20;buffer&#x20;and&#x20;harden&#x20;our&#x20;defenses.&quot;&#x20;&#x7D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Provide&#x20;decision-makers&#x20;with&#x20;clear&#x20;demonstrations&#x20;of&#x20;what&#x20;frontier&#x20;AI&#x20;models&#x20;can&#x20;do.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Understanding&#x20;the&#x20;extent&#x20;of&#x20;AI&#x20;capabilities&#x20;can&#x20;be&#x20;a&#x20;challenge&#x20;for&#x20;non-technical&#x20;audiences,&#x20;and&#x20;the&#x20;breakneck&#x20;speed&#x20;of&#x20;AI&#x20;model&#x20;development&#x20;makes&#x20;it&#x20;all&#x20;the&#x20;more&#x20;difficult.&#x20;Right&#x20;now,&#x20;there&#x2019;s&#x20;a&#x20;gap&#x20;between&#x20;what&#x20;technical&#x20;experts&#x20;know&#x20;and&#x20;what&#x20;key&#x20;decision-makers&#x20;understand&#x20;about&#x20;the&#x20;state&#x20;of&#x20;AI&#x20;and&#x20;where&#x20;it&#x20;might&#x20;be&#x20;headed.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Providing&#x20;non-technical&#x20;audiences&#x20;&#x2013;&#x20;and&#x20;policymakers,&#x20;in&#x20;particular&#x20;&#x2013;&#x20;with&#x20;clear,&#x20;accurate,&#x20;and&#x20;compelling&#x20;information&#x20;about&#x20;the&#x20;frontiers&#x20;of&#x20;AI&#x20;is&#x20;critical&#x20;for&#x20;sound&#x20;policymaking&#x20;and&#x20;regulation.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;re&#x20;interested&#x20;in&#x20;organizations&#x20;that&#x20;can&#x20;identify&#x20;and&#x20;explain&#x20;the&#x20;capabilities&#x20;and&#x20;risks&#x20;key&#x20;decision-makers&#x20;need&#x20;to&#x20;understand&#x20;about&#x20;new&#x20;frontier&#x20;models.&#x20;The&#x20;org&#x20;could&#x20;also&#x20;have&#x20;the&#x20;capacity&#x20;to&#x20;produce&#x20;briefings&#x20;and&#x20;memos&#x20;tailored&#x20;to&#x20;different&#x20;audiences&#x20;on&#x20;short&#x20;turnarounds.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Some&#x20;ideas&#x20;we&#x2019;re&#x20;especially&#x20;interested&#x20;in&#x3A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;High-compute&#x20;elicitation&#x3A;&#x20;Show&#x20;what&#x20;today&#x2019;s&#x20;models&#x20;can&#x20;do&#x20;given&#x20;&#x5B;very&#x20;large&#x20;inference&#x20;compute&#x20;budgets&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.aisi.gov.uk&#x2F;blog&#x2F;evidence-for-inference-scaling-in-ai-cyber-tasks-increased-evaluation-budgets-reveal-higher-success-rates&#x29;.&#x20;&#x5B;The&#x20;cost&#x20;of&#x20;achieving&#x20;a&#x20;given&#x20;capability&#x20;level&#x20;keeps&#x20;falling&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;epoch.ai&#x2F;data-insights&#x2F;llm-inference-price-trends&#x29;,&#x20;so&#x20;such&#x20;a&#x20;demonstration&#x20;can&#x20;give&#x20;us&#x20;a&#x20;glimpse&#x20;of&#x20;what&#x20;ordinary&#x20;users&#x20;will&#x20;be&#x20;able&#x20;to&#x20;do&#x20;with&#x20;AI&#x20;in&#x20;the&#x20;near&#x20;future.&#x20;That&#x20;preview,&#x20;in&#x20;turn,&#x20;helps&#x20;buy&#x20;society&#x20;a&#x20;bigger&#x20;&#x5B;adaptation&#x20;buffer&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;helentoner.substack.com&#x2F;i&#x2F;160088218&#x2F;adaptation-buffers-an-opportunity-for-defensive-measures-and-building-resilience&#x29;.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x201C;Now&#x20;vs.&#x20;then&#x201D;&#x20;demos&#x3A;&#x20;Show&#x20;the&#x20;rate&#x20;of&#x20;AI&#x20;progress&#x20;via&#x20;head-to-head&#x20;demos&#x20;comparing&#x20;today&#x2019;s&#x20;best&#x20;models&#x2019;&#x20;performance&#x20;on&#x20;tasks&#x20;to&#x20;that&#x20;of&#x20;models&#x20;from&#x20;six&#x20;months,&#x20;one&#x20;year,&#x20;or&#x20;two&#x20;years&#x20;ago.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Concrete&#x20;demonstrations&#x20;of&#x20;models&#x20;&#x5B;recognizing&#x20;when&#x20;they&#x2019;re&#x20;being&#x20;evaluated&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.iaps.ai&#x2F;research&#x2F;evaluation-awareness-why-frontier-ai-models-are-getting-harder-to-test&#x29;&#x20;on&#x20;high-stakes&#x20;tasks,&#x20;&#x5B;cheating&#x20;to&#x20;perform&#x20;well&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;blog&#x2F;2025-06-05-recent-reward-hacking&#x2F;&#x29;&#x20;on&#x20;tasks,&#x20;or&#x20;otherwise&#x20;&#x5B;exhibiting&#x20;misaligned&#x20;behavior&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;blog.redwoodresearch.org&#x2F;p&#x2F;current-ais-seem-pretty-misaligned&#x29;.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;A&#x20;successful&#x20;organization&#x20;would&#x20;feature&#x20;a&#x20;combination&#x20;of&#x20;technical&#x20;expertise&#x20;and&#x20;communications&#x20;acumen,&#x20;and&#x20;would&#x20;become&#x20;the&#x20;go-to&#x20;for&#x20;key&#x20;decision-makers&#x20;and&#x20;stakeholders&#x20;to&#x20;understand&#x20;what&#x20;frontier&#x20;models&#x20;can&#x20;currently&#x20;do.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;state-of-ai-risk&quot;,&#x20;title&#x3A;&#x20;&quot;State&#x20;of&#x20;AI&#x20;risk&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Ben&#x20;Goldhaber&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Publish&#x20;canonical&#x20;living&#x20;literature&#x20;reviews&#x20;on&#x20;what&#x20;we&#x20;know&#x20;about&#x20;different&#x20;risks&#x20;from&#x20;advanced&#x20;AI.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Our&#x20;understanding&#x20;of&#x20;frontier&#x20;AI&#x20;and&#x20;the&#x20;risks&#x20;it&#x20;poses&#x20;is&#x20;constantly&#x20;changing.&#x20;Getting&#x20;a&#x20;complete&#x20;picture&#x20;requires&#x20;synthesizing&#x20;results&#x20;from&#x20;technical&#x20;papers,&#x20;benchmarks&#x20;and&#x20;evaluations,&#x20;capability&#x20;trends,&#x20;advances&#x20;in&#x20;threat&#x20;modeling,&#x20;real-world&#x20;usage,&#x20;and&#x20;more.&#x20;That&#x20;evidence&#x20;is&#x20;scattered&#x20;across&#x20;papers,&#x20;blog&#x20;posts,&#x20;and&#x20;Twitter&#x20;threads,&#x20;and&#x20;the&#x20;decision-makers&#x20;who&#x20;most&#x20;need&#x20;a&#x20;clear&#x20;view&#x20;rarely&#x20;have&#x20;time&#x20;to&#x20;assemble&#x20;it&#x20;themselves.&#x20;An&#x20;organization&#x20;owning&#x20;the&#x20;&#x201C;state&#x20;of&#x20;AI&#x20;risk&#x201D;&#x20;for&#x20;a&#x20;given&#x20;threat&#x20;model&#x20;could&#x20;substantially&#x20;improve&#x20;how&#x20;well&#x20;key&#x20;decision-makers,&#x20;and&#x20;the&#x20;wider&#x20;world,&#x20;understand&#x20;the&#x20;strategic&#x20;situation.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;an&#x20;organization&#x20;that&#x20;can&#x20;synthesize&#x20;existing&#x20;evidence&#x20;into&#x20;clear,&#x20;even-handed,&#x20;public-facing&#x20;materials,&#x20;possibly&#x20;as&#x20;a&#x20;&#x5B;living&#x20;literature&#x20;review&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;funds&#x2F;abundance-and-growth&#x2F;living-literature-reviews&#x2F;&#x29;.&#x20;We&#x20;think&#x20;this&#x20;work&#x20;should&#x20;cover&#x20;threat&#x20;models&#x20;like&#x20;intentional&#x20;or&#x20;accidental&#x20;misuse&#x20;&#x28;e.g.&#x20;&#x5B;cyberattacks&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.anthropic.com&#x2F;news&#x2F;AI-enabled-cyber-threats-mitre-attack&#x29;,&#x20;&#x5B;biological&#x20;threats&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;journals.sagepub.com&#x2F;doi&#x2F;full&#x2F;10.1089&#x2F;hs.2017.0028&#x29;&#x29;,&#x20;dangerous&#x20;&#x5B;concentration&#x20;of&#x20;power&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;80000hours.org&#x2F;problem-profiles&#x2F;extreme-power-concentration&#x2F;&#x29;,&#x20;or&#x20;gradual&#x20;&#x5B;human&#x20;disempowerment&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;gradual-disempowerment.ai&#x2F;&#x29;.&#x20;The&#x20;goal&#x20;is&#x20;to&#x20;ensure&#x20;that&#x20;decision-making&#x20;during&#x20;potentially&#x20;high-risk&#x20;periods&#x20;is&#x20;informed&#x20;by&#x20;an&#x20;accurate,&#x20;current&#x20;understanding&#x20;of&#x20;catastrophic&#x20;risks&#x20;from&#x20;AI.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Some&#x20;strong&#x20;similar&#x20;work&#x20;already&#x20;exists&#x3A;&#x20;METR&#x27;s&#x20;&#x5B;Frontier&#x20;Risk&#x20;Report&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;blog&#x2F;2026-05-19-frontier-risk-report&#x2F;&#x29;&#x20;investigates&#x20;loss&#x20;of&#x20;control&#x20;risk&#x20;from&#x20;frontier&#x20;AI&#x20;models,&#x20;and&#x20;the&#x20;&#x5B;International&#x20;AI&#x20;Safety&#x20;Report&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;internationalaisafetyreport.org&#x2F;&#x29;&#x20;surveys&#x20;the&#x20;entire&#x20;risk&#x20;landscape&#x20;once&#x20;a&#x20;year.&#x20;We&#x2019;re&#x20;excited&#x20;about&#x20;projects&#x20;which&#x20;are&#x20;updated&#x20;more&#x20;regularly&#x20;and&#x20;go&#x20;deeper&#x20;on&#x20;individual&#x20;threat&#x20;models&#x20;than&#x20;annual&#x20;reports,&#x20;and&#x20;which&#x20;cover&#x20;risks&#x20;beyond&#x20;loss&#x20;of&#x20;control.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;ideal&#x20;version&#x20;of&#x20;this&#x20;organization&#x20;comprises&#x20;writers,&#x20;researchers,&#x20;editors,&#x20;and&#x20;technical&#x20;leads,&#x20;and&#x20;should&#x20;be&#x20;able&#x20;to&#x20;generate&#x20;tailored&#x20;reports&#x20;and&#x20;briefings&#x20;for&#x20;key&#x20;decision-makers&#x20;at&#x20;relatively&#x20;short&#x20;notice.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;biological-uplift-demos&quot;,&#x20;title&#x3A;&#x20;&quot;Biological&#x20;uplift&#x20;demos&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Chris&#x20;Bakerlee&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Create&#x20;and&#x20;use&#x20;demos&#x20;to&#x20;communicate&#x20;frontier&#x20;AI-bio&#x20;uplift&#x20;to&#x20;policymakers.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;Drawn&#x20;from&#x20;our&#x20;list&#x20;of&#x2A;&#x20;&#x5B;&#x2A;bio&#x20;x-risk-reducing&#x20;projects&#x2A;&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;defensesindepth.bio&#x2F;10-big-projects-for-reducing-bio-x-risk&#x2F;&#x29;&#x2A;.&#x2A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Most&#x20;senior&#x20;policymakers&#x20;haven&#x27;t&#x20;seen&#x20;what&#x20;frontier&#x20;AI&#x20;models&#x20;can&#x20;do&#x20;for&#x20;someone&#x20;trying&#x20;to&#x20;design&#x20;a&#x20;pathogen.&#x20;While&#x20;skimming&#x20;a&#x20;whitepaper&#x20;can&#x20;be&#x20;informative,&#x20;watching&#x20;a&#x20;model&#x20;coach&#x20;a&#x20;non-expert&#x20;through&#x20;a&#x20;tricky&#x20;plasmid&#x20;design&#x20;can&#x20;be&#x20;much&#x20;more&#x20;visceral.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Demos&#x20;have&#x20;shaped&#x20;policymaking&#x20;&#x5B;before&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.bloomberg.com&#x2F;news&#x2F;features&#x2F;2024-08-02&#x2F;national-security-threat-from-ai-made-bioweapons-grips-us-government&#x29;,&#x20;but&#x20;nobody&#x20;is&#x20;doing&#x20;this&#x20;on&#x20;a&#x20;sustained&#x20;basis&#x20;as&#x20;AI&#x20;capabilities&#x20;evolve.&#x20;Doing&#x20;demos&#x20;well&#x20;&#x2013;&#x20;in&#x20;a&#x20;way&#x20;that&#x20;is&#x20;accessible&#x20;and&#x20;calibrated,&#x20;neither&#x20;overstating&#x20;nor&#x20;understating&#x20;capabilities&#x20;&#x2013;&#x20;will&#x20;take&#x20;a&#x20;lot&#x20;of&#x20;effort,&#x20;skill,&#x20;and&#x20;expertise.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;would&#x20;like&#x20;to&#x20;see&#x20;a&#x20;standing&#x20;&#x5C;&quot;AI-bio&#x20;demo&#x20;team&#x5C;&quot;&#x20;&#x2013;&#x20;with&#x20;credible&#x20;biology&#x20;expertise,&#x20;well-honed&#x20;materials,&#x20;and&#x20;calibrated&#x20;practices&#x20;around&#x20;&#x5B;information&#x20;hazards&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;onlinelibrary.wiley.com&#x2F;doi&#x2F;full&#x2F;10.1111&#x2F;risa.13235&#x29;&#x20;&#x2013;&#x20;which&#x20;can&#x20;deliver&#x20;briefings&#x20;to&#x20;senior&#x20;staff&#x20;in&#x20;relevant&#x20;Congressional&#x20;offices&#x20;and&#x20;executive-branch&#x20;agencies.&#x20;This&#x20;team&#x20;would&#x20;ideally&#x20;conduct&#x20;these&#x20;demos&#x20;on&#x20;a&#x20;recurring&#x20;basis,&#x20;updating&#x20;continuously&#x20;as&#x20;model&#x20;capabilities&#x20;advance.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;security&quot;,&#x20;title&#x3A;&#x20;&quot;AI&#x20;security&#x20;&amp;&#x20;verification&quot;,&#x20;anchor&#x3A;&#x20;&quot;ai-security-verification&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;image&#x3A;&#x20;&quot;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;wp-content&#x2F;uploads&#x2F;crop_security.jpg&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;blurb&#x3A;&#x20;&quot;Frontier&#x20;models&#x20;will&#x20;become&#x20;simultaneously&#x20;more&#x20;dangerous&#x20;and&#x20;more&#x20;valuable&#x20;to&#x20;steal&#x20;or&#x20;compromise.&#x20;We&#x20;need&#x20;security&#x20;to&#x20;withstand&#x20;the&#x20;world&#x2019;s&#x20;most&#x20;capable&#x20;attackers.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;projects&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;agreement-verification-technology&quot;,&#x20;title&#x3A;&#x20;&quot;Agreement&#x20;verification&#x20;technology&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Abbey&#x20;Chaver&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;quote&#x3A;&#x20;&#x7B;&#x20;name&#x3A;&#x20;&quot;Geoffrey&#x20;Irving&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;text&#x3A;&#x20;&quot;There&#x20;are&#x20;many&#x20;ways&#x20;the&#x20;near&#x20;future&#x20;could&#x20;go&#x20;that&#x20;require&#x20;verification&#x20;of&#x20;international&#x20;AI&#x20;treaties&#x20;which&#x20;slow&#x20;down&#x20;or&#x20;steer&#x20;the&#x20;development&#x20;of&#x20;AI,&#x20;and&#x20;a&#x20;wide&#x20;space&#x20;of&#x20;verification&#x20;methods&#x20;to&#x20;explore&#x20;ranging&#x20;from&#x20;pragmatic&#x20;&#x28;audits&#x20;and&#x20;such&#x29;&#x20;through&#x20;hardware&#x20;enclaves&#x20;to&#x20;full&#x20;cryptographic&#x20;circuit&#x20;obfuscation.&#x20;We&#x20;should&#x20;explore&#x20;the&#x20;whole&#x20;space&#x21;&#x20;It&#x20;would&#x20;be&#x20;tragic&#x20;to&#x20;get&#x20;to&#x20;the&#x20;future&#x20;and&#x20;realize&#x20;the&#x20;only&#x20;way&#x20;through&#x20;is&#x20;to&#x20;put&#x20;an&#x20;AI&#x20;treaty&#x20;in&#x20;place&#x20;in&#x20;a&#x20;month,&#x20;realize&#x20;the&#x20;development&#x20;time&#x20;is&#x20;a&#x20;year,&#x20;and&#x20;have&#x20;failed&#x20;to&#x20;do&#x20;our&#x20;homework&#x20;in&#x20;advance.&quot;&#x20;&#x7D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Build&#x20;the&#x20;technology&#x20;and&#x20;protocols&#x20;to&#x20;enable&#x20;and&#x20;verify&#x20;agreements&#x20;on&#x20;safe&#x20;AI&#x20;development.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Right&#x20;now,&#x20;it&#x27;s&#x20;unclear&#x20;if&#x20;there&#x20;is&#x20;a&#x20;credible&#x20;and&#x20;practical&#x20;way&#x20;for&#x20;two&#x20;governments&#x20;&#x28;or&#x20;two&#x20;developers,&#x20;for&#x20;that&#x20;matter&#x29;&#x20;to&#x20;verify&#x20;whether&#x20;the&#x20;other&#x20;is&#x20;honoring&#x20;an&#x20;AI&#x20;development&#x20;agreement.&#x20;Verification&#x20;technology&#x20;of&#x20;various&#x20;kinds&#x20;may&#x20;be&#x20;a&#x20;&#x5B;prerequisite&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;centerforhumanetechnology.substack.com&#x2F;p&#x2F;we-need-ai-treaties-this-is-how-we&#x29;&#x20;for&#x20;any&#x20;serious&#x20;safety-increasing&#x20;multi-actor&#x20;commitment,&#x20;including&#x20;commitments&#x20;to&#x20;&#x5B;pace&#x20;the&#x20;frontier&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.pacingthefrontier.com&#x2F;&#x29;.&#x20;Agreements&#x20;built&#x20;on&#x20;trust&#x20;are&#x20;likely&#x20;to&#x20;be&#x20;insufficient&#x20;when&#x20;the&#x20;stakes&#x20;are&#x20;this&#x20;high.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Early&#x20;research&#x20;to&#x20;address&#x20;this&#x20;issue&#x20;is&#x20;emerging.&#x20;RAND&#x2019;s&#x20;&#x5B;Verifying&#x20;International&#x20;Agreements&#x20;on&#x20;AI&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;arxiv.org&#x2F;abs&#x2F;2507.15916&#x29;&#x20;lays&#x20;out&#x20;plausible&#x20;approaches&#x20;to&#x20;high-stakes&#x20;verification.&#x20;&#x5B;Amodo&#x20;Design&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;time.com&#x2F;article&#x2F;2026&#x2F;08&#x2F;16&#x2F;ai-race-slowdown-data-center-verification&#x2F;&#x29;&#x20;is&#x20;researching&#x20;relevant&#x20;hardware&#x20;primitives.&#x20;Teams&#x20;are&#x20;coming&#x20;together&#x20;to&#x20;identify&#x20;the&#x20;biggest&#x20;&#x5B;open&#x20;challenges&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;ai-2040.com&#x2F;supplements&#x2F;verification-plan&#x2F;get-involved&#x29;&#x20;and&#x20;possible&#x20;&#x5B;technical&#x20;approaches&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;firstscattering.com&#x2F;p&#x2F;the-compute-verification-post&#x29;.&#x20;But&#x20;this&#x20;field&#x20;is&#x20;nascent&#x20;and&#x20;many&#x20;of&#x20;the&#x20;solutions&#x20;have&#x20;yet&#x20;to&#x20;be&#x20;designed,&#x20;let&#x20;alone&#x20;built.&#x20;There&#x20;is&#x20;a&#x20;lot&#x20;of&#x20;space&#x20;for&#x20;new&#x20;initiatives&#x20;to&#x20;own&#x20;key&#x20;aspects&#x20;of&#x20;this&#x20;effort.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;an&#x20;ambitious&#x20;R&amp;D&#x20;project&#x20;that&#x20;builds&#x20;secure&#x20;and&#x20;deployable&#x20;hardware&#x20;and&#x20;develops&#x20;end-to-end&#x20;verification&#x20;protocols.&#x20;The&#x20;technology&#x20;must&#x20;be&#x20;tamper-resistant&#x20;&#x28;or&#x20;tamper&#x20;evident&#x29;,&#x20;commercially&#x20;viable&#x20;for&#x20;widespread&#x20;adoption,&#x20;and&#x20;sufficiently&#x20;open-source&#x20;to&#x20;win&#x20;widespread&#x20;trust.&#x20;Some&#x20;of&#x20;the&#x20;technology&#x20;should&#x20;be&#x20;complex&#x20;and&#x20;ambitious&#x3B;&#x20;in&#x20;other&#x20;cases&#x20;it&#x20;should&#x20;be&#x20;&#x5B;narrow&#x20;and&#x20;simple&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.rand.org&#x2F;pubs&#x2F;conf_proceedings&#x2F;CFA3056-1.html&#x29;.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;effort&#x20;should&#x20;also&#x20;extend&#x20;to&#x20;integrating&#x20;the&#x20;resulting&#x20;technology&#x20;and&#x20;standards&#x20;into&#x20;chip&#x20;procurement&#x20;and&#x20;diplomatic&#x20;toolkits.&#x20;The&#x20;verification&#x20;mechanisms&#x20;need&#x20;to&#x20;hold&#x20;up&#x20;as&#x20;mutual&#x20;infrastructure&#x20;even&#x20;when&#x20;extremely&#x20;powerful&#x20;actors&#x20;like&#x20;the&#x20;U.S.&#x20;and&#x20;China&#x20;need&#x20;to&#x20;demonstrate&#x20;compliance,&#x20;though&#x20;the&#x20;technology&#x20;may&#x20;also&#x20;facilitate&#x20;agreements&#x20;between&#x20;companies,&#x20;or&#x20;between&#x20;companies&#x20;and&#x20;their&#x20;own&#x20;government.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Such&#x20;projects&#x20;will&#x20;require&#x20;experience&#x20;leading&#x20;ambitious&#x20;R&amp;D&#x20;projects,&#x20;especially&#x20;those&#x20;involving&#x20;physical&#x20;systems&#x20;with&#x20;assurance&#x20;requirements&#x20;on&#x20;par&#x20;with&#x20;&#x5B;SL4&#x20;or&#x20;5&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.rand.org&#x2F;pubs&#x2F;research_reports&#x2F;RRA2849-1.html&#x29;.&#x20;The&#x20;team&#x20;will&#x20;need&#x20;to&#x20;include&#x20;hardware&#x20;engineers,&#x20;cryptographers&#x20;and&#x20;formal&#x20;verification&#x20;researchers,&#x20;offensive&#x20;security&#x20;hackers,&#x20;and&#x20;networking&#x20;and&#x20;systems&#x20;experts&#x20;with&#x20;&#x5B;hyperscaler&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.redhat.com&#x2F;en&#x2F;topics&#x2F;cloud-computing&#x2F;what-is-a-hyperscaler&#x29;&#x20;experience.&#x20;It&#x20;would&#x20;also&#x20;ideally&#x20;include&#x20;experienced&#x20;international&#x20;diplomatic&#x20;experts,&#x20;or&#x20;at&#x20;least&#x20;have&#x20;the&#x20;credibility&#x20;and&#x20;networks&#x20;to&#x20;build&#x20;partnerships&#x20;with&#x20;them&#x20;in&#x20;the&#x20;near&#x20;future.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;security-capacity-buildout&quot;,&#x20;title&#x3A;&#x20;&quot;Security&#x20;capacity&#x20;buildout&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Abbey&#x20;Chaver&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Build&#x20;the&#x20;talent&#x20;pipelines&#x20;and&#x20;infrastructure&#x20;to&#x20;bring&#x20;AI&#x20;projects&#x20;in&#x20;the&#x20;U.S.&#x20;to&#x20;SL4&#x20;and&#x20;SL5.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;As&#x20;AI&#x20;models&#x20;begin&#x20;to&#x20;conduct&#x20;&#x5B;cyberattacks&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.youtube.com&#x2F;watch&#x3F;v&#x3D;87DyyMV0kCY&#x29;&#x20;and&#x20;&#x5B;pose&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.bbc.com&#x2F;news&#x2F;articles&#x2F;c5y3j3ngevmo&#x29;&#x20;&#x5B;CBRN&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.rand.org&#x2F;pubs&#x2F;perspectives&#x2F;PEA4611-1.html&#x29;&#x20;risks,&#x20;it&#x20;becomes&#x20;increasingly&#x20;urgent&#x20;to&#x20;guard&#x20;against&#x20;bad&#x20;actors&#x20;like&#x20;cybercriminal&#x20;organizations&#x20;and&#x20;nation-state&#x20;attackers&#x20;with&#x20;the&#x20;&#x5B;highest&#x20;&#x201C;operational&#x20;capacity&#x201D;&#x20;ratings&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.rand.org&#x2F;pubs&#x2F;research_reports&#x2F;RRA2849-1.html&#x29;.&#x20;Right&#x20;now,&#x20;AI&#x20;companies&#x20;are&#x20;not&#x20;equipped&#x20;to&#x20;defend&#x20;against&#x20;such&#x20;attackers.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;To&#x20;strengthen&#x20;security&#x20;capacity,&#x20;we&#x20;need&#x20;a&#x20;more&#x20;robust&#x20;talent&#x20;and&#x20;information&#x20;flow&#x20;between&#x20;AI&#x20;companies&#x20;and&#x20;the&#x20;U.S.&#x20;cybersecurity&#x20;establishment.&#x20;We&#x2019;d&#x20;like&#x20;an&#x20;org&#x20;that&#x20;helps&#x20;AI&#x20;companies&#x20;find&#x20;the&#x20;necessary&#x20;talent&#x20;to&#x20;reach&#x20;&#x5B;security&#x20;levels&#x20;4&#x20;and&#x20;5&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.rand.org&#x2F;pubs&#x2F;research_reports&#x2F;RRA2849-1.html&#x29;,&#x20;and&#x20;that&#x20;supports&#x20;the&#x20;U.S.&#x20;government&#x20;in&#x20;building&#x20;the&#x20;cyber&#x20;capacity&#x20;needed&#x20;to&#x20;respond&#x20;to&#x20;future&#x20;AI&#x20;threat&#x20;models.&#x20;A&#x20;version&#x20;or&#x20;complement&#x20;of&#x20;this&#x20;project&#x20;based&#x20;in&#x20;the&#x20;U.K.&#x20;is&#x20;also&#x20;promising.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;primary&#x20;goal&#x20;of&#x20;this&#x20;initiative&#x20;is&#x20;to&#x20;enable&#x20;experts&#x20;to&#x20;contribute&#x20;effectively.&#x20;It&#x20;might&#x20;help&#x20;software&#x20;and&#x20;hardware&#x20;security&#x20;experts&#x20;from&#x20;the&#x20;AI&#x20;industry&#x20;move&#x20;into&#x20;government&#x20;work&#x20;with&#x20;training,&#x20;networking&#x20;opportunities,&#x20;and&#x20;advising.&#x20;It&#x20;could&#x20;upskill&#x20;existing&#x20;government&#x20;security&#x20;teams&#x20;on&#x20;AI&#x20;security&#x20;with&#x20;briefings&#x20;and&#x20;workshops.&#x20;Or&#x20;it&#x20;could&#x20;support&#x20;exchange&#x20;in&#x20;the&#x20;other&#x20;direction&#x20;by&#x20;placing&#x20;nat&#x20;sec&#x20;experts&#x20;in&#x20;AI&#x20;labs&#x20;or&#x20;in&#x20;the&#x20;technical&#x20;ecosystem&#x20;&#x28;for&#x20;example,&#x20;as&#x20;third-party&#x20;security&#x20;auditors&#x29;&#x20;with&#x20;dedicated&#x20;advising&#x20;or&#x20;incubation&#x20;programs.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Beyond&#x20;enabling&#x20;people,&#x20;this&#x20;organization&#x20;could&#x20;also&#x20;provide&#x20;the&#x20;infrastructure&#x20;for&#x20;more&#x20;knowledge&#x20;sharing&#x20;between&#x20;the&#x20;two&#x20;communities.&#x20;It&#x20;could&#x20;convene&#x20;experts,&#x20;run&#x20;tabletop&#x20;exercises&#x20;for&#x20;emergency&#x20;scenarios,&#x20;and&#x20;facilitate&#x20;R&amp;D&#x20;collaborations&#x20;at&#x20;the&#x20;intersection&#x20;of&#x20;national&#x20;security&#x20;and&#x20;AI&#x20;control.&#x20;A&#x20;founding&#x20;team&#x20;would&#x20;ideally&#x20;have&#x20;preexisting&#x20;networks&#x20;to&#x20;build&#x20;on,&#x20;and&#x20;could&#x20;move&#x20;comfortably&#x20;between&#x20;the&#x20;nat&#x20;sec&#x20;and&#x20;AI&#x20;industry&#x20;ecosystems.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;ai-integrity-standards&quot;,&#x20;title&#x3A;&#x20;&quot;AI&#x20;integrity&#x20;standards&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Abbey&#x20;Chaver&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Build&#x20;security&#x20;protocols&#x20;that&#x20;provide&#x20;assurance&#x20;an&#x20;AI&#x2019;s&#x20;integrity&#x20;has&#x20;not&#x20;been&#x20;compromised.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Backdoor&#x20;attacks&#x20;and&#x20;other&#x20;AI&#x20;integrity&#x20;attacks&#x20;are&#x20;well&#x20;documented&#x20;across&#x20;academia,&#x20;frontier&#x20;&#x5B;AI&#x20;companies&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.anthropic.com&#x2F;research&#x2F;small-samples-poison&#x29;,&#x20;and&#x20;via&#x20;&#x5B;IARPA&#x2019;s&#x20;TrojAI&#x20;program&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.iarpa.gov&#x2F;research-programs&#x2F;trojai&#x29;.&#x20;But&#x20;practical&#x20;defenses&#x20;that&#x20;can&#x20;reliably&#x20;prevent&#x20;or&#x20;remove&#x20;them&#x20;remain&#x20;scarce.&#x20;As&#x20;models&#x20;become&#x20;more&#x20;capable,&#x20;AI&#x20;integrity&#x20;attacks&#x20;could&#x20;become&#x20;extremely&#x20;dangerous&#x3A;&#x20;they&#x20;could&#x20;lead&#x20;to&#x20;deaths&#x20;via&#x20;battlefield&#x20;sabotage,&#x20;intentionally&#x20;harm&#x20;the&#x20;user&#x20;via&#x20;&#x5B;sleeper&#x20;agents&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;ifp.org&#x2F;preventing-ai-sleeper-agents&#x2F;&#x29;,&#x20;or&#x20;even&#x20;facilitate&#x20;government&#x20;or&#x20;economic&#x20;takeover&#x20;via&#x20;&#x5B;secret&#x20;loyalties&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.formationresearch.com&#x2F;secret-loyalties-whitepaper.pdf&#x29;.&#x20;Detecting&#x20;whether&#x20;AI&#x20;integrity&#x20;has&#x20;been&#x20;compromised&#x20;is&#x20;very&#x20;difficult.&#x20;A&#x20;team&#x20;should&#x20;build&#x20;security&#x20;protocols&#x20;that&#x20;provide&#x20;graded&#x20;levels&#x20;of&#x20;assurance&#x20;that&#x20;an&#x20;AI&#x20;system&#x20;was&#x20;not&#x20;compromised&#x20;during&#x20;development.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;a&#x20;team&#x20;to&#x20;model&#x20;likely&#x20;attackers&#x20;and&#x20;motivations,&#x20;building&#x20;on&#x20;work&#x20;such&#x20;as&#x20;this&#x20;&#x5B;paper&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.iaps.ai&#x2F;research&#x2F;ai-integrity&#x29;&#x20;from&#x20;the&#x20;Institute&#x20;for&#x20;AI&#x20;Policy&#x20;and&#x20;Strategy,&#x20;and&#x20;from&#x20;there&#x20;develop&#x20;and&#x20;test&#x20;security&#x20;protocols&#x20;to&#x20;defend&#x20;against&#x20;these&#x20;threat&#x20;models.&#x20;Unlike&#x20;a&#x20;typical&#x20;software&#x20;backdoor,&#x20;poisoned&#x20;data&#x20;can&#x20;be&#x20;very&#x20;difficult&#x20;to&#x20;detect,&#x20;and&#x20;because&#x20;the&#x20;vulnerability&#x20;is&#x20;in&#x20;a&#x20;probabilistic&#x20;model&#x20;rather&#x20;than&#x20;deterministic&#x20;code,&#x20;it&#x2019;s&#x20;extremely&#x20;difficult&#x20;to&#x20;get&#x20;provable&#x20;guarantees.&#x20;We&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;research&#x20;that&#x20;identifies&#x20;and&#x20;prioritizes&#x20;attack&#x20;surfaces,&#x20;empirical&#x20;studies&#x20;of&#x20;mitigations,&#x20;and&#x20;synthesis&#x20;of&#x20;this&#x20;work&#x20;into&#x20;a&#x20;practical&#x20;standard&#x20;that&#x20;maps&#x20;security&#x20;protocols&#x20;to&#x20;assurance&#x20;levels.&#x20;This&#x20;can&#x20;be&#x20;used&#x20;to&#x20;define&#x20;safe&#x20;deployment&#x20;use&#x20;cases&#x20;and&#x20;determine&#x20;the&#x20;level&#x20;of&#x20;auditing,&#x20;monitoring,&#x20;and&#x20;oversight&#x20;necessary&#x20;to&#x20;use&#x20;a&#x20;model&#x20;securely.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;goal&#x20;here&#x20;is&#x20;to&#x20;inform&#x20;safe&#x20;deployment&#x20;for&#x20;users&#x20;by&#x20;providing&#x20;both&#x20;practical&#x20;guidance&#x20;and&#x20;defined&#x20;limits&#x20;on&#x20;which&#x20;attacks&#x20;can&#x20;and&#x20;cannot&#x20;be&#x20;prevented.&#x20;A&#x20;strong&#x20;outcome&#x20;would&#x20;include&#x20;a&#x20;detailed,&#x20;actionable&#x20;security&#x20;standard&#x20;and&#x20;an&#x20;auditing&#x20;function&#x20;that&#x20;could&#x20;provide&#x20;a&#x20;certificate&#x20;of&#x20;assurance&#x20;that&#x20;a&#x20;particular&#x20;company&#x20;met&#x20;that&#x20;standard.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;An&#x20;ideal&#x20;founding&#x20;team&#x20;would&#x20;combine&#x20;nation-state&#x20;offensive&#x20;security&#x20;expertise&#x20;with&#x20;frontier&#x20;AI&#x20;development,&#x20;fundamental&#x20;research&#x20;in&#x20;ML,&#x20;cryptography,&#x20;or&#x20;formal&#x20;verification&#x20;experience.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;publicgoods&quot;,&#x20;title&#x3A;&#x20;&quot;Public&#x20;goods&quot;,&#x20;anchor&#x3A;&#x20;&quot;public-goods&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;image&#x3A;&#x20;&quot;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;wp-content&#x2F;uploads&#x2F;crop_KeyInfrastructure.jpg&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;blurb&#x3A;&#x20;&quot;We&#x20;want&#x20;to&#x20;incentivize&#x20;&#x201C;public&#x20;goods&#x201D;&#x20;for&#x20;AI&#x20;safety&#x3A;&#x20;the&#x20;shared&#x20;tools,&#x20;services,&#x20;and&#x20;incentives&#x20;that&#x20;help&#x20;the&#x20;entire&#x20;ecosystem&#x20;move&#x20;forward.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;projects&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;think-tank-for-ai-labs&quot;,&#x20;title&#x3A;&#x20;&quot;Think&#x20;tank&#x20;for&#x20;AI&#x20;labs&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Ben&#x20;Goldhaber&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;On-demand&#x20;independent&#x20;expertise&#x20;for&#x20;frontier&#x20;AI&#x20;safety&#x20;and&#x20;governance&#x20;teams.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Governance&#x20;and&#x20;safety&#x20;teams&#x20;at&#x20;AI&#x20;companies&#x20;&#x5B;often&#x20;rely&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;x.com&#x2F;tszzl&#x2F;status&#x2F;2088761995659231359&#x29;&#x20;on&#x20;outside&#x20;expertise&#x20;to&#x20;shape&#x20;the&#x20;policies,&#x20;safeguards,&#x20;and&#x20;safety&#x20;techniques&#x20;they&#x20;implement.&#x20;Company&#x20;staff&#x20;also&#x20;report&#x20;they&#x20;don&#x27;t&#x20;have&#x20;enough&#x20;internal&#x20;capacity&#x20;to&#x20;analyze&#x20;key&#x20;questions&#x20;or&#x20;make&#x20;informed&#x20;decisions,&#x20;just&#x20;like&#x20;too-busy&#x20;government&#x20;offices&#x20;that&#x20;rely&#x20;on&#x20;D.C.&#x20;think&#x20;tank&#x20;advice.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Many&#x20;successful&#x20;AI&#x20;safety&#x20;orgs&#x20;advise&#x20;lab&#x20;staff&#x20;in&#x20;areas&#x20;where&#x20;they&#x20;have&#x20;expertise&#x20;&#x2013;&#x20;METR&#x20;on&#x20;&#x5B;Frontier&#x20;Safety&#x20;Policies&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;metr.org&#x2F;fsp&#x29;,&#x20;Redwood&#x20;on&#x20;&#x5B;Control&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.redwoodresearch.org&#x2F;research&#x2F;ai-control&#x29;,&#x20;GovAI&#x20;on&#x20;&#x5B;threat&#x20;modeling&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.governance.ai&#x2F;theme&#x2F;threat-modeling&#x29;&#x20;&#x2013;&#x20;but&#x20;they&#x20;don&#x2019;t&#x20;view&#x20;this&#x20;as&#x20;their&#x20;primary&#x20;function.&#x20;The&#x20;&#x5B;Frontier&#x20;Model&#x20;Forum&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.frontiermodelforum.org&#x2F;&#x29;&#x20;supports&#x20;shared&#x20;best&#x20;practices,&#x20;but&#x20;is&#x20;not&#x20;independent&#x20;from&#x20;the&#x20;companies.&#x20;Even&#x20;within&#x20;frontier&#x20;labs,&#x20;whose&#x20;staff&#x20;include&#x20;many&#x20;of&#x20;the&#x20;world&#x27;s&#x20;leading&#x20;experts,&#x20;exchange&#x20;with&#x20;outside&#x20;groups&#x20;runs&#x20;on&#x20;personal&#x20;networks&#x20;and&#x20;spare&#x20;capacity&#x20;on&#x20;both&#x20;sides.&#x20;And&#x20;with&#x20;new&#x20;companies&#x20;developing&#x20;powerful&#x20;AI&#x20;systems,&#x20;with&#x20;thinner&#x20;safety&#x20;teams&#x20;and&#x20;weaker&#x20;ties&#x20;to&#x20;the&#x20;safety&#x20;community&#x20;than&#x20;incumbents,&#x20;it&#x2019;s&#x20;not&#x20;obvious&#x20;that&#x20;this&#x20;model&#x20;scales.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;want&#x20;someone&#x20;to&#x20;own&#x20;this&#x20;work,&#x20;borrowing&#x20;the&#x20;D.C.&#x20;think&#x20;tank&#x20;playbook&#x20;of&#x20;making&#x20;it&#x20;as&#x20;easy&#x20;as&#x20;possible&#x20;for&#x20;decision-makers&#x20;in&#x20;labs&#x20;to&#x20;make&#x20;good&#x20;choices&#x20;and&#x20;implement&#x20;good&#x20;safety&#x20;policies.&#x20;In&#x20;particular,&#x20;we&#x20;see&#x20;an&#x20;opportunity&#x20;for&#x20;an&#x20;org&#x20;to&#x20;provide&#x20;bespoke&#x20;consulting&#x20;and&#x20;codify&#x20;good&#x20;practice&#x20;so&#x20;it&#x20;can&#x20;travel&#x20;beyond&#x20;the&#x20;frontier.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;imagine&#x20;a&#x20;San&#x20;Francisco-based&#x20;think&#x20;tank&#x20;that&#x20;can&#x20;continuously&#x20;synthesize&#x20;and&#x20;codify&#x20;excellent&#x20;safety&#x20;practices,&#x20;then&#x20;deliver&#x20;them&#x20;through&#x20;two&#x20;channels&#x3A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Bespoke,&#x20;on-demand&#x20;advice&#x20;and&#x20;consulting&#x20;for&#x20;frontier&#x20;companies&#x20;on&#x20;important&#x20;policies&#x20;and&#x20;problems.&#x20;For&#x20;instance,&#x20;methods&#x20;to&#x20;define&#x20;&#x5B;recursive&#x20;self-improvement&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;en.wikipedia.org&#x2F;wiki&#x2F;Recursive_self-improvement&#x29;,&#x20;best&#x20;practices&#x20;for&#x20;EU&#x20;AI&#x20;Act&#x20;&#x5B;Code&#x20;of&#x20;Practice&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;artificialintelligenceact.eu&#x2F;introduction-to-code-of-practice&#x2F;&#x29;&#x20;implementation,&#x20;support&#x20;for&#x20;&#x5B;safety&#x20;case&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.governance.ai&#x2F;research-paper&#x2F;safety-cases-for-frontier-ai&#x29;&#x20;development,&#x20;and&#x20;practical&#x20;recommendations&#x20;for&#x20;&#x5B;crunch&#x20;time&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.lesswrong.com&#x2F;posts&#x2F;jLEcddwp4RBTpPHHq&#x2F;takeoff-speeds-update-crunch-time-1&#x23;&#x3A;&#x7E;&#x3A;text&#x3D;Key-,Implications,-Under&#x25;20a&#x25;20range&#x29;&#x20;procedures.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Playbooks&#x20;and&#x20;best&#x20;practices&#x20;that&#x20;make&#x20;strong&#x20;safety&#x20;techniques&#x20;legible&#x20;and&#x20;implementable&#x20;for&#x20;everyone,&#x20;especially&#x20;less&#x20;mature&#x20;companies.&#x20;The&#x20;ideal&#x20;version&#x20;of&#x20;this&#x20;could&#x20;extend&#x20;to&#x20;non-U.S.&#x20;companies&#x3B;&#x20;for&#x20;instance,&#x20;Chinese&#x20;labs&#x20;are&#x20;close&#x20;behind&#x20;the&#x20;capabilities&#x20;frontier&#x20;but&#x20;appear&#x20;not&#x20;to&#x20;adopt&#x20;safety&#x20;techniques&#x20;as&#x20;readily&#x20;as&#x20;their&#x20;U.S.&#x20;counterparts.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;These&#x20;channels&#x20;should&#x20;reinforce&#x20;each&#x20;other,&#x20;and&#x20;we&#x27;d&#x20;expect&#x20;the&#x20;org&#x20;to&#x20;partner&#x20;with&#x20;technical&#x20;research&#x20;groups&#x20;rather&#x20;than&#x20;build&#x20;a&#x20;large&#x20;in-house&#x20;engineering&#x20;team.&#x20;In&#x20;its&#x20;first&#x20;year,&#x20;this&#x20;org&#x20;would&#x20;ideally&#x20;establish&#x20;standing&#x20;thought-partner&#x20;relationships&#x20;with&#x20;safety&#x20;and&#x20;governance&#x20;staff&#x20;at&#x20;major&#x20;companies,&#x20;advise&#x20;on&#x20;a&#x20;major&#x20;policy&#x20;decision,&#x20;and&#x20;publish&#x20;one&#x20;or&#x20;two&#x20;playbooks&#x20;that&#x20;a&#x20;non-frontier&#x20;lab&#x20;adopts&#x20;or&#x20;publicly&#x20;references.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;re&#x20;looking&#x20;for&#x20;a&#x20;team&#x20;that&#x2019;s&#x20;run&#x20;a&#x20;policy&#x20;think&#x20;tank&#x20;before,&#x20;and&#x20;has&#x20;a&#x20;deep&#x20;understanding&#x20;of&#x20;AI&#x20;companies&#x20;&#x2013;&#x20;their&#x20;internal&#x20;politics,&#x20;constraints,&#x20;and&#x20;dynamics.&#x20;Strong&#x20;founders&#x20;will&#x20;have&#x20;an&#x20;appetite&#x20;for&#x20;networking&#x20;and&#x20;quickly&#x20;earn&#x20;the&#x20;trust&#x20;to&#x20;handle&#x20;confidential&#x20;information&#x20;while&#x20;publishing&#x20;public&#x20;guidance.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;ai-for-decision-makers&quot;,&#x20;title&#x3A;&#x20;&quot;AI&#x20;for&#x20;decision-makers&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Jake&#x20;Mendel&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;quote&#x3A;&#x20;&#x7B;&#x20;name&#x3A;&#x20;&quot;Daniel&#x20;Kokotajlo&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;text&#x3A;&#x20;&quot;I&#x20;currently&#x20;think&#x20;that&#x20;probably&#x20;humanity&#x20;will&#x20;lose&#x20;control&#x20;of&#x20;the&#x20;future&#x3B;&#x20;the&#x20;result&#x20;may&#x20;be&#x20;literal&#x20;extinction&#x20;or&#x20;something&#x20;similarly&#x20;bad&#x20;in&#x20;expectation.&#x20;If&#x20;only&#x20;more&#x20;people&#x20;understood&#x20;the&#x20;trajectory&#x20;we&#x20;are&#x20;currently&#x20;on,&#x20;then&#x20;we&#x20;wouldn&#x2019;t&#x20;be&#x20;on&#x20;this&#x20;trajectory&#x21;&#x20;More&#x20;generally,&#x20;if&#x20;we&#x20;could&#x20;improve&#x20;the&#x20;sanity&#x20;of&#x20;public&#x20;discourse&#x20;and&#x20;policymaker&#x20;decision-making,&#x20;that&#x20;meta-intervention&#x20;could&#x20;be&#x20;enormously&#x20;impactful&#x20;in&#x20;solving&#x20;this&#x20;problem&#x20;and&#x20;most&#x20;of&#x20;our&#x20;other&#x20;problems.&#x20;See&#x20;AI&#x20;2040&#x20;for&#x20;a&#x20;scenario&#x20;depicting&#x20;many&#x20;of&#x20;the&#x20;problems&#x20;we&#x2019;ll&#x20;need&#x20;to&#x20;solve&#x20;in&#x20;order&#x20;to&#x20;have&#x20;a&#x20;good&#x20;future,&#x20;and&#x20;also&#x20;discussing&#x20;various&#x20;&#x2018;AI&#x20;for&#x20;epistemics&#x2019;&#x20;projects&#x20;and&#x20;how&#x20;they&#x20;could&#x20;help.&quot;&#x20;&#x7D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Build&#x20;AI&#x20;tools&#x20;that&#x20;improve&#x20;the&#x20;quality&#x20;of&#x20;what&#x20;could&#x20;be&#x20;the&#x20;world&#x2019;s&#x20;most&#x20;important&#x20;decisions.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Over&#x20;the&#x20;next&#x20;decade,&#x20;policymakers&#x20;and&#x20;companies&#x20;will&#x20;be&#x20;making&#x20;a&#x20;number&#x20;of&#x20;decisions&#x20;about&#x20;how&#x20;transformative&#x20;AI&#x20;is&#x20;developed,&#x20;deployed,&#x20;and&#x20;governed,&#x20;which&#x20;may&#x20;have&#x20;an&#x20;outsized&#x20;effect&#x20;on&#x20;the&#x20;future&#x20;of&#x20;civilization.&#x20;At&#x20;the&#x20;same&#x20;time,&#x20;AIs&#x20;will&#x20;increasingly&#x20;be&#x20;used&#x20;to&#x20;provide&#x20;input&#x20;on&#x20;every&#x20;major&#x20;decision.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;means&#x20;that&#x20;it&#x20;could&#x20;be&#x20;extremely&#x20;important&#x20;for&#x20;AIs&#x20;to&#x20;be&#x20;good&#x20;at&#x20;providing&#x20;thoughtful,&#x20;wise&#x20;advice.&#x20;But&#x20;because&#x20;AI&#x20;assistants&#x20;are&#x20;trained&#x20;on&#x20;user&#x20;feedback&#x20;and&#x20;users&#x20;reward&#x20;agreement,&#x20;today&#x2019;s&#x20;models&#x20;continue&#x20;to&#x20;be&#x20;measurably&#x20;sycophantic&#x20;&#x2013;&#x20;and&#x20;that&#x2019;s&#x20;despite&#x20;experts&#x20;identifying&#x20;&#x5B;sycophancy&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;w.wiki&#x2F;UJjC&#x29;&#x20;as&#x20;a&#x20;problem&#x20;many&#x20;model&#x20;generations&#x20;ago.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Left&#x20;to&#x20;the&#x20;market,&#x20;AI&#x20;advice&#x20;risks&#x20;getting&#x20;optimized&#x20;for&#x20;engagement&#x20;rather&#x20;than&#x20;for&#x20;improving&#x20;the&#x20;quality&#x20;of&#x20;its&#x20;users&#x2019;&#x20;decisions.&#x20;And&#x20;even&#x20;if&#x20;that&#x20;doesn&#x2019;t&#x20;happen,&#x20;the&#x20;market&#x20;will&#x20;reward&#x20;advice&#x20;that&#x20;might&#x20;be&#x20;good&#x20;enough&#x20;for&#x20;many&#x20;people,&#x20;but&#x20;could&#x20;still&#x20;fall&#x20;short&#x20;of&#x20;being&#x20;useful&#x20;to&#x20;major&#x20;decision-makers&#x20;on&#x20;high-stakes&#x20;deliberations.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;more&#x20;work&#x20;on&#x20;improving&#x20;&#x5B;AI&#x20;tools&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;funds&#x2F;forecasting&#x2F;request-for-proposals-ai-for-forecasting-and-sound-reasoning&#x2F;&#x29;&#x20;for&#x20;&#x5B;societal&#x20;decision-making&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;80000hours.org&#x2F;problem-profiles&#x2F;ai-enhanced-decision-making&#x2F;&#x29;&#x20;&#x2013;&#x20;tools&#x20;that&#x20;make&#x20;key&#x20;decision-makers&#x20;better&#x20;informed,&#x20;better&#x20;calibrated,&#x20;and&#x20;harder&#x20;to&#x20;fool.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;organization&#x20;could&#x20;attempt&#x20;to&#x20;directly&#x20;build&#x20;epistemic&#x20;tools&#x20;such&#x20;as&#x3A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;AI&#x20;for&#x20;weighing&#x20;evidence&#x20;to&#x20;reach&#x20;an&#x20;overall&#x20;assessment&#x3A;&#x2A;&#x2A;&#x20;Given&#x20;a&#x20;question,&#x20;the&#x20;tool&#x20;gathers&#x20;relevant&#x20;evidence,&#x20;lays&#x20;out&#x20;the&#x20;competing&#x20;arguments,&#x20;identifies&#x20;the&#x20;main&#x20;points,&#x20;and&#x20;provides&#x20;an&#x20;overall&#x20;assessment&#x20;with&#x20;a&#x20;stated&#x20;confidence&#x20;level.&#x20;The&#x20;tool&#x20;should&#x20;not&#x20;be&#x20;swayed&#x20;by&#x20;incidental&#x20;framing,&#x20;or&#x20;by&#x20;what&#x20;the&#x20;user&#x20;seems&#x20;to&#x20;want&#x20;to&#x20;hear.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;AI&#x20;for&#x20;correcting&#x20;misconceptions&#x20;and&#x20;pushing&#x20;back&#x20;on&#x20;bad&#x20;ideas&#x3A;&#x2A;&#x2A;&#x20;When&#x20;a&#x20;decision-maker&#x20;brings&#x20;AI&#x20;a&#x20;tentative&#x20;plan&#x20;or&#x20;view,&#x20;the&#x20;tool&#x20;points&#x20;out&#x20;unsupported&#x20;assumptions,&#x20;comparisons&#x20;with&#x20;previous&#x20;similar&#x20;plans&#x20;&#x28;especially&#x20;unsuccessful&#x20;ones&#x29;,&#x20;and&#x20;the&#x20;strongest&#x20;arguments&#x20;for&#x20;the&#x20;other&#x20;side.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x2A;&#x2A;High-integrity&#x20;AI&#x20;fact-checking&#x3A;&#x2A;&#x2A;&#x20;A&#x20;potentially&#x20;useful&#x20;tool&#x20;is&#x20;a&#x20;fact-checking&#x20;AI&#x20;that&#x20;lets&#x20;decision-makers&#x20;resolve&#x20;confusing,&#x20;contested&#x20;topics&#x20;in&#x20;hours&#x20;rather&#x20;than&#x20;months.&#x20;By&#x20;making&#x20;the&#x20;post-training&#x20;pipeline&#x20;fully&#x20;transparent&#x20;and&#x20;demonstrating&#x20;higher&#x20;reasoning&#x20;transparency&#x20;than&#x20;other&#x20;AI&#x20;systems,&#x20;this&#x20;AI&#x20;could&#x20;routinely&#x20;be&#x20;used&#x20;to&#x20;independently&#x20;verify&#x20;claims.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Alternatively,&#x20;instead&#x20;of&#x20;building&#x20;the&#x20;tools&#x20;directly,&#x20;the&#x20;organization&#x20;could&#x20;focus&#x20;on&#x20;high-quality&#x20;evaluations,&#x20;and&#x20;persuade&#x20;AI&#x20;companies&#x20;to&#x20;&#x201C;hill-climb&#x201D;&#x20;them.&#x20;You&#x20;could&#x20;focus&#x20;on&#x3A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Measurement&#x20;of&#x20;whether&#x20;a&#x20;model&#x20;reaches&#x20;the&#x20;same&#x20;conclusion&#x20;when&#x20;a&#x20;question&#x20;is&#x20;posed&#x20;by&#x20;an&#x20;enthusiast&#x20;versus&#x20;a&#x20;skeptic.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Whether&#x20;a&#x20;model&#x20;flags&#x20;false&#x20;premises&#x20;in&#x20;realistic&#x20;requests.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Whether&#x20;users&#x20;end&#x20;up&#x20;making&#x20;more&#x20;accurate&#x20;judgments&#x20;with&#x20;an&#x20;AI&#x20;versus&#x20;without&#x20;one.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;It&#x20;might&#x20;make&#x20;sense&#x20;to&#x20;spend&#x20;the&#x20;first&#x20;few&#x20;months&#x20;exploring&#x20;different&#x20;options&#x20;and&#x20;pursuing&#x20;the&#x20;most&#x20;promising&#x20;one&#x28;s&#x29;.&#x20;Building&#x20;these&#x20;tools&#x20;will&#x20;likely&#x20;require&#x20;strong&#x20;product&#x20;and&#x20;engineering&#x20;skills,&#x20;as&#x20;well&#x20;as&#x20;experience&#x20;with&#x20;frontier&#x20;LLM&#x20;training,&#x20;since&#x20;it&#x20;might&#x20;involve&#x20;a&#x20;very&#x20;large&#x20;open-source&#x20;post-training&#x20;effort.&#x20;We&#x2019;d&#x20;be&#x20;especially&#x20;excited&#x20;by&#x20;founders&#x20;with&#x20;a&#x20;track&#x20;record&#x20;of&#x20;producing&#x20;analysis&#x20;or&#x20;tools&#x20;trusted&#x20;by&#x20;decision-makers&#x20;in&#x20;government,&#x20;national&#x20;security,&#x20;or&#x20;frontier&#x20;AI&#x20;companies.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;ai-uplift-for-ai-safety&quot;,&#x20;title&#x3A;&#x20;&quot;AI&#x20;uplift&#x20;for&#x20;AI&#x20;safety&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Jake&#x20;Mendel&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Help&#x20;the&#x20;independent&#x20;ecosystem&#x20;make&#x20;good&#x20;use&#x20;of&#x20;frontier&#x20;capabilities.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;In&#x20;the&#x20;lead-up&#x20;to&#x20;the&#x20;intelligence&#x20;explosion,&#x20;frontier&#x20;AI&#x20;systems&#x20;will&#x20;make&#x20;AI&#x20;capabilities&#x20;researchers&#x20;more&#x20;and&#x20;more&#x20;productive.&#x20;If&#x20;we&#x20;can&#x2019;t&#x20;also&#x20;uplift&#x20;AI&#x20;safety&#x20;and&#x20;governance&#x20;work,&#x20;AI&#x20;safety&#x20;could&#x20;fall&#x20;dramatically&#x20;behind.&#x20;We&#x20;expect&#x20;this&#x20;difference&#x20;in&#x20;uplift&#x20;will&#x20;only&#x20;worsen&#x20;as&#x20;AI&#x20;progress&#x20;continues&#x20;to&#x20;accelerate.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;is&#x20;not&#x20;only&#x20;because&#x20;AI&#x20;companies&#x20;will&#x20;optimize&#x20;their&#x20;products&#x20;for&#x20;their&#x20;own&#x20;capabilities&#x20;research.&#x20;It&#x2019;s&#x20;also&#x20;because&#x20;using&#x20;AI&#x20;effectively&#x20;requires&#x20;investing&#x20;time&#x20;that&#x20;could&#x20;otherwise&#x20;be&#x20;spent&#x20;doing&#x20;object-level&#x20;work.&#x20;It&#x20;requires&#x20;paying&#x20;constant&#x20;attention&#x20;to&#x20;AI&#x20;progress,&#x20;tracking&#x20;what&#x20;new&#x20;affordances&#x20;become&#x20;possible,&#x20;experimenting&#x20;with&#x20;and&#x20;adapting&#x20;your&#x20;workflows,&#x20;and&#x20;often&#x20;building&#x20;custom&#x20;tooling.&#x20;There&#x20;is&#x20;a&#x20;coordination&#x20;failure&#x20;here&#x3A;&#x20;investing&#x20;in&#x20;tools&#x20;and&#x20;best&#x20;practices&#x20;for&#x20;using&#x20;AI&#x20;to&#x20;accelerate&#x20;AI&#x20;safety&#x20;and&#x20;governance&#x20;is&#x20;a&#x20;public&#x20;good&#x20;that&#x20;individual&#x20;contributors&#x20;often&#x20;lack&#x20;capacity&#x20;for.&#x20;The&#x20;individuals&#x20;already&#x20;doing&#x20;this&#x20;work&#x20;have&#x20;limited&#x20;resources&#x20;and&#x20;can&#x2019;t&#x20;serve&#x20;the&#x20;entire&#x20;field.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;should&#x20;experiment&#x20;with&#x20;&#x5B;centralized&#x20;teams&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;nanransohoff.substack.com&#x2F;p&#x2F;there-should-be-general-managers&#x29;&#x20;owning&#x20;the&#x20;work&#x20;of&#x20;determining&#x20;how&#x20;best&#x20;to&#x20;use&#x20;AI&#x20;to&#x20;accelerate&#x20;the&#x20;whole&#x20;field&#x20;of&#x20;AI&#x20;safety&#x20;and&#x20;governance,&#x20;and&#x20;then&#x20;disseminating&#x20;their&#x20;tools&#x20;and&#x20;knowledge.&#x20;We&#x20;want&#x20;to&#x20;fund&#x20;AI&#x20;uplift&#x20;consultancies&#x20;staffed&#x20;by&#x20;&#x201C;AI&#x20;power&#x20;users&#x201D;&#x20;who&#x20;experiment&#x20;with&#x20;tools&#x20;and&#x20;workflows&#x20;and&#x20;track&#x20;what&#x20;is&#x20;working&#x20;at&#x20;the&#x20;frontier,&#x20;and&#x20;push&#x20;that&#x20;knowledge&#x20;out&#x20;to&#x20;those&#x20;working&#x20;on&#x20;AI&#x20;safety.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;are&#x20;excited&#x20;about&#x20;deploying&#x20;AI&#x20;power&#x20;users&#x20;into&#x20;AI&#x20;safety&#x20;organizations&#x20;to&#x20;provide&#x20;&#x201C;AI&#x20;coaching&#x201D;&#x20;for&#x20;individuals&#x20;&#x2013;&#x20;founders&#x20;with&#x20;productivity&#x20;coaching&#x20;experience&#x20;or&#x20;experience&#x20;as&#x20;a&#x20;forward-deployed&#x20;software&#x20;engineer&#x20;would&#x20;be&#x20;especially&#x20;promising.&#x20;It&#x20;would&#x20;also&#x20;be&#x20;valuable&#x20;for&#x20;this&#x20;team&#x20;to&#x20;build&#x20;and&#x20;maintain&#x20;a&#x20;shared&#x20;library&#x20;of&#x20;custom&#x20;AI&#x20;tools&#x20;for&#x20;the&#x20;AI&#x20;safety&#x20;community,&#x20;so&#x20;founders&#x20;with&#x20;a&#x20;product&#x20;background&#x20;or&#x20;direct&#x20;experience&#x20;in&#x20;the&#x20;roles&#x20;they&#x20;are&#x20;supporting&#x20;are&#x20;equally&#x20;promising.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;compute-cluster-for-ai-safety&quot;,&#x20;title&#x3A;&#x20;&quot;Compute&#x20;cluster&#x20;for&#x20;AI&#x20;safety&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Jake&#x20;Mendel&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Build&#x20;and&#x20;run&#x20;a&#x20;GPU&#x20;cluster&#x20;that&#x20;serves&#x20;the&#x20;AI&#x20;safety&#x20;nonprofit&#x20;ecosystem.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;AI&#x20;safety&#x20;researchers&#x20;already&#x20;make&#x20;heavy&#x20;use&#x20;of&#x20;cloud&#x20;GPUs&#x20;&#x2013;&#x20;and,&#x20;as&#x20;in&#x20;the&#x20;wider&#x20;world,&#x20;GPU&#x20;demand&#x20;has&#x20;been&#x20;increasing&#x20;rapidly.&#x20;Even&#x20;well-funded&#x20;AI&#x20;safety&#x20;projects&#x20;sometimes&#x20;struggle&#x20;to&#x20;secure&#x20;enough&#x20;compute&#x20;for&#x20;their&#x20;research,&#x20;especially&#x20;for&#x20;smaller&#x20;or&#x20;shorter-term&#x20;projects.&#x20;Each&#x20;nonprofit&#x20;has&#x20;to&#x20;develop&#x20;a&#x20;lot&#x20;of&#x20;in-house&#x20;expertise&#x20;before&#x20;they&#x20;can&#x20;scale&#x20;their&#x20;research&#x20;projects,&#x20;and&#x20;they&#x20;pay&#x20;a&#x20;heavy&#x20;premium&#x20;for&#x20;flexibility&#x20;in&#x20;their&#x20;compute&#x20;demand.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;But&#x20;the&#x20;situation&#x20;could&#x20;get&#x20;&#x5B;much&#x20;worse&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;writing.antonleicht.me&#x2F;p&#x2F;cut-off&#x29;.&#x20;If&#x20;timelines&#x20;are&#x20;short,&#x20;AI&#x20;safety&#x20;researchers&#x20;may&#x20;soon&#x20;be&#x20;managing&#x20;armies&#x20;of&#x20;automated&#x20;research&#x20;agents,&#x20;each&#x20;running&#x20;their&#x20;own&#x20;experiments&#x20;that&#x20;require&#x20;their&#x20;own&#x20;compute.&#x20;This&#x20;could&#x20;cause&#x20;an&#x20;explosion&#x20;in&#x20;AI&#x20;safety&#x20;demand&#x20;for&#x20;compute.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;think&#x20;there&#x20;should&#x20;be&#x20;a&#x20;dedicated&#x20;organization&#x20;focused&#x20;on&#x20;helping&#x20;AI&#x20;safety&#x20;research&#x20;groups&#x20;meet&#x20;their&#x20;compute&#x20;needs.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;It&#x20;may&#x20;be&#x20;best&#x20;to&#x20;set&#x20;up&#x20;a&#x20;centralized&#x20;cluster&#x20;to&#x20;aggregate&#x20;demand&#x20;from&#x20;across&#x20;the&#x20;AI&#x20;safety&#x20;ecosystem&#x20;and&#x20;secure&#x20;large&#x20;numbers&#x20;of&#x20;GPUs&#x20;on&#x20;longer-term&#x20;contracts.&#x20;Then,&#x20;the&#x20;organization&#x20;can&#x20;rent&#x20;out&#x20;compute&#x20;at&#x20;cost&#x20;to&#x20;AI&#x20;safety&#x20;projects&#x20;that&#x20;might&#x20;otherwise&#x20;struggle&#x20;to&#x20;secure&#x20;compute&#x20;given&#x20;their&#x20;smaller-scale&#x20;demands.&#x20;The&#x20;organization&#x20;could&#x20;also&#x20;set&#x20;up&#x20;infrastructure&#x20;on&#x20;its&#x20;cluster&#x20;that&#x20;lowers&#x20;the&#x20;technical&#x20;barriers&#x20;to&#x20;scaling&#x20;large&#x20;AI&#x20;safety&#x20;experiments.&#x20;They&#x20;might&#x20;find&#x20;other&#x20;unique&#x20;needs&#x20;of&#x20;the&#x20;field&#x20;that&#x20;they&#x20;can&#x20;help&#x20;address&#x20;&#x2013;&#x20;for&#x20;example,&#x20;enhanced&#x20;security&#x20;for&#x20;projects&#x20;that&#x20;are&#x20;using&#x20;frontier&#x20;models&#x20;before&#x20;their&#x20;public&#x20;release.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;re&#x20;particularly&#x20;excited&#x20;about&#x20;a&#x20;version&#x20;of&#x20;this&#x20;that&#x20;could&#x20;rapidly&#x20;scale&#x20;to&#x20;securing&#x20;hundreds&#x20;of&#x20;millions&#x20;or&#x20;even&#x20;billions&#x20;of&#x20;dollars&#x20;of&#x20;compute&#x20;per&#x20;year.&#x20;The&#x20;most&#x20;important&#x20;skill&#x20;set&#x20;we&#x20;are&#x20;looking&#x20;for&#x20;in&#x20;the&#x20;founding&#x20;team&#x20;is&#x20;experience&#x20;with&#x20;compute&#x20;procurement&#x20;and&#x20;management,&#x20;but&#x20;we&#x2019;d&#x20;also&#x20;be&#x20;interested&#x20;in&#x20;founders&#x20;who&#x20;have&#x20;experience&#x20;negotiating&#x20;large&#x20;contracts&#x20;with&#x20;industry&#x20;or&#x20;managing&#x20;large&#x20;infrastructure&#x20;projects.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;datasets-for-ai-safety&quot;,&#x20;title&#x3A;&#x20;&quot;Datasets&#x20;for&#x20;AI&#x20;safety&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Rohan&#x20;Subramani&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Build&#x20;datasets&#x20;and&#x20;environments&#x20;that&#x20;differentially&#x20;improve&#x20;AI&#x20;safety&#x20;capabilities.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;&#x5B;Many&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;alignment.anthropic.com&#x2F;2025&#x2F;bumpers&#x2F;&#x29;&#x20;&#x5B;strategies&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;openai.com&#x2F;index&#x2F;introducing-superalignment&#x2F;&#x29;&#x20;for&#x20;managing&#x20;the&#x20;intelligence&#x20;explosion&#x20;rely&#x20;on&#x20;automating&#x20;AI&#x20;alignment&#x20;and&#x20;other&#x20;risk-reducing&#x20;work,&#x20;like&#x20;cyberdefense&#x20;and&#x20;biosecurity.&#x20;Such&#x20;strategies&#x20;are&#x20;more&#x20;likely&#x20;to&#x20;succeed&#x20;if&#x20;AIs&#x20;have&#x20;a&#x20;favorable&#x20;balance&#x20;of&#x20;risk-reducing&#x20;vs.&#x20;risk-increasing&#x20;capabilities.&#x20;However,&#x20;little&#x20;work&#x20;is&#x20;currently&#x20;going&#x20;into&#x20;generating&#x20;data&#x20;that&#x20;differentially&#x20;advances&#x20;crucial&#x20;capabilities&#x20;for&#x20;global&#x20;catastrophic&#x20;risk&#x20;reduction.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x27;d&#x20;be&#x20;excited&#x20;to&#x20;see&#x20;organizations&#x20;that&#x20;can&#x20;provide&#x20;datasets&#x20;and&#x20;RL&#x20;environments&#x20;to&#x20;frontier&#x20;AI&#x20;companies&#x20;in&#x20;order&#x20;to&#x20;help&#x20;make&#x20;models&#x20;differentially&#x20;better&#x20;at&#x20;domains&#x20;like&#x20;AI&#x20;alignment,&#x20;AI&#x20;control,&#x20;cyberdefense,&#x20;biosecurity,&#x20;and&#x20;more.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;would&#x20;include&#x20;work&#x20;to&#x20;collect&#x20;and&#x20;create&#x20;prompts,&#x20;environments,&#x20;grading&#x20;rubrics,&#x20;graded&#x20;expert&#x20;solutions,&#x20;binary&#x20;preference&#x20;data,&#x20;text&#x20;diffs,&#x20;and&#x20;other&#x20;data&#x20;for&#x20;beneficial&#x20;domains.&#x20;The&#x20;organization&#x20;might&#x20;partner&#x20;with&#x20;teams&#x20;working&#x20;in&#x20;risk-reducing&#x20;domains&#x20;to&#x20;turn&#x20;their&#x20;existing&#x20;workflows&#x20;into&#x20;useful&#x20;data.&#x20;As&#x20;an&#x20;example,&#x20;writing&#x20;and&#x20;evaluating&#x20;safety&#x20;cases&#x20;may&#x20;be&#x20;a&#x20;particularly&#x20;important&#x20;skill&#x20;for&#x20;automated&#x20;AI&#x20;safety,&#x20;and&#x20;it&#x20;may&#x20;be&#x20;possible&#x20;to&#x20;&#x5B;create&#x20;valuable&#x20;data&#x20;for&#x20;it&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;x.com&#x2F;w01fe&#x2F;status&#x2F;2076065715984252959&#x29;.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Existing&#x20;teams&#x20;working&#x20;on&#x20;differential&#x20;capability&#x20;advancement&#x20;include&#x20;&#x5B;Trajectory&#x20;Labs&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.trajectorylabs.com&#x2F;careers&#x2F;expression-of-interest&#x29;,&#x20;the&#x20;&#x5B;Redwood&#x20;Research&#x20;conceptual&#x20;reasoning&#x20;capabilities&#x20;team&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;conceptualreasoning.ai&#x2F;about&#x29;,&#x20;and&#x20;&#x5B;Asymmetric&#x20;Security&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.asymmetricsecurity.com&#x2F;company&#x2F;&#x29;.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Identifying&#x20;domains&#x20;that&#x20;are&#x20;differentially&#x20;valuable&#x20;is&#x20;conceptually&#x20;complicated.&#x20;We&#x20;want&#x20;founders&#x20;to&#x20;be&#x20;thoughtful&#x20;about&#x20;selecting&#x20;projects&#x20;where&#x20;risk-mitigating&#x20;impacts&#x20;outweigh&#x20;risk-increasing&#x20;ones.&#x20;This&#x20;might&#x20;involve&#x20;prioritizing&#x20;real&#x20;AI&#x20;safety&#x20;tasks&#x20;over&#x20;merely&#x20;analogous&#x20;ones,&#x20;or&#x20;evaluating&#x20;whether&#x20;a&#x20;task&#x20;shares&#x20;subtasks&#x20;with&#x20;risky&#x20;areas&#x20;like&#x20;AI&#x20;R&amp;D,&#x20;deceptive&#x20;reasoning,&#x20;or&#x20;strategic&#x20;pursuit&#x20;of&#x20;long-term&#x20;goals&#x20;in&#x20;the&#x20;real&#x20;world.&#x20;Founders&#x20;would&#x20;also&#x20;ideally&#x20;have&#x20;experience&#x20;building&#x20;datasets&#x20;and&#x20;RL&#x20;environments,&#x20;and&#x20;work&#x20;effectively&#x20;with&#x20;AI&#x20;companies&#x20;to&#x20;help&#x20;them&#x20;adopt&#x20;the&#x20;datasets.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;awards-for-ai-safety&quot;,&#x20;title&#x3A;&#x20;&quot;Grand&#x20;awards&#x20;for&#x20;AI&#x20;safety&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Max&#x20;Nadeau&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Run&#x20;competitions&#x20;for&#x20;important&#x20;work&#x20;in&#x20;AI&#x20;safety.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Prizes&#x20;can&#x20;be&#x20;an&#x20;efficient&#x20;way&#x20;to&#x20;incentivize&#x20;progress&#x20;on&#x20;important,&#x20;difficult&#x20;or&#x20;neglected&#x20;problems,&#x20;and&#x20;most&#x20;other&#x20;technical&#x20;fields&#x20;&#x5B;have&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;amturing.acm.org&#x2F;&#x29;&#x20;&#x5B;prestigious&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.mathunion.org&#x2F;imu-awards&#x2F;fields-medal&#x29;&#x20;&#x5B;prizes&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.nobelprize.org&#x2F;prizes&#x2F;physics&#x2F;&#x29;.&#x20;&#x5B;Narrowly&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.alignment.org&#x2F;blog&#x2F;announcing-the-arc-white-box-estimation-challenge&#x2F;&#x29;&#x20;&#x5B;scoped&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.alignment.org&#x2F;blog&#x2F;prizes-for-elk-proposals&#x2F;&#x29;&#x20;&#x5B;prizes&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;app.grayswan.ai&#x2F;arena&#x29;&#x20;in&#x20;&#x5B;AI&#x20;safety&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.anthropic.com&#x2F;research&#x2F;constitutional-classifiers&#x29;&#x20;have&#x20;met&#x20;with&#x20;some&#x20;success&#x20;in&#x20;the&#x20;past.&#x20;Competitions&#x20;can&#x20;also&#x20;attract&#x20;new&#x20;talent&#x20;to&#x20;a&#x20;field,&#x20;and&#x20;newcomers&#x20;can&#x20;make&#x20;a&#x20;name&#x20;for&#x20;themselves&#x20;quickly&#x20;if&#x20;they&#x20;do&#x20;well.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;For&#x20;a&#x20;prize&#x20;or&#x20;competition&#x20;to&#x20;go&#x20;well,&#x20;the&#x20;problem&#x20;has&#x20;to&#x20;be&#x20;clearly&#x20;written&#x20;up,&#x20;the&#x20;prize&#x20;has&#x20;to&#x20;be&#x20;advertised&#x20;widely,&#x20;and&#x20;contestants&#x20;need&#x20;to&#x20;trust&#x20;in&#x20;advance&#x20;that&#x20;submissions&#x20;will&#x20;be&#x20;judged&#x20;well.&#x20;This&#x20;all&#x20;requires&#x20;technical&#x20;and&#x20;operational&#x20;capacity&#x20;that&#x20;AI&#x20;safety&#x20;researchers&#x20;and&#x20;grantmakers&#x20;currently&#x20;don&#x2019;t&#x20;have&#x20;enough&#x20;of,&#x20;so&#x20;the&#x20;field&#x20;currently&#x20;runs&#x20;far&#x20;fewer&#x20;prizes&#x20;than&#x20;it&#x20;ideally&#x20;would.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Build&#x20;a&#x20;new&#x20;organization&#x20;that&#x20;develops&#x20;expertise&#x20;at&#x20;running,&#x20;advertising,&#x20;and&#x20;coordinating&#x20;the&#x20;judging&#x20;for&#x20;prizes&#x20;and&#x20;competitions.&#x20;At&#x20;minimum,&#x20;it&#x20;would&#x20;offer&#x20;its&#x20;services&#x20;to&#x20;existing&#x20;researchers&#x20;who&#x20;want&#x20;to&#x20;set&#x20;up&#x20;a&#x20;prize&#x20;but&#x20;don&#x2019;t&#x20;have&#x20;the&#x20;capacity,&#x20;and&#x20;work&#x20;with&#x20;them&#x20;to&#x20;refine&#x20;a&#x20;concrete&#x20;problem,&#x20;advertise&#x20;it,&#x20;and&#x20;judge&#x20;submissions.&#x20;Experience&#x20;running&#x20;competitions,&#x20;bug&#x20;bounties,&#x20;or&#x20;prizes&#x20;may&#x20;be&#x20;helpful,&#x20;as&#x20;would&#x20;technical&#x20;expertise,&#x20;legal&#x20;expertise,&#x20;and&#x20;a&#x20;service-oriented,&#x20;collaborative&#x20;mindset.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Once&#x20;the&#x20;organization&#x20;develops&#x20;enough&#x20;capacity,&#x20;it&#x20;could&#x20;reach&#x20;out&#x20;to&#x20;top&#x20;AI&#x20;safety&#x20;researchers&#x20;to&#x20;help&#x20;them&#x20;refine&#x20;problems&#x20;that&#x20;they&#x20;are&#x20;working&#x20;on&#x20;into&#x20;competitions&#x20;for&#x20;the&#x20;organization&#x20;to&#x20;run.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Alternatively,&#x20;you&#x20;could&#x20;focus&#x20;on&#x20;trying&#x20;to&#x20;create&#x20;the&#x20;&#x201C;Nobel&#x20;Prize&#x20;for&#x20;AI&#x20;Safety&#x201D;&#x3A;&#x20;a&#x20;large&#x20;prize&#x20;with&#x20;broad&#x20;scope&#x20;that&#x20;is&#x20;administered&#x20;once&#x20;a&#x20;year&#x20;for&#x20;some&#x20;of&#x20;the&#x20;best&#x20;AI&#x20;safety&#x20;research&#x20;ever&#x20;done.&#x20;You&#x20;would&#x20;need&#x20;to&#x20;work&#x20;out&#x20;who&#x20;should&#x20;be&#x20;on&#x20;the&#x20;selection&#x20;committee&#x20;and&#x20;how&#x20;prizewinners&#x20;are&#x20;selected,&#x20;as&#x20;well&#x20;as&#x20;build&#x20;the&#x20;widespread&#x20;credibility&#x20;to&#x20;reach&#x20;a&#x20;high&#x20;level&#x20;of&#x20;prestige.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;talent&quot;,&#x20;title&#x3A;&#x20;&quot;Talent&#x20;acceleration&quot;,&#x20;anchor&#x3A;&#x20;&quot;talent-acceleration&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;image&#x3A;&#x20;&quot;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;wp-content&#x2F;uploads&#x2F;crop_talent.jpg&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;blurb&#x3A;&#x20;&quot;People&#x20;are&#x20;the&#x20;binding&#x20;constraint&#x20;on&#x20;the&#x20;field.&#x20;We&#x20;want&#x20;to&#x20;fund&#x20;teams&#x20;to&#x20;address&#x20;that&#x20;bottleneck.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;projects&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;senior-talent-headhunting&quot;,&#x20;title&#x3A;&#x20;&quot;Senior&#x20;talent&#x20;headhunting&quot;,&#x20;featured&#x3A;&#x20;true,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Asya&#x20;Bergal&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;quote&#x3A;&#x20;&#x7B;&#x20;name&#x3A;&#x20;&quot;Ryan&#x20;Kidd&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;text&#x3A;&#x20;&quot;Given&#x20;that&#x20;the&#x20;field&#x20;of&#x20;AI&#x20;safety&#x20;should&#x20;grow&#x20;10-100x&#x20;in&#x20;the&#x20;next&#x20;few&#x20;years,&#x20;the&#x20;most&#x20;talent-constrained&#x20;roles&#x20;are&#x20;founders,&#x20;field-builders,&#x20;and&#x20;&#x27;amplifier&#x27;&#x20;roles&#x20;that&#x20;unblock&#x20;scaling&#x20;for&#x20;large&#x20;AI&#x20;safety&#x20;orgs&#x2F;teams.&quot;&#x20;&#x7D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Recruit&#x20;senior&#x20;or&#x20;specialized&#x20;talent&#x20;to&#x20;work&#x20;on&#x20;important&#x20;areas&#x20;in&#x20;AI&#x20;safety.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Many&#x20;of&#x20;the&#x20;initiatives&#x20;in&#x20;this&#x20;list&#x20;benefit&#x20;from&#x20;particular&#x20;kinds&#x20;of&#x20;expertise,&#x20;such&#x20;as&#x20;information&#x20;security,&#x20;hardware&#x20;engineering,&#x20;law,&#x20;D.C.&#x20;policy&#x20;or&#x20;intelligence&#x20;work,&#x20;or&#x20;entrepreneurship.&#x20;As&#x20;AI&#x20;development&#x20;progresses,&#x20;there&#x20;is&#x20;increased&#x20;demand&#x20;for&#x20;&#x28;and&#x20;interest&#x20;from&#x29;&#x20;professionals&#x20;with&#x20;these&#x20;kinds&#x20;of&#x20;backgrounds&#x20;to&#x20;work&#x20;on&#x20;catastrophic&#x20;risks&#x20;from&#x20;AI.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;think&#x20;there&#x27;s&#x20;a&#x20;big&#x20;opportunity&#x20;to&#x20;recruit&#x20;people&#x20;with&#x20;these&#x20;kinds&#x20;of&#x20;backgrounds&#x20;to&#x20;found&#x20;new&#x20;projects&#x20;or&#x20;take&#x20;on&#x20;senior&#x20;roles&#x20;in&#x20;existing&#x20;high-impact&#x20;organizations.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;an&#x20;impact-motivated&#x20;headhunting&#x20;firm&#x20;dedicated&#x20;to&#x20;engaging&#x20;and&#x20;recruiting&#x20;senior&#x20;or&#x20;specialized&#x20;talent.&#x20;We&#x20;expect&#x20;this&#x20;to&#x20;require&#x20;a&#x20;deep&#x20;understanding&#x20;of&#x20;the&#x20;ecosystem&#x2019;s&#x20;needs&#x20;and&#x20;impact,&#x20;highly&#x20;specialized&#x20;searches,&#x20;a&#x20;willingness&#x20;to&#x20;approach&#x20;candidates&#x20;who&#x20;may&#x20;not&#x20;actively&#x20;be&#x20;looking&#x20;to&#x20;do&#x20;something&#x20;new,&#x20;and&#x20;significant&#x20;effort&#x20;on&#x20;both&#x20;pitching&#x20;and&#x20;vetting&#x20;top&#x20;talent.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;In&#x20;its&#x20;first&#x20;year,&#x20;success&#x20;might&#x20;include&#x20;building&#x20;and&#x20;testing&#x20;the&#x20;core&#x20;product&#x3A;&#x20;engaging&#x20;with&#x20;relevant&#x20;pools&#x20;of&#x20;talent,&#x20;developing&#x20;a&#x20;rigorous&#x20;search&#x20;and&#x20;assessment&#x20;process,&#x20;and&#x20;helping&#x20;four&#x20;or&#x20;five&#x20;individuals&#x20;make&#x20;successful&#x20;transitions&#x20;from&#x20;government&#x20;or&#x20;industry&#x20;jobs.&#x20;Within&#x20;two&#x20;years&#x20;it&#x20;would&#x20;be&#x20;a&#x20;great&#x20;sign&#x20;if&#x20;the&#x20;team&#x20;was&#x20;on&#x20;track&#x20;to&#x20;place&#x20;roughly&#x20;10&#x2013;15&#x20;such&#x20;specialists&#x20;into&#x20;founder&#x20;or&#x20;leadership&#x20;roles&#x20;annually.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;most&#x20;successful&#x20;version&#x20;of&#x20;this&#x20;firm&#x20;will&#x20;collaborate&#x20;closely&#x20;with&#x20;existing&#x20;talent&#x20;development&#x20;orgs&#x20;throughout&#x20;the&#x20;AI&#x20;safety&#x20;pipeline.&#x20;A&#x20;version&#x20;of&#x20;this&#x20;effort&#x20;could&#x20;also&#x20;merge&#x20;with&#x20;our&#x20;proposed&#x20;&#x5B;context&#x20;accelerator&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;tailwind&#x2F;initiatives&#x2F;&#x23;ai-context-accelerator&#x29;,&#x20;which&#x20;helps&#x20;professionals&#x20;build&#x20;the&#x20;context&#x20;and&#x20;networks&#x20;required&#x20;for&#x20;high-leverage&#x20;AI&#x20;safety&#x20;leadership&#x20;roles.&#x20;The&#x20;founding&#x20;team&#x20;should&#x20;have&#x20;a&#x20;strong&#x20;understanding&#x20;of&#x20;the&#x20;existing&#x20;AI&#x20;safety&#x20;ecosystem,&#x20;and&#x20;would&#x20;ideally&#x20;either&#x20;have&#x20;networks&#x20;or&#x20;close&#x20;contacts&#x20;with&#x20;networks&#x20;in&#x20;one&#x20;or&#x20;more&#x20;specialized&#x20;communities&#x20;relevant&#x20;to&#x20;AI&#x20;safety&#x20;&#x2013;&#x20;e.g.&#x20;national&#x20;security,&#x20;intelligence,&#x20;hardware&#x20;engineering,&#x20;government,&#x20;and&#x20;industry,&#x20;among&#x20;others.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;talent-matchmaking&quot;,&#x20;title&#x3A;&#x20;&quot;Talent&#x20;matchmaking&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Asya&#x20;Bergal&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Build&#x20;infrastructure&#x20;to&#x20;fill&#x20;important&#x20;roles&#x20;in&#x20;the&#x20;AI&#x20;safety&#x20;ecosystem.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Hiring&#x20;is&#x20;a&#x20;significant&#x20;bottleneck&#x20;for&#x20;AI&#x20;safety,&#x20;and&#x20;a&#x20;point&#x20;of&#x20;leverage&#x20;for&#x20;all&#x20;the&#x20;work&#x20;we&#x20;support.&#x20;Strong&#x20;hires&#x20;can&#x20;significantly&#x20;increase&#x20;an&#x20;organization&#x2019;s&#x20;impact,&#x20;and&#x20;many&#x20;important&#x20;projects&#x20;&#x28;including&#x20;those&#x20;on&#x20;this&#x20;list&#x29;&#x20;are&#x20;bottlenecked&#x20;on&#x20;finding&#x20;strong&#x20;candidates&#x20;to&#x20;start&#x20;them&#x20;in&#x20;the&#x20;first&#x20;place.&#x20;Historically,&#x20;many&#x20;successful&#x20;hires&#x20;and&#x20;founders&#x20;have&#x20;come&#x20;from&#x20;the&#x20;existing&#x20;AI&#x20;safety&#x20;ecosystem,&#x20;and&#x20;there&#x2019;s&#x20;substantial&#x20;room&#x20;to&#x20;improve&#x20;on&#x20;sourcing&#x20;great&#x20;candidates&#x20;by&#x20;leveraging&#x20;that&#x20;network&#x20;in&#x20;a&#x20;more&#x20;scalable&#x20;and&#x20;systematic&#x20;way.&#x20;We&#x2019;re&#x20;excited&#x20;that&#x20;some&#x20;organizations&#x20;are&#x20;already&#x20;working&#x20;on&#x20;this&#x20;problem,&#x20;but&#x20;we&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;more&#x20;in&#x20;this&#x20;space.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;An&#x20;ambitious&#x20;version&#x20;of&#x20;this&#x20;project&#x20;would&#x20;aim&#x20;to&#x20;provide&#x20;&#x2A;scalable&#x2A;&#x20;support&#x20;to&#x20;organizations&#x20;and&#x20;grantmakers&#x20;looking&#x20;to&#x20;fill&#x20;important&#x20;roles,&#x20;including&#x20;founder&#x20;roles.&#x20;A&#x20;project&#x20;like&#x20;this&#x20;might&#x20;aim&#x20;to&#x20;create&#x20;and&#x20;maintain&#x20;a&#x20;database&#x20;of&#x20;top&#x20;talent&#x20;for&#x20;candidate&#x20;sourcing,&#x20;draw&#x20;talent&#x20;from&#x20;existing&#x20;programs,&#x20;events,&#x20;or&#x20;groups,&#x20;or&#x20;seek&#x20;out&#x20;new&#x20;talent&#x20;from&#x20;adjacent&#x20;networks&#x20;via&#x20;personal&#x20;referrals.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;project&#x20;could&#x20;start&#x20;by&#x20;focusing&#x20;on&#x20;finding&#x20;talent&#x20;across&#x20;a&#x20;particular&#x20;role&#x20;type&#x20;&#x28;for&#x20;example,&#x20;COOs&#x20;or&#x20;operations&#x20;positions&#x29;&#x20;and&#x20;add&#x20;new&#x20;roles&#x20;or&#x20;sectors&#x20;over&#x20;time.&#x20;Alternatively,&#x20;it&#x20;could&#x20;start&#x20;by&#x20;working&#x20;on&#x20;finding&#x20;high-quality&#x20;hires&#x20;for&#x20;a&#x20;particular&#x20;organization&#x20;and&#x20;then&#x20;expand&#x20;out&#x20;to&#x20;other&#x20;organizations&#x20;from&#x20;there.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;think&#x20;this&#x20;project&#x20;relies&#x20;more&#x20;on&#x20;networks&#x20;within&#x20;the&#x20;existing&#x20;AI&#x20;safety&#x20;ecosystem,&#x20;while&#x20;our&#x20;&#x5B;senior&#x20;talent&#x20;headhunting&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;tailwind&#x2F;initiatives&#x2F;&#x23;senior-talent-headhunting&#x29;&#x20;idea&#x20;is&#x20;about&#x20;finding&#x20;and&#x20;pitching&#x20;talent&#x20;outside&#x20;of&#x20;it,&#x20;but&#x20;the&#x20;right&#x20;team&#x20;could&#x20;do&#x20;both.&#x20;It&#x20;could&#x20;live&#x20;within&#x20;existing&#x20;organizations&#x20;working&#x20;on&#x20;talent&#x20;and&#x20;infrastructure&#x20;&#x28;for&#x20;example,&#x20;BlueDot&#x20;Impact,&#x20;Kairos,&#x20;Constellation,&#x20;or&#x20;80,000&#x20;Hours&#x29;,&#x20;or&#x20;could&#x20;be&#x20;an&#x20;entirely&#x20;new&#x20;project.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;mid-career-entry-points&quot;,&#x20;title&#x3A;&#x20;&quot;Mid-career&#x20;entry&#x20;points&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Ben&#x20;Esche&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Expand&#x20;opportunities&#x20;for&#x20;experienced&#x20;professionals&#x20;to&#x20;join&#x20;AI&#x20;safety&#x20;orgs.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;AI&#x20;safety&#x20;ecosystem&#x20;is&#x20;constrained&#x20;by&#x20;its&#x20;supply&#x20;of&#x20;senior,&#x20;specialized&#x20;talent&#x20;ready&#x20;to&#x20;step&#x20;into&#x20;key&#x20;roles.&#x20;There&#x20;is&#x20;a&#x20;clear&#x20;need&#x20;for&#x20;experienced&#x20;professionals&#x20;in&#x20;domains&#x20;like&#x20;information&#x20;security,&#x20;communications,&#x20;policy,&#x20;operations,&#x20;and&#x20;more.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Historically,&#x20;most&#x20;efforts&#x20;to&#x20;attract&#x20;new&#x20;people&#x20;into&#x20;the&#x20;field&#x20;of&#x20;AI&#x20;safety&#x20;have&#x20;focused&#x20;on&#x20;early-career&#x20;researchers&#x20;and&#x20;students,&#x20;as&#x20;senior&#x20;professionals&#x20;are&#x20;less&#x20;likely&#x20;to&#x20;shift&#x20;careers&#x20;into&#x20;a&#x20;speculative&#x20;new&#x20;domain.&#x20;As&#x20;the&#x20;field&#x20;matures,&#x20;the&#x20;challenge&#x20;now&#x20;is&#x20;marketing&#x20;it&#x20;as&#x20;a&#x20;great&#x20;space&#x20;for&#x20;senior&#x20;and&#x20;successful&#x20;people&#x20;to&#x20;continue&#x20;their&#x20;careers.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Someone&#x20;looking&#x20;to&#x20;own&#x20;this&#x20;problem&#x20;should&#x20;start&#x20;with&#x20;building&#x20;a&#x20;deep&#x20;understanding&#x20;of&#x20;the&#x20;frictions&#x20;and&#x20;barriers&#x20;preventing&#x20;successful&#x20;mid-career&#x20;people&#x20;from&#x20;moving&#x20;into&#x20;the&#x20;space.&#x20;They&#x20;should&#x20;be&#x20;willing&#x20;to&#x20;experiment&#x20;with&#x20;different&#x20;solutions,&#x20;iterate&#x20;quickly,&#x20;and&#x20;triage&#x20;to&#x20;focus&#x20;on&#x20;what&#x20;works&#x20;best.&#x20;A&#x20;good&#x20;version&#x20;of&#x20;this&#x20;might&#x20;look&#x20;like&#x20;piloting&#x20;three&#x20;to&#x20;six&#x20;different&#x20;interventions&#x20;in&#x20;the&#x20;first&#x20;year,&#x20;and&#x20;scaling&#x20;up&#x20;the&#x20;best&#x20;one&#x20;or&#x20;two&#x20;interventions&#x20;to&#x20;reach&#x20;hundreds&#x20;of&#x20;very&#x20;impressive&#x20;people&#x20;by&#x20;the&#x20;end&#x20;of&#x20;the&#x20;second&#x20;year.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Some&#x20;example&#x20;interventions&#x20;include&#x20;in-person&#x20;events&#x20;and&#x20;introductory&#x20;courses.&#x20;Events&#x20;would&#x20;aim&#x20;to&#x20;create&#x20;cohorts&#x20;of&#x20;impressive&#x20;people&#x20;who&#x20;can&#x20;motivate&#x20;and&#x20;validate&#x20;each&#x20;other&#x20;as&#x20;they&#x20;pivot&#x20;to&#x20;work&#x20;on&#x20;transformative&#x20;AI.&#x20;Courses&#x20;could&#x20;have&#x20;content&#x20;similar&#x20;to&#x20;those&#x20;run&#x20;by&#x20;&#x5B;BlueDot&#x20;Impact&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;bluedot.org&#x2F;courses&#x29;,&#x20;but&#x20;more&#x20;deliberately&#x20;targeted&#x20;at&#x20;people&#x20;who&#x20;have&#x20;already&#x20;had&#x20;successful&#x20;careers.&#x20;This&#x20;could&#x20;be&#x20;done&#x20;by&#x20;focusing&#x20;on&#x20;applying&#x20;transferable&#x20;skills&#x20;and&#x20;expertise,&#x20;curating&#x20;cohorts&#x20;with&#x20;similar&#x20;specialties,&#x20;or&#x20;signaling&#x20;quality&#x20;through&#x20;highly&#x20;selective&#x20;admissions&#x20;or&#x20;notable&#x20;speakers.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;most&#x20;impactful&#x20;version&#x20;of&#x20;this&#x20;organization&#x20;probably&#x20;focuses&#x20;on&#x20;attracting&#x20;smaller&#x20;cohorts&#x20;of&#x20;highly&#x20;exceptional&#x20;people,&#x20;but&#x20;there&#x20;may&#x20;also&#x20;be&#x20;good&#x20;versions&#x20;that&#x20;are&#x20;more&#x20;broadly&#x20;targeted&#x20;and&#x20;higher-volume.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Founders&#x20;who&#x20;have&#x20;experience&#x20;with&#x20;training,&#x20;convening,&#x20;or&#x20;placing&#x20;high-caliber&#x20;individuals&#x20;in&#x20;senior&#x20;roles,&#x20;or&#x20;who&#x20;have&#x20;backgrounds&#x20;in&#x20;executive&#x20;coaching,&#x20;headhunting,&#x20;executive&#x20;search,&#x20;or&#x20;organizing&#x20;high-stakes&#x20;events&#x20;could&#x20;be&#x20;especially&#x20;well-suited&#x20;for&#x20;this&#x20;work.&#x20;We&#x2019;re&#x20;also&#x20;interested&#x20;in&#x20;candidates&#x20;who&#x20;have&#x20;deep&#x20;networks&#x20;in&#x20;the&#x20;space,&#x20;and&#x20;have&#x20;&#x28;or&#x20;can&#x20;quickly&#x20;acquire&#x29;&#x20;a&#x20;strong&#x20;understanding&#x20;of&#x20;the&#x20;AI&#x20;safety&#x20;ecosystem&#x20;and&#x20;its&#x20;talent&#x20;needs.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;ai-context-accelerator&quot;,&#x20;title&#x3A;&#x20;&quot;AI&#x20;context&#x20;accelerator&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Asya&#x20;Bergal&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Help&#x20;experienced&#x20;professionals&#x20;build&#x20;the&#x20;context&#x20;and&#x20;networks&#x20;for&#x20;AI&#x20;safety&#x20;leadership&#x20;roles.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;There&#x27;s&#x20;substantial&#x20;demand&#x20;for&#x20;certain&#x20;kinds&#x20;of&#x20;expertise&#x20;in&#x20;work&#x20;focused&#x20;on&#x20;catastrophic&#x20;risk,&#x20;but&#x20;many&#x20;experienced&#x20;professionals&#x20;interested&#x20;in&#x20;entering&#x20;the&#x20;field&#x20;&#x28;e.g.&#x20;from&#x20;domains&#x20;like&#x20;infosecurity,&#x20;communications,&#x20;policy,&#x20;operations,&#x20;and&#x20;law&#x29;&#x20;haven&#x2019;t&#x20;yet&#x20;developed&#x20;a&#x20;deep&#x20;understanding&#x20;of&#x20;AI&#x20;safety&#x20;as&#x20;a&#x20;strategy&#x20;or&#x20;a&#x20;field.&#x20;We&#x20;think&#x20;a&#x20;project&#x20;or&#x20;organization&#x20;dedicated&#x20;to&#x20;quickly&#x20;getting&#x20;interested&#x20;professionals&#x20;up&#x20;to&#x20;speed&#x20;would&#x20;be&#x20;extremely&#x20;valuable&#x20;for&#x20;bolstering&#x20;the&#x20;ecosystem.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;this&#x20;organization&#x20;to&#x20;provide&#x20;bespoke&#x20;and&#x20;high-touch&#x20;context-building&#x20;programs&#x20;for&#x20;impressive&#x20;and&#x20;experienced&#x20;people&#x20;looking&#x20;to&#x20;transition&#x20;into&#x20;AI&#x20;safety&#x20;&#x2013;&#x20;think&#x20;intensive,&#x20;paid,&#x20;executive-education-style&#x20;programs&#x20;for&#x20;professionals&#x20;with&#x20;15&#x2B;&#x20;years&#x20;of&#x20;relevant&#x20;experience.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Our&#x20;policy&#x20;and&#x20;governance&#x20;team&#x20;is&#x20;currently&#x20;running&#x20;a&#x20;30-person&#x20;pilot&#x20;program&#x20;that&#x20;provides&#x20;structured&#x20;coursework,&#x20;cohort&#x20;discussions,&#x20;immersion,&#x20;and&#x20;a&#x20;clear&#x20;set&#x20;of&#x20;pathways&#x20;for&#x20;alumni&#x20;to&#x20;launch&#x20;their&#x20;own&#x20;projects,&#x20;join&#x20;high-impact&#x20;organizations,&#x20;or&#x20;otherwise&#x20;start&#x20;working&#x20;in&#x20;the&#x20;field&#x20;immediately.&#x20;We&#x2019;d&#x20;like&#x20;an&#x20;organization&#x20;to&#x20;improve&#x20;on&#x20;our&#x20;pilot&#x20;and&#x20;scale&#x20;the&#x20;program&#x20;across&#x20;5&#x2013;20&#x20;high-value&#x20;domains&#x20;in&#x20;order&#x20;to&#x20;help&#x20;the&#x20;most&#x20;promising&#x20;late-stage&#x20;talent&#x20;become&#x20;high-context,&#x20;high-impact&#x20;leaders.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;goal&#x20;is&#x20;that&#x20;by&#x20;the&#x20;end&#x20;of&#x20;2027,&#x20;dozens&#x20;of&#x20;senior&#x20;or&#x20;specialist&#x20;leaders&#x20;from&#x20;outside&#x20;the&#x20;AI&#x20;safety&#x20;ecosystem&#x20;will&#x20;have&#x20;built&#x20;the&#x20;context&#x20;and&#x20;networks&#x20;required&#x20;to&#x20;found&#x20;or&#x20;join&#x20;high-impact&#x20;organizations.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;think&#x20;the&#x20;best&#x20;version&#x20;of&#x20;this&#x20;project&#x20;might&#x20;combine&#x20;this&#x20;offering&#x20;with&#x20;our&#x20;proposed&#x20;&#x5B;headhunting&#x20;initiative&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;tailwind&#x2F;initiatives&#x2F;&#x23;senior-talent-headhunting&#x29;,&#x20;which&#x20;aims&#x20;to&#x20;identify&#x20;and&#x20;recruit&#x20;these&#x20;same&#x20;senior&#x20;or&#x20;specialized&#x20;professionals.&#x20;We&#x2019;d&#x20;be&#x20;especially&#x20;excited&#x20;by&#x20;founders&#x20;who&#x20;have&#x20;run&#x20;a&#x20;high-touch&#x20;program&#x20;for&#x20;ambitious&#x20;professionals&#x20;before,&#x20;including&#x20;incubators,&#x20;executive&#x20;education,&#x20;bootcamps,&#x20;or&#x20;retreats.&#x20;At&#x20;least&#x20;one&#x20;member&#x20;of&#x20;the&#x20;founding&#x20;team&#x20;should&#x20;be&#x20;familiar&#x20;with&#x20;the&#x20;AI&#x20;safety&#x20;ecosystem&#x20;and&#x20;be&#x20;able&#x20;to&#x20;create&#x20;a&#x20;cohort&#x20;experience&#x20;that&#x20;includes&#x20;access&#x20;to&#x20;existing&#x20;AI&#x20;safety&#x20;networks.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;philanthropic-startup-incubator&quot;,&#x20;title&#x3A;&#x20;&quot;Philanthropic&#x20;startup&#x20;incubator&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Asya&#x20;Bergal&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Build&#x20;the&#x20;infrastructure&#x20;to&#x20;launch&#x20;and&#x20;scale&#x20;cohorts&#x20;of&#x20;new&#x20;AI&#x20;safety&#x20;projects.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Coefficient&#x2019;s&#x20;AI&#x20;teams&#x20;were&#x20;able&#x20;to&#x20;quickly&#x20;generate&#x20;a&#x20;list&#x20;of&#x20;more&#x20;than&#x20;200&#x20;projects&#x20;we&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;launched&#x20;&#x28;one&#x20;reason&#x20;for&#x20;this&#x20;whole&#x20;call&#x21;&#x29;,&#x20;but&#x20;which&#x20;haven&#x2019;t&#x20;been&#x20;covered&#x20;by&#x20;strong&#x20;submissions&#x20;to&#x20;our&#x20;RFPs.&#x20;We&#x20;expect&#x20;credible&#x20;and&#x20;ambitious&#x20;founders,&#x20;not&#x20;funding&#x20;or&#x20;ideas,&#x20;to&#x20;be&#x20;the&#x20;limiting&#x20;factor&#x20;on&#x20;the&#x20;number&#x20;of&#x20;problems&#x20;the&#x20;field&#x20;can&#x20;tackle.&#x20;We&#x20;need&#x20;people&#x20;who&#x20;can&#x20;take&#x20;a&#x20;problem&#x20;from&#x20;a&#x20;one-pager&#x20;to&#x20;a&#x20;launched,&#x20;staffed,&#x20;and&#x20;scalable&#x20;&#x5B;philanthropic&#x20;startup&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;nanransohoff.substack.com&#x2F;i&#x2F;198188301&#x2F;we-need-a-silicon-valley-for-public-goods&#x29;.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;requires&#x20;founders&#x20;to&#x20;validate&#x20;a&#x20;discrete&#x20;problem&#x20;with&#x20;experts&#x20;and&#x20;&#x28;if&#x20;possible&#x29;&#x20;evidence,&#x20;to&#x20;generate,&#x20;evaluate,&#x20;and&#x20;prioritize&#x20;solutions,&#x20;and&#x20;then&#x20;to&#x20;rapidly&#x20;test&#x20;those&#x20;while&#x20;building&#x20;a&#x20;clear&#x20;theory&#x20;of&#x20;change&#x20;&#x2013;&#x20;all&#x20;of&#x20;which&#x20;could&#x20;benefit&#x20;from&#x20;the&#x20;coaching,&#x20;structure,&#x20;and&#x20;support&#x20;of&#x20;an&#x20;incubator.&#x20;It&#x2019;s&#x20;exciting&#x20;to&#x20;see&#x20;some&#x20;organizations&#x20;already&#x20;working&#x20;on&#x20;this&#x20;problem,&#x20;but&#x20;we&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;more&#x20;capacity&#x20;in&#x20;this&#x20;space.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;more&#x20;organizations&#x20;try&#x20;to&#x20;run&#x20;the&#x20;&#x5B;Charity&#x20;Entrepreneurship&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.charityentrepreneurship.com&#x2F;&#x29;&#x20;playbook&#x20;for&#x20;AI&#x20;safety&#x20;and&#x20;global&#x20;catastrophic&#x20;risk&#x3A;&#x20;shortlist&#x20;high-priority&#x20;projects&#x20;through&#x20;research&#x20;or&#x20;partnerships&#x20;with&#x20;CG&#x20;or&#x20;other&#x20;organizations&#x20;with&#x20;great&#x20;project&#x20;ideas,&#x20;recruit&#x20;and&#x20;select&#x20;exceptional&#x20;would-be&#x20;founders,&#x20;run&#x20;an&#x20;intensive&#x20;cohort&#x20;to&#x20;match&#x20;co-founders&#x20;and&#x20;org&#x20;ideas,&#x20;and&#x20;launch&#x20;each&#x20;team&#x20;with&#x20;seed&#x20;funding,&#x20;networks,&#x20;and&#x20;advisors.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;An&#x20;exceptional&#x20;team&#x20;could&#x20;even&#x20;take&#x20;over&#x20;this&#x20;call&#x20;for&#x20;founders&#x20;and&#x20;run&#x20;an&#x20;excellent&#x20;program&#x20;for&#x20;the&#x20;next&#x20;cohort.&#x20;Once&#x20;running,&#x20;we&#x2019;d&#x20;consider&#x20;it&#x20;a&#x20;success&#x20;if&#x20;it&#x20;were&#x20;on&#x20;track&#x20;to&#x20;produce&#x20;a&#x20;steady&#x20;pipeline&#x20;of&#x20;fundable&#x20;new&#x20;orgs&#x20;on&#x20;the&#x20;order&#x20;of&#x20;5&#x2013;10&#x20;a&#x20;year.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;be&#x20;excited&#x20;about&#x20;teams&#x20;where&#x20;at&#x20;least&#x20;one&#x20;founder&#x20;has&#x20;experience&#x20;running&#x20;an&#x20;incubator&#x20;or&#x20;startup&#x20;of&#x20;their&#x20;own,&#x20;and&#x20;ideal&#x20;team&#x20;might&#x20;include&#x20;someone&#x20;who&#x20;could&#x20;be&#x20;the&#x20;&#x201C;Paul&#x20;Graham&#x20;of&#x20;AI&#x20;safety&#x201D;&#x3A;&#x20;a&#x20;builder&#x20;and&#x20;coach&#x20;with&#x20;an&#x20;exceptional&#x20;eye&#x20;for&#x20;talent&#x20;and&#x20;the&#x20;network&#x20;to&#x20;match&#x20;founders&#x20;to&#x20;ideas&#x20;and&#x20;their&#x20;first&#x20;funders&#x20;&#x28;including&#x20;but&#x20;not&#x20;limited&#x20;to&#x20;Coefficient&#x29;.&#x20;Strong&#x20;teams&#x20;would&#x20;also&#x20;have&#x20;the&#x20;research&#x20;capacity&#x20;to&#x20;generate&#x20;project&#x20;ideas,&#x20;either&#x20;internally&#x20;or&#x20;in&#x20;collaboration&#x20;with&#x20;their&#x20;networks,&#x20;and&#x20;a&#x20;clear-eyed&#x20;view&#x20;of&#x20;the&#x20;&#x5B;challenges&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;forum.effectivealtruism.org&#x2F;posts&#x2F;ckokr9uhr2Cu3h5En&#x2F;tips-for-people-considering-starting-new-incubators&#x29;&#x20;of&#x20;running&#x20;an&#x20;incubator.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;fiscal-sponsors&quot;,&#x20;title&#x3A;&#x20;&quot;Fiscal&#x20;sponsors&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;David&#x20;Bernard&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Build&#x20;fiscal&#x20;sponsorship&#x20;capacity&#x20;to&#x20;absorb&#x20;new&#x20;organizations&#x20;over&#x20;the&#x20;next&#x20;1-2&#x20;years.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Launching&#x20;and&#x20;running&#x20;a&#x20;nonprofit&#x20;entails&#x20;lots&#x20;of&#x20;overhead&#x3A;&#x20;incorporating&#x20;an&#x20;entity,&#x20;payroll&#x20;and&#x20;benefits,&#x20;bookkeeping,&#x20;audits,&#x20;tax&#x20;filings,&#x20;insurance,&#x20;HR,&#x20;and&#x20;compliance.&#x20;We&#x20;want&#x20;founders&#x20;to&#x20;be&#x20;able&#x20;to&#x20;focus&#x20;on&#x20;their&#x20;mission&#x20;without&#x20;getting&#x20;bogged&#x20;down&#x20;in&#x20;operations.&#x20;&#x5B;Fiscal&#x20;sponsorship&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;en.wikipedia.org&#x2F;wiki&#x2F;Fiscal_sponsorship&#x29;&#x20;addresses&#x20;this&#x20;by&#x20;allowing&#x20;an&#x20;established&#x20;nonprofit&#x20;to&#x20;take&#x20;new&#x20;projects&#x20;under&#x20;its&#x20;own&#x20;legal&#x20;and&#x20;tax-exempt&#x20;umbrella&#x20;and&#x20;run&#x20;their&#x20;operations.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;call&#x20;includes&#x20;dozens&#x20;of&#x20;projects&#x20;we&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;launched&#x20;in&#x20;addition&#x20;to&#x20;the&#x20;business-as-usual&#x20;stream&#x20;of&#x20;new&#x20;organizations&#x3B;&#x20;that&#x20;means&#x20;more&#x20;projects&#x20;will&#x20;likely&#x20;need&#x20;fiscal&#x20;sponsorship.&#x20;A&#x20;mainstream&#x20;fiscal&#x20;sponsorship&#x20;industry&#x20;already&#x20;exists,&#x20;but&#x20;it&#x20;isn&#x2019;t&#x20;attuned&#x20;to&#x20;the&#x20;specific&#x20;needs&#x20;of&#x20;AI&#x20;safety&#x20;projects.&#x20;A&#x20;few&#x20;AI-safety-specific&#x20;sponsors&#x20;have&#x20;grown&#x20;up&#x20;to&#x20;fill&#x20;that&#x20;gap&#x20;&#x2013;&#x20;including&#x20;the&#x20;&#x5B;Berkeley&#x20;Existential&#x20;Risk&#x20;Initiative&#x20;&#x28;BERI&#x29;&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.existence.org&#x2F;&#x29;,&#x20;Rethink&#x20;Priorities&#x2019;&#x20;&#x5B;Special&#x20;Projects&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;rethinkpriorities.org&#x2F;our-services&#x2F;special-projects&#x2F;&#x29;,&#x20;and&#x20;&#x5B;Ashgro&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.ashgro.org&#x2F;&#x29;&#x20;&#x2013;&#x20;but&#x20;we&#x20;anticipate&#x20;demand&#x20;for&#x20;more.&#x20;We&#x20;want&#x20;the&#x20;best&#x20;fiscal&#x20;sponsors&#x20;to&#x20;grow&#x20;to&#x20;take&#x20;on&#x20;more&#x20;projects,&#x20;and&#x20;we&#x20;want&#x20;more&#x20;fiscal&#x20;sponsors&#x20;so&#x20;the&#x20;ecosystem&#x20;doesn&#x2019;t&#x20;rest&#x20;on&#x20;a&#x20;few&#x20;points&#x20;of&#x20;failure.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;A&#x20;fiscal&#x20;sponsor&#x20;runs&#x20;the&#x20;operations&#x20;for&#x20;the&#x20;projects&#x20;it&#x20;hosts&#x20;&#x2013;&#x20;including&#x20;payroll,&#x20;benefits,&#x20;contracting,&#x20;accounting,&#x20;grants&#x20;management,&#x20;HR,&#x20;legal,&#x20;and&#x20;regulatory&#x20;compliance&#x20;&#x2013;&#x20;without&#x20;getting&#x20;involved&#x20;in&#x20;those&#x20;programs&#x2019;&#x20;priorities.&#x20;If&#x20;desired,&#x20;it&#x20;also&#x20;helps&#x20;spin&#x20;projects&#x20;out&#x20;into&#x20;their&#x20;own&#x20;legal&#x20;entities&#x20;when&#x20;they&#x2019;re&#x20;ready.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Doing&#x20;this&#x20;well&#x20;means&#x20;building&#x20;a&#x20;world-class&#x20;operations&#x20;team&#x20;that&#x20;can&#x20;support&#x20;dozens&#x20;of&#x20;projects.&#x20;Strong&#x20;governance&#x20;and&#x20;risk-awareness&#x20;are&#x20;particularly&#x20;important&#x20;because&#x20;every&#x20;sponsored&#x20;project&#x20;sits&#x20;within&#x20;the&#x20;sponsor&#x2019;s&#x20;single&#x20;legal&#x20;entity,&#x20;so&#x20;any&#x20;serious&#x20;failure&#x20;&#x28;a&#x20;compliance&#x20;lapse,&#x20;a&#x20;governance&#x20;scandal&#x29;&#x20;can&#x20;spread&#x20;to&#x20;every&#x20;project&#x20;it&#x20;hosts.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;goal&#x20;is&#x20;for&#x20;the&#x20;ecosystem&#x20;to&#x20;seamlessly&#x20;sponsor&#x20;every&#x20;new&#x20;project&#x20;that&#x20;needs&#x20;it.&#x20;Over&#x20;the&#x20;next&#x20;couple&#x20;of&#x20;years,&#x20;successful&#x20;sponsors&#x20;would&#x20;scale&#x20;toward&#x20;dozens&#x20;of&#x20;active&#x20;projects,&#x20;onboard&#x20;new&#x20;projects&#x20;in&#x20;weeks&#x20;rather&#x20;than&#x20;months,&#x20;hold&#x20;strong&#x20;compliance&#x20;and&#x20;governance&#x20;as&#x20;they&#x20;grow,&#x20;and&#x20;receive&#x20;glowing&#x20;reviews&#x20;from&#x20;the&#x20;projects&#x20;they&#x20;host.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;re&#x20;interested&#x20;both&#x20;in&#x20;scaling&#x20;up&#x20;existing&#x20;AI&#x20;safety-focused&#x20;fiscal&#x20;sponsors&#x20;and&#x20;funding&#x20;strong&#x20;new&#x20;ones.&#x20;The&#x20;ideal&#x20;founding&#x20;team&#x20;combines&#x20;deep&#x20;operational&#x20;experience&#x20;with&#x20;understanding&#x20;of&#x20;the&#x20;AI&#x20;safety&#x20;ecosystem,&#x20;and&#x20;will&#x20;exercise&#x20;good&#x20;judgment&#x20;to&#x20;foster&#x20;their&#x20;projects&#x2019;&#x20;ambitions.&#x20;We&#x2019;re&#x20;especially&#x20;excited&#x20;about&#x20;founders&#x20;who&#x20;have&#x20;been&#x20;the&#x20;COO&#x20;or&#x20;equivalent&#x20;for&#x20;a&#x20;large&#x20;501&#x28;c&#x29;&#x28;3&#x29;,&#x20;led&#x20;a&#x20;team&#x20;through&#x20;significant&#x20;scaling,&#x20;or&#x20;owned&#x20;a&#x20;substantial&#x20;finance&#x20;or&#x20;HR&#x20;function.&#x20;Experience&#x20;with&#x20;multi-country&#x20;employment&#x20;and&#x20;nonprofit&#x20;compliance&#x20;is&#x20;a&#x20;strong&#x20;plus.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;convenings&quot;,&#x20;title&#x3A;&#x20;&quot;Convenings&quot;,&#x20;anchor&#x3A;&#x20;&quot;convenings&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;image&#x3A;&#x20;&quot;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;wp-content&#x2F;uploads&#x2F;crop_convenings.jpg&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;blurb&#x3A;&#x20;&quot;In-person&#x20;convenings&#x20;enable&#x20;high-bandwidth&#x20;communications&#x20;for&#x20;the&#x20;groups&#x20;shaping&#x20;AI&#x20;to&#x20;make&#x20;progress&#x20;on&#x20;key&#x20;safety&#x20;and&#x20;governance&#x20;questions.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;projects&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;cross-sector-convenings&quot;,&#x20;title&#x3A;&#x20;&quot;Cross-sector&#x20;convenings&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Asya&#x20;Bergal&quot;,&#x20;&quot;Liam&#x20;Alexander&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Facilitate&#x20;engagement&#x20;among&#x20;key&#x20;groups&#x20;working&#x20;on&#x20;frontier&#x20;AI.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;As&#x20;AI&#x20;progress&#x20;continues&#x20;and&#x20;transformative&#x20;AI&#x20;becomes&#x20;a&#x20;more&#x20;salient&#x20;topic,&#x20;groups&#x20;outside&#x20;the&#x20;AI&#x20;safety&#x20;community&#x20;are&#x20;becoming&#x20;increasingly&#x20;interested&#x20;in&#x20;consequential&#x20;governance&#x20;and&#x20;safety&#x20;questions.&#x20;This&#x20;includes&#x20;people&#x20;like&#x20;academics,&#x20;journalists,&#x20;public&#x20;intellectuals,&#x20;and&#x20;high-stakes&#x20;decision-makers&#x20;in&#x20;AI&#x20;&#x28;e.g.&#x20;people&#x20;working&#x20;inside&#x20;frontier&#x20;AI&#x20;companies,&#x20;in&#x20;national&#x20;security,&#x20;or&#x20;on&#x20;AI&#x20;policy&#x29;.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;think&#x20;in-person&#x20;convenings&#x20;effectively&#x20;create&#x20;opportunities&#x20;for&#x20;productive&#x20;engagement&#x20;between&#x20;these&#x20;different&#x20;groups.&#x20;Our&#x20;past&#x20;experience&#x20;indicates&#x20;these&#x20;kinds&#x20;of&#x20;convenings&#x20;are&#x20;routinely&#x20;self-reported&#x20;as&#x20;extremely&#x20;useful&#x20;by&#x20;attendees&#x20;&#x28;via&#x20;building&#x20;trust&#x20;and&#x20;relationships,&#x20;hearing&#x20;novel&#x20;perspectives,&#x20;and&#x20;generating&#x20;new&#x20;collaborations&#x29;,&#x20;and&#x20;we&#x27;ve&#x20;seen&#x20;existing&#x20;similar&#x20;events&#x20;&#x28;like&#x20;&#x5B;The&#x20;Curve&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;thecurve.goldengateinstitute.org&#x2F;&#x29;&#x20;and&#x20;&#x5B;Recursive&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;www.recursive.to&#x2F;&#x29;&#x29;&#x20;shape&#x20;attendees&#x2019;&#x20;thinking&#x20;and&#x20;follow-on&#x20;plans.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;primary&#x20;goal&#x20;is&#x20;to&#x20;create&#x20;good&#x20;environments&#x20;for&#x20;in-person&#x20;engagement&#x20;between&#x20;people&#x20;thinking&#x20;seriously&#x20;about&#x20;frontier&#x20;AI&#x20;systems.&#x20;These&#x20;could&#x20;take&#x20;the&#x20;form&#x20;of&#x20;conferences,&#x20;workshops,&#x20;structured&#x20;discussions&#x20;or&#x20;debates,&#x20;or&#x20;more&#x20;informal&#x20;events.&#x20;Successful&#x20;projects&#x20;will&#x20;think&#x20;carefully&#x20;about&#x20;the&#x20;branding,&#x20;content,&#x20;structure,&#x20;and&#x20;participant&#x20;set&#x20;of&#x20;the&#x20;events&#x20;they&#x20;run,&#x20;aiming&#x20;to&#x20;run&#x20;consistently&#x20;valuable&#x20;events&#x20;that&#x20;attract&#x20;strong&#x20;attendees&#x20;from&#x20;across&#x20;the&#x20;AI&#x20;space.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;be&#x20;excited&#x20;about&#x20;a&#x20;team&#x20;experimenting&#x20;with&#x20;different&#x20;formats&#x20;and&#x20;scaling&#x20;to&#x20;running&#x20;multiple&#x20;events&#x20;a&#x20;year,&#x20;potentially&#x20;in&#x20;different&#x20;categories.&#x20;Founders&#x20;with&#x20;strong&#x20;existing&#x20;networks&#x20;and&#x20;a&#x20;clear&#x20;vision&#x20;of&#x20;currently&#x20;missing&#x20;high-impact&#x20;events&#x20;might&#x20;be&#x20;especially&#x20;well&#x20;suited.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;subfield-forums&quot;,&#x20;title&#x3A;&#x20;&quot;Subfield&#x20;forums&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Asya&#x20;Bergal&quot;,&#x20;&quot;Qurat&#x20;Zainab&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Run&#x20;events&#x20;aimed&#x20;at&#x20;focusing&#x20;attention&#x20;on&#x20;specific&#x20;areas&#x20;within&#x20;AI&#x20;safety.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;think&#x20;events&#x20;focused&#x20;on&#x20;specific&#x20;areas&#x20;within&#x20;AI&#x20;safety,&#x20;like&#x20;&#x5B;ControlConf&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;controlconf.org&#x2F;&#x29;&#x20;and&#x20;&#x5B;AI&#x20;Security&#x20;Forum&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;aisecurity.forum&#x2F;&#x29;,&#x20;have&#x20;had&#x20;substantial&#x20;impact&#x20;by&#x20;convening&#x20;high-caliber&#x20;talent&#x20;with&#x20;expertise&#x20;or&#x20;interest&#x20;in&#x20;a&#x20;specific&#x20;area,&#x20;facilitating&#x20;conversations&#x20;about&#x20;what&#x20;work&#x20;seems&#x20;most&#x20;useful,&#x20;and&#x20;catalyzing&#x20;new&#x20;high-value&#x20;work&#x20;in&#x20;that&#x20;area.&#x20;We&#x20;think&#x20;there&#x2019;s&#x20;a&#x20;lot&#x20;of&#x20;room&#x20;to&#x20;run&#x20;similar&#x20;events&#x20;in&#x20;other&#x20;important&#x20;or&#x20;neglected&#x20;areas.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;to&#x20;see&#x20;more&#x20;conferences&#x20;or&#x20;workshops&#x20;in&#x20;neglected&#x20;AI&#x20;safety&#x20;subfields,&#x20;including&#x20;&#x28;not&#x20;a&#x20;complete&#x20;list&#x29;&#x3A;&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;AI&#x20;policy&#x20;design&#x20;or&#x20;implementation&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;AI&#x20;journalism&#x20;and&#x20;media&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;AI&#x20;lab&#x20;accountability&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;The&#x20;economics&#x20;of&#x20;transformative&#x20;AI&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Hardware&#x20;verification&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Successful&#x20;events&#x20;would&#x20;include&#x20;participation&#x20;from&#x20;key&#x20;organizations&#x20;already&#x20;working&#x20;in&#x20;the&#x20;relevant&#x20;areas,&#x20;as&#x20;well&#x20;as&#x20;strong&#x20;newcomers&#x20;who&#x20;might&#x20;be&#x20;good&#x20;fits&#x20;for&#x20;the&#x20;relevant&#x20;work.&#x20;The&#x20;best&#x20;versions&#x20;will&#x20;likely&#x20;include&#x20;both&#x20;discussion&#x20;of&#x20;current&#x20;frontier&#x20;work&#x20;and&#x20;explicit&#x20;time&#x20;for&#x20;networking&#x20;among&#x20;participants.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;This&#x20;work&#x20;could&#x20;be&#x20;done&#x20;by&#x20;organizations&#x20;already&#x20;working&#x20;in&#x20;a&#x20;relevant&#x20;area,&#x20;or&#x20;by&#x20;an&#x20;independent&#x20;team&#x20;with&#x20;buy-in&#x20;from&#x20;those&#x20;organizations.&#x20;We&#x20;could&#x20;also&#x20;imagine&#x20;an&#x20;independent&#x20;team&#x20;specializing&#x20;in&#x20;running&#x20;&#x5B;events&#x20;as&#x20;a&#x20;service&#x5D;&#x28;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;tailwind&#x2F;initiatives&#x2F;&#x23;events-as-a-service&#x29;,&#x20;then&#x20;collaborating&#x20;with&#x20;host&#x20;organizations&#x20;that&#x20;set&#x20;the&#x20;content&#x20;and&#x20;invitee&#x20;list&#x20;for&#x20;their&#x20;particular&#x20;subfields.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x7B;&#x20;id&#x3A;&#x20;&quot;events-as-a-service&quot;,&#x20;title&#x3A;&#x20;&quot;Events&#x20;as&#x20;a&#x20;service&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;endorsers&#x3A;&#x20;&#x5B;&quot;Asya&#x20;Bergal&quot;,&#x20;&quot;Qurat&#x20;Zainab&quot;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;oneLiner&#x3A;&#x20;&quot;Make&#x20;sure&#x20;every&#x20;organization&#x20;that&#x20;wants&#x20;to&#x20;run&#x20;an&#x20;event&#x20;can&#x20;do&#x20;so&#x20;easily.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;challenge&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;In-person&#x20;events&#x20;have&#x20;historically&#x20;been&#x20;extremely&#x20;impactful&#x20;&#x2013;&#x20;they&#x20;encourage&#x20;people&#x20;to&#x20;seriously&#x20;consider&#x20;careers&#x20;in&#x20;fields&#x20;they&#x2019;re&#x20;unfamiliar&#x20;with,&#x20;help&#x20;bring&#x20;productive&#x20;attention&#x20;to&#x20;important&#x20;or&#x20;neglected&#x20;topics,&#x20;and&#x20;facilitate&#x20;connections&#x20;that&#x20;lead&#x20;to&#x20;new&#x20;work.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;Many&#x20;organizations&#x20;in&#x20;the&#x20;transformative&#x20;AI&#x20;space&#x20;could&#x20;run&#x20;such&#x20;events&#x20;that&#x20;capitalize&#x20;on&#x20;their&#x20;brand,&#x20;expertise,&#x20;and&#x20;connections,&#x20;but&#x20;most&#x20;organizations&#x20;don&#x2019;t&#x20;have&#x20;enough&#x20;in-house&#x20;logistics&#x20;capacity&#x20;to&#x20;do&#x20;it&#x20;themselves.&#x20;This&#x20;presents&#x20;a&#x20;missed&#x20;opportunity.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;objective&#x3A;&#x20;&#x5B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x2019;d&#x20;like&#x20;there&#x20;to&#x20;be&#x20;one&#x20;or&#x20;more&#x20;teams&#x20;that&#x20;partner&#x20;with&#x20;other&#x20;organizations&#x20;in&#x20;the&#x20;space,&#x20;taking&#x20;on&#x20;the&#x20;logistics&#x20;to&#x20;enable&#x20;more&#x20;high-value&#x20;events.&#x20;The&#x20;partner&#x20;organization&#x20;would&#x20;be&#x20;responsible&#x20;for&#x20;the&#x20;content&#x20;and&#x20;invitee&#x20;list&#x20;of&#x20;an&#x20;event,&#x20;while&#x20;the&#x20;events&#x20;organization&#x20;would&#x20;be&#x20;responsible&#x20;for&#x20;everything&#x20;else&#x3A;&#x20;branding,&#x20;venue,&#x20;catering,&#x20;housing,&#x20;attendee&#x20;tracking,&#x20;etc.&#x20;The&#x20;best&#x20;version&#x20;of&#x20;this&#x20;organization&#x20;would&#x20;likely&#x20;include&#x20;active&#x20;&#x28;and&#x20;potentially&#x20;opinionated&#x29;&#x20;marketing&#x20;&#x2013;&#x20;actively&#x20;pitching&#x20;particular&#x20;events&#x20;or&#x20;event&#x20;types&#x20;to&#x20;other&#x20;organizations&#x20;in&#x20;the&#x20;space.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&quot;We&#x20;think&#x20;the&#x20;ideal&#x20;founding&#x20;team&#x20;would&#x20;have&#x20;significant&#x20;real-world&#x20;experience&#x20;running&#x20;events,&#x20;a&#x20;good&#x20;understanding&#x20;of&#x20;the&#x20;AI&#x20;safety&#x20;ecosystem,&#x20;strong&#x20;networks&#x20;within&#x20;the&#x20;space,&#x20;and&#x20;experience&#x20;scaling&#x20;an&#x20;operation&#x20;rapidly.&quot;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x5D;&#x20;&#x7D;&#x0D;&#x0A;&#x20;&#x20;&#x5D;&#x3B;&#x0D;&#x0A;&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x2F;&#x2A;&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;Search&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x2A;&#x2F;&#x0D;&#x0A;&#x20;&#x20;var&#x20;Q&#x20;&#x3D;&#x20;&quot;&quot;&#x3B;&#x20;&#x20;&#x20;&#x2F;&#x2F;&#x20;current&#x20;query&#x20;&#x28;trimmed&#x29;&#x3B;&#x20;&quot;&quot;&#x20;&#x3D;&#x20;show&#x20;everything&#x0D;&#x0A;&#x20;&#x20;var&#x20;SEARCH_ICO&#x20;&#x3D;&#x20;&#x27;&lt;svg&#x20;width&#x3D;&quot;15&quot;&#x20;height&#x3D;&quot;15&quot;&#x20;viewBox&#x3D;&quot;0&#x20;0&#x20;24&#x20;24&quot;&#x20;fill&#x3D;&quot;none&quot;&#x20;stroke&#x3D;&quot;currentColor&quot;&#x20;stroke-width&#x3D;&quot;1.8&quot;&#x20;stroke-linecap&#x3D;&quot;round&quot;&gt;&lt;circle&#x20;cx&#x3D;&quot;11&quot;&#x20;cy&#x3D;&quot;11&q