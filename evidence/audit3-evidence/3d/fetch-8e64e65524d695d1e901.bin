<!-- First-Touch Attribution → Calendly -->
<script>
(function () {
  var TTL = 5 * 24 * 60 * 60 * 1000; // 5 days
  var KEY = 'firstTouch';

  // ---- Capture first touch (any landing page, not just /post/)
  var stored = localStorage.getItem(KEY);
  var data = null;
  if (stored) {
    try {
      var o = JSON.parse(stored);
      if (Date.now() - o.t < TTL) data = o;
      else localStorage.removeItem(KEY);
    } catch (e) { localStorage.removeItem(KEY); }
  }

  if (!data) {
    var qs = new URLSearchParams(location.search);
    var ref = document.referrer;
    var refHost = '';
    try { refHost = ref ? new URL(ref).hostname.replace(/^www\./, '') : ''; } catch (e) {}

    var source, medium;
    if (qs.get('utm_source')) {                 // real campaign wins
      source = qs.get('utm_source');
      medium = qs.get('utm_medium') || 'referral';
    } else if (!refHost) {
      source = 'direct';  medium = 'none';
    } else if (/^(www\.)?google\./.test(refHost) || refHost === 'google.com') {
      source = 'google';  medium = 'organic';
    } else if (/bing|duckduckgo|yahoo|ecosia|brave|baidu|yandex/.test(refHost)) {
      source = refHost.split('.')[0];  medium = 'organic';
    } else if (refHost === location.hostname.replace(/^www\./, '')) {
      source = 'direct';  medium = 'none';      // internal nav / self-reload
    } else {
      source = refHost;   medium = 'referral';
    }

    data = {
      s: source,
      m: medium,
      c: qs.get('utm_campaign') || '',
      l: location.pathname,                     // landing page
      t: Date.now()
    };
    localStorage.setItem(KEY, JSON.stringify(data));
  }

  // ---- Stamp Calendly links (single pass, no duplicates)
  function stamp() {
    document.querySelectorAll('a[href*="calendly.com"]').forEach(function (link) {
      var url;
      try { url = new URL(link.href); } catch (e) { return; }
      url.searchParams.set('utm_source',  data.s);
      url.searchParams.set('utm_medium',  data.m);
      if (data.c) url.searchParams.set('utm_campaign', data.c);
      url.searchParams.set('utm_content', data.l);
      link.href = url.toString();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', stamp);
  } else {
    stamp();
  }
})();
</script>
