document.addEventListener("DOMContentLoaded", function () {
  const cookieName = "as_blog_modal_dismissed";
  const daysToExpire = 7;

  const modal = document.querySelector("#as-modal-wrapper");
  const closeBtn = document.querySelector("#as-modal-close");
  const notReadyBtn = document.querySelector("#as-modal-not-ready");

  function setCookie(name, value, days) {
    const date = new Date();
    date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);

    document.cookie =
      name + "=" + value +
      "; expires=" + date.toUTCString() +
      "; path=/" +
      "; SameSite=Lax";
  }

  function getCookie(name) {
    return document.cookie
      .split("; ")
      .some(cookie => cookie === name + "=true");
  }

  function permanentlyHideModal() {
    if (!modal) return;

    modal.style.setProperty("display", "none", "important");
    modal.style.setProperty("opacity", "0", "important");
    modal.style.setProperty("visibility", "hidden", "important");
    modal.style.setProperty("pointer-events", "none", "important");
  }

  function dismissModal() {
    setCookie(cookieName, "true", daysToExpire);
    permanentlyHideModal();
  }

  // If dismissed before, block it immediately
  if (getCookie(cookieName)) {
    permanentlyHideModal();

    // Webflow interactions may try to show it later, so block that too
    setTimeout(permanentlyHideModal, 3100);
    setTimeout(permanentlyHideModal, 3500);
    setTimeout(permanentlyHideModal, 5000);
  }

  if (closeBtn) {
    closeBtn.addEventListener("click", dismissModal);
  }

  if (notReadyBtn) {
    notReadyBtn.addEventListener("click", dismissModal);
  }
});
</script></div></div><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6331a9a50eb8aa687c52dd23" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6331a9a50eb8aa687c52dd23/js/webflow.schunk.36b8fb49256177c8.js" type="text/javascript" integrity="sha384-4abIlA5/v7XaW1HMXKBgnUuhnjBYJ/Z9C1OSg4OhmVw9O3QeHJ/qJqFBERCDPv7G" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6331a9a50eb8aa687c52dd23/js/webflow.schunk.2181b4063ab56ee6.js" type="text/javascript" integrity="sha384-fDyTva+9DSN5LjIh7NVXGH1wOBgpyRJQfiPJz4O9sH+s/6Ko9NFboVMXT+v/Pard" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6331a9a50eb8aa687c52dd23/js/webflow.d9e9c838.9c2e7c26b45143be.js" type="text/javascript" integrity="sha384-sIJeBhk3m6XNVFy6W4O8GTsCRP2e4kGl1ddivjHTzIcGjCv1Dj5xJWtYNAxwwjDA" crossorigin="anonymous"></script><script>
