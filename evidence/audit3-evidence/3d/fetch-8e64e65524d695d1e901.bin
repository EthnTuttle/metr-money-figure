<script>
  $(document).ready(function () {
    var cookieBtn = document.querySelector('.cookie-accept');
    var cookieBtnDecline = document.querySelector('.cookie-decline');
    
    cookieBtn.addEventListener('click', function () {
      localStorage.setItem('cookieAccepted', 'true');
    });
    cookieBtnDecline.addEventListener('click', function () {
      localStorage.setItem('cookieDeclined', 'true');
    });

    $(window).resize(function() {
      if (localStorage.getItem('cookieAccepted') === 'true' || localStorage.getItem('cookieDeclined') === 'true') {
        document.querySelector('.cookie-div').style.visibility = 'hidden';
      } else {
        document.querySelector('.cookie-div').style.visibility = 'visible';
      }
    });

    // Delay the initial visibility check for 5 seconds
    setTimeout(function() {
      if (localStorage.getItem('cookieAccepted') === 'true' || localStorage.getItem('cookieDeclined') === 'true') {
        document.querySelector('.cookie-div').style.visibility = 'hidden';
      } else {
        document.querySelector('.cookie-div').style.visibility = 'visible';
      }
    }, 5000); // 5000 milliseconds = 5 seconds
  });
</script>
