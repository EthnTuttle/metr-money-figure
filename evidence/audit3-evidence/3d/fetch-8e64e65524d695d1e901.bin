<script>
document.addEventListener("DOMContentLoaded", function() {
  const popupAngel = document.getElementById("popup-angel");
  const closePopupAngel = document.getElementById("close-popup-angel");

  closePopupAngel.addEventListener("click", function() {
    popupAngel.style.display = "none";
    localStorage.setItem("popupAngelClosed", "true");
  });

  // Delay display of popup
  setTimeout(function() {
    if (localStorage.getItem("popupAngelClosed") !== "true") {
      popupAngel.style.display = "block"; // Show the popup after 7 seconds if not previously closed
    }
  }, 7000); // 7000 milliseconds = 7 seconds
});
</script>
<script>
 
  $( document ).ready(function() {
    var rx = /^\w+([\\.-]?\w+)*@\w+([\\.-]?\w+)*(\.\w{2,3})+$/
	var mailchimpForm = document.getElementById('wf-form-mailchimp-form');
    var mailchimpFormInputs = mailchimpForm.querySelectorAll('input');
    
    mailchimpForm.addEventListener('submit', function () {
      var email = mailchimpForm.querySelector('#mailchimp-email')
      let submissionUrl = '';
      if (!rx.test(email.value)) {
        $('#wf-form-error').show()
      } else {
        $('#wf-form-error').hide()
      }
      
      mailchimpFormInputs.forEach(function (input) {
        const type = input.type;
        const link = input.getAttribute("link");
        const lname = input.getAttribute("lname");
        const fname = input.name;
        if (type === 'checkbox' && input.checked) {
          submissionUrl = link + '&EMAIL=' + email.value + '&FNAME=' + fname + '&LNAME=' + lname ;
          if (rx.test(email.value)) {
            $.ajax({
              type: 'POST',
              dataType: "jsonp",
              url: encodeURI(submissionUrl),
              data: {},
            });
          }
        }
      });
    });
    
    $('.investors-news').click(function() {
      if(!$('#investors-check').is(':checked')) {
      	$('#investors-check').trigger('click');
      }
      if($('#founders-check').is(':checked')) {
      	$('#founders-check').trigger('click');
      } 
    })
    
    $('.founders-news').click(function() {
      if($('#investors-check').is(':checked')) {
      	$('#investors-check').trigger('click');
      }
      if(!$('#founders-check').is(':checked')) {
      	$('#founders-check').trigger('click')
      }
      
    })
    
    $('.default-news').click(function() {
      if($('#founders-check').is(':checked')) {
      	$('#founders-check').trigger('click');
      }  
      if($('#investors-check').is(':checked')) {
      	$('#investors-check').trigger('click');
      }
    })
    
    
  });
</script>

<!-- Start of UTM Button Code -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Function to build query string from URL parameters
        function buildQueryString(urlParams) {
            const params = Array.from(urlParams.entries()).reduce((acc, [key, value]) => {
                acc[decodeURIComponent(key).replace(/\[\]$/, '')] = decodeURIComponent(value);
                return acc;
            }, {});

            return Object.keys(params).map(key => `${encodeURIComponent(key)}=${encodeURIComponent(params[key])}`).join('&');
        }

        // Function to update href for specific links
        function updateLinks(queryString) {
            document.querySelectorAll('a[href*="calendly.com"]').forEach(link => {
                link.href += (link.href.includes('?') ? '&' : '?') + queryString;
            });
        }

        const queryString = buildQueryString(new URLSearchParams(window.location.search));
        if (queryString) {
            updateLinks(queryString);
        }
    });
</script>
<!-- End of UTM Button Code -->

<script>
document.getElementById('rm-close-button').addEventListener('click', function() {
  // Store the current timestamp in localStorage
  const now = new Date().getTime();
  localStorage.setItem('lastClicked', now.toString());
});

window.addEventListener('load', function() {
  // Check if '?subscribed' is already in the URL
  const currentUrl = window.location.href;
  if (currentUrl.includes('?subscribed') || currentUrl.includes('&subscribed')) {
    // If '?subscribed' is already there, do nothing
    return;
  }

  // Retrieve the last clicked timestamp from localStorage
  const lastClicked = localStorage.getItem('lastClicked');
  if (lastClicked) {
    const now = new Date().getTime();
    const clickedDate = parseInt(lastClicked, 10);
    const daysSinceClicked = (now - clickedDate) / (1000 * 60 * 60 * 24);

    // Check if the button was clicked within the last 7 days
    if (daysSinceClicked <= 7) {
      const url = new URL(window.location.href);
      const hasQueryString = url.search.length > 0;

      if (hasQueryString) {
        url.search += '&subscribed';
      } else {
        url.search += '?subscribed';
      }

      // Refresh the page with the updated URL only if '?subscribed' wasn't part of the URL
      window.location.href = url.href;
    }
  }
});

</script>
