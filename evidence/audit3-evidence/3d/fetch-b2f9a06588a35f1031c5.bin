28-2026\":773.97974443,\"08-31-2026\":777.39972606}" || JSON.stringify([]);
        initializeStockGraph(pricingGraphData);

        const filterMonthsContainers = document.querySelectorAll('.filter-months');
        const stockChangeElement = document.querySelector('.stock-change');

        if (filterMonthsContainers.length > 0 && stockChangeElement && window.stockPeriodsData) {
            const selectTab = function(tab) {
                const selectedPeriod = parseInt(tab.getAttribute('data-month'));

                // Sync active state across all filter containers
                filterMonthsContainers.forEach(function(cont) {
                    cont.querySelectorAll('span[data-month]').forEach(function(s) {
                        s.classList.remove('active');
                        s.setAttribute('aria-selected', 'false');
                        s.setAttribute('tabindex', '-1');
                    });
                    const target = cont.querySelector('span[data-month="' + selectedPeriod + '"]');
                    if (target) {
                        target.classList.add('active');
                        target.setAttribute('aria-selected', 'true');
                        target.setAttribute('tabindex', '0');
                    }
                });

                // Update stock change indicator
                const data = window.stockPeriodsData[selectedPeriod];
                if (data) {
                    const sign = data.usd >= 0 ? '+' : '-';
                    const changeClass = data.direction === 'up' ? 'change-up' : 'change-down';
                    stockChangeElement.innerHTML = '<span class="' + changeClass + '">' + sign + Math.abs(data.percent).toFixed(2) + '%</span>';
                    stockChangeElement.setAttribute('data-period', selectedPeriod);
                }
            };

            filterMonthsContainers.forEach(function(container) {
                const tabs = Array.from(container.querySelectorAll('span[data-month]'));

                tabs.forEach(function(span, index) {
                    span.addEventListener('click', function() {
                        selectTab(this);
                    });

                    span.addEventListener('keydown', function(event) {
                        if (event.key === 'Enter' || event.key === ' ') {
                            event.preventDefault();
                            selectTab(this);
                            return;
                        }

                        let newIndex = null;
                        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
                            newIndex = (index + 1) % tabs.length;
                        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
                            newIndex = (index - 1 + tabs.length) % tabs.length;
                        } else if (event.key === 'Home') {
                            newIndex = 0;
                        } else if (event.key === 'End') {
                            newIndex = tabs.length - 1;
                        }

                        if (newIndex !== null) {
                            event.preventDefault();
                            tabs[newIndex].focus();
                            selectTab(tabs[newIndex]);
                        }
                    });
                });
            });
        }
    });
</script>


