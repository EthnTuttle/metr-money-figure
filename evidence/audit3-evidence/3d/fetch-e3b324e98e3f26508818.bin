 followers."},"bookmarkCount":0,"replyCount":1,"repostCount":0,"likeCount":1,"quoteCount":0,"indexedAt":"2026-03-30T04:09:10.247Z","labels":[]},"parent":{"post":{"uri":"at://did:plc:7h5okj6yhcq6twydcu7trhv2/app.bsky.feed.post/3miarxk5f422h","cid":"bafyreicnnskthc2gcumjyrxh2azfpchknmmuaaukqx73pwisaz6z3gmzha","author":{"did":"did:plc:7h5okj6yhcq6twydcu7trhv2","handle":"pjkaz.bsky.social","displayName":"Peter K Needs to Catch Up On Content","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:7h5okj6yhcq6twydcu7trhv2/bafkreieypwyg7yhpsim3dh2yvfd56iqqy72jpysionumpcikopvl2ze5n4","associated":{"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[{"src":"did:plc:7h5okj6yhcq6twydcu7trhv2","uri":"at://did:plc:7h5okj6yhcq6twydcu7trhv2/app.bsky.actor.profile/self","cid":"bafyreihjck4znfrbelcacpocz7jhu5izulm7ebiwl7baidefe6ytb4zd24","val":"!no-unauthenticated","cts":"2024-05-07T16:11:26.567Z"}],"createdAt":"2024-05-07T16:11:26.435Z"},"record":{"$type":"app.bsky.feed.post","createdAt":"2026-03-30T04:06:51.688Z","langs":["en"],"reply":{"parent":{"cid":"bafyreic3t73rytys2wvzeebrieeylme6fqvwvvd7xnhobnp5uynfwg6nxy","uri":"at://did:plc:z7oad4td5k4tfb4dttzjym7r/app.bsky.feed.post/3miark5rkpk24"},"root":{"cid":"bafyreiauxgyxtkxuk6rgonxiam6ukfzq736cak2ramkoyrtu3t56vdzwq4","uri":"at://did:plc:qc6xzgctorfsm35w6i3vdebx/app.bsky.feed.post/3miabmrzhh22m"}},"text":"It’s probably easy to monetize hate of it for clout/as an exercise in brand building\n\n(instead of it just being a technology with pros, cons, and impact on society like any other$"},"bookmarkCount":0,"replyCount":1,"repostCount":0,"likeCount":2,"quoteCount":0,"indexedAt":"2026-03-30T04:06:52.063Z","labels":[]},"parent":{"post":{"uri":"at://did:plc:z7oad4td5k4tfb4dttzjym7r/app.bsky.feed.post/3miark5rkpk24","cid":"bafyreic3t73rytys2wvzeebrieeylme6fqvwvvd7xnhobnp5uynfwg6nxy","author":{"did":"did:plc:z7oad4td5k4tfb4dttzjym7r","handle":"moskov.goodventures.org","displayName":"Dustin Moskovitz","avatar":"https://cdn.b