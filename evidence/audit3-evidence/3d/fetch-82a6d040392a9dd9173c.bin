m64jbq","uri":"at://did:plc:2n3yvfeeqyognzqc6lylxhnk/app.bsky.feed.post/3mhz7hxh5gt2e"}},"facets":[{"features":[{"$type":"app.bsky.richtext.facet#link","uri":"https://bsky.app/profile/justinbuist.bsky.social/post/3mhz7hxh5gt2e"}],"index":{"byteEnd":243,"byteStart":219}}],"langs":["en"],"reply":{"parent":{"cid":"bafyreigijmsapmmfedmcvcqohpfehuf5foms7b36kqiuntykfptvxx63wa","uri":"at://did:plc:blh6ymhsaivumkktbp6xxc3m/app.bsky.feed.post/3mibnlhndos2y"},"root":{"cid":"bafyreiauxgyxtkxuk6rgonxiam6ukfzq736cak2ramkoyrtu3t56vdzwq4","uri":"at://did:plc:qc6xzgctorfsm35w6i3vdebx/app.bsky.feed.post/3miabmrzhh22m"}},"text":"I didn’t say “because reasons”, I said he does this every 3 days, people often correct him with private or public facts and he persists anyway. Here is an example requiring no knowledge about Anthropic financials bsky.app/profile/just... his original conspiracy theory relies on misunderstand this"},"embed":{"record":{"uri":"at://did:plc:2n3yvfeeqyognzqc6lylxhnk/app.bsky.feed.post/3mhz7hxh5gt2e","cid":"bafyreia6bvf7g7x7ozzd35a7xq7qsvympqdlafqfh5727fox6qubm64jbq","author":{"did":"did:plc:2n3yvfeeqyognzqc6lylxhnk","handle":"justinbuist.bsky.social","displayName":"Justin Buist","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:2n3yvfeeqyognzqc6lylxhnk/bafkreiepw6dq6yjmjolwijrljbncsus2pfbw2yb5si22zul6ubiqeouvfu","associated":{"chat":{"allowIncoming":"none","allowGroupInvites":"none"},"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[],"createdAt":"2023-11-06T01:29:08.193Z"},"value":{"$type":"app.bsky.feed.post","createdAt":"2026-03-27T03:47:23.248Z","langs":["en"],"reply":{"parent":{"cid":"bafyreibpaaqxgcvio4hdgkrzroefhop5ocezyqjbbsjr3hke7ut6o63gde","uri":"at://did:plc:7n5zoyo5ze56ml6szcpmx6zn/app.bsky.feed.post/3mhz5sqbqjc2y"},"root":{"cid":"bafyreibbzkktz3zoohcko627cntdvgrtqsn6d5prjxrgqg4gc4kuej4eue","uri":"at://did:plc:qc6xzgctorfsm35w6i3vdebx/app.bsky.feed.post/3mhz5nc7u6s2t"}},"text":"There are 52 weeks in a year (13 * 4) and 12 months in a year. \n\nSo you take your last 4 weeks of API sales and multiply by 13 to get the estimated total revenue for API calls since they bill weekly.\n\nThe subscriptions bill monthly so you multiply that by 12 because there are 12 months in a year."},"labels":[],"likeCount":2,"replyCount":2,"repostCount":0,"quoteCount":1,"indexedAt":"2026-03-27T03:47:24.359Z","embeds":[],"$type":"app.bsky.embed.record#viewRecord"},"$type":"app.bsky.embed.record#view"},"bookmarkCount":0,"replyCount":1,"repostCount":0,"likeCount":0,"quoteCount":0,"indexedAt":"2026-03-30T12:24:25.250Z","labels":[]},"replies":[{"post":{"uri":"at://did:plc:z7oad4td5k4tfb4dttzjym7r/app.bsky.feed.post/3mibnthloj22g","cid":"bafyreid7ru32nqn4rfczfhcz5w3vujb3hatzr3ahgrjvmlctabbaz56rji","author":{"did":"did:plc:z7oad4td5k4tfb4dttzjym7r","handle":"moskov.goodventures.org","displayName":"Dustin Moskovitz","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:z7oad4td5k4tfb4dttzjym7r/bafkreiapds4x6n2sobfyijxfnel5dvcxbzycvrwa7trogzz62o5lkhc7y4","associated":{"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[],"createdAt":"2023-04-10T16:53:51.956Z","verification":{"verifications":[{"issuer":"did:plc:z72i7hdynmk6r22z27h6tvur","issuerDisplayName":"Bluesky","issuerHandle":"bsky.app","uri":"at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.graph.verification/3lvdc6hlzcy2l","isValid":true,"createdAt":"2025-08-01T09:03:42.030Z"}],"verifiedStatus":"valid","trustedVerifierStatus":"none"}},"record":{"$type":"app.bsky.feed.post","createdAt":"2026-03-30T12:25:39.565Z","langs":["en"],"reply":{"parent":{"cid":"bafyreih7odetaqon3wkvyqt5al6ekfqmot6zc4vsw7u3lhb6afehfg432i","uri":"at://did:plc:z7oad4td5k4tfb4dttzjym7r/app.bsky.feed.post/3mibnra7zec2g"},"root":{"cid":"bafyreiauxgyxtkxuk6rgonxiam6ukfzq736cak2ramkoyrtu3t56vdzwq4","uri":"at://did:plc:qc6xzgctorfsm35w6i3vdebx/app.bsky.feed.post/3miabmrzhh22m"}},"text":"He replies to it just in case there is another way he turns out to be right but it’s not true eith