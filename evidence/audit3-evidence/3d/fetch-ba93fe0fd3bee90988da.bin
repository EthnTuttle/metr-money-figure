    /***** Beginning of styles for displaying attachment document list div (after click on pushpin) ****/
    .styAttachmentDocListDiv { /* The attachment document list DIV class (for pushpin) */
      display: none; /* Hidden by default */
      position: fixed; /* Stay in place */
      z-index: 1; /* Sit on top */
      padding-top: 0px;
      left:0;
      top:0;
      width: 300px; /* Full width */
      height: 120px; /* Full height */
      overflow: auto;   /* Enable scroll if needed */
      background-color: white;
      border: 2px solid gray;
      margin:0px;
      align-content: center;
      resize: both; /* Div can be resized by dragging the bottom right corner */
    }
    .styAttachmentDocListDivTitle { /* The attachment document list title class (for pushpin) */
      height:auto;
      min-height:8mm;
      width:300px;
      color:black;
      font-size:9pt;
      font-weight:bold;
      position:sticky; /* Ensure the title bar stays in place even if the body is scrolled */
      top:0;
      background-color:#95c0ff;
    }
    .styAttachmentDocListDivBody { /* The attachment document list title class (for pushpin) */
