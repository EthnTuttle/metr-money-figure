;&#x20;&#x20;&#x20;&lt;div&#x20;class&#x3D;&quot;cg-fc__bar&quot;&#x20;id&#x3D;&quot;cgfc-bar-future&quot;&gt;&lt;&#x2F;div&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;div&#x20;class&#x3D;&quot;cg-fc__axis&#x20;cg-fc__axis--future&quot;&gt;Future&lt;&#x2F;div&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;&#x2F;div&gt;&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&lt;&#x2F;div&gt;&#x0D;&#x0A;&#x20;&#x20;&lt;&#x2F;div&gt;&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&lt;&#x21;--&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x20;ACCORDION&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x20;--&gt;&#x0D;&#x0A;&#x20;&#x20;&lt;&#x21;--&#x20;Last&#x20;in&#x20;source&#x20;order&#x20;so&#x20;the&#x20;stacked&#x20;layout&#x20;reads&#x20;statements&#x20;&#x2192;&#x20;chart&#x20;&#x2192;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;accordion&#x3B;&#x20;on&#x20;desktop&#x20;it&#x27;s&#x20;placed&#x20;back&#x20;into&#x20;column&#x20;1,&#x20;row&#x20;2.&#x20;--&gt;&#x0D;&#x0A;&#x20;&#x20;&lt;div&#x20;class&#x3D;&quot;cg-fc__accordion&quot;&#x20;id&#x3D;&quot;cgfc-accordion&quot;&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&lt;button&#x20;type&#x3D;&quot;button&quot;&#x20;class&#x3D;&quot;cg-fc__toggle&quot;&#x20;id&#x3D;&quot;cgfc-toggle&quot;&#x20;aria-expanded&#x3D;&quot;false&quot;&#x20;aria-controls&#x3D;&quot;cgfc-panel&quot;&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;span&gt;Why&#x20;this&#x20;may&#x20;be&#x20;the&#x20;best&#x20;time&#x20;for&#x20;you&#x20;to&#x20;launch&#x20;something&#x20;new&lt;&#x2F;span&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;&#x21;--&#x20;Squared&#x20;ends&#x20;&#x28;butt&#x20;caps&#x29;,&#x20;arms&#x20;running&#x20;nearly&#x20;the&#x20;full&#x20;box&#x20;so&#x20;the&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;mark&#x20;sits&#x20;close&#x20;to&#x20;the&#x20;circle&#x27;s&#x20;edge&#x20;rather&#x20;than&#x20;floating.&#x20;--&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;span&#x20;class&#x3D;&quot;cg-fc__mark&quot;&#x20;aria-hidden&#x3D;&quot;true&quot;&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;svg&#x20;viewBox&#x3D;&quot;0&#x20;0&#x20;16&#x20;16&quot;&#x20;fill&#x3D;&quot;none&quot;&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;path&#x20;d&#x3D;&quot;M1&#x20;8h14&quot;&#x20;stroke&#x3D;&quot;currentColor&quot;&#x20;stroke-width&#x3D;&quot;2&quot;&#x20;stroke-linecap&#x3D;&quot;butt&quot;&gt;&lt;&#x2F;path&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;path&#x20;class&#x3D;&quot;cg-fc__mark-bar&quot;&#x20;d&#x3D;&quot;M8&#x20;1v14&quot;&#x20;stroke&#x3D;&quot;currentColor&quot;&#x20;stroke-width&#x3D;&quot;2&quot;&#x20;stroke-linecap&#x3D;&quot;butt&quot;&gt;&lt;&#x2F;path&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;&#x2F;svg&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;&#x2F;span&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&lt;&#x2F;button&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&lt;div&#x20;class&#x3D;&quot;cg-fc__panel&quot;&#x20;id&#x3D;&quot;cgfc-panel&quot;&#x20;role&#x3D;&quot;region&quot;&#x20;aria-labelledby&#x3D;&quot;cgfc-toggle&quot;&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;div&#x20;class&#x3D;&quot;cg-fc__panel-inner&quot;&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;p&gt;The&#x20;window&#x20;of&#x20;time&#x20;before&#x20;transformative&#x20;AI&#x20;arrives&#x20;&lt;a&#x20;href&#x3D;&quot;https&#x3A;&#x2F;&#x2F;jack-clark.net&#x2F;2026&#x2F;05&#x2F;04&#x2F;import-ai-455-automating-ai-research&#x2F;&quot;&#x20;target&#x3D;&quot;_blank&quot;&#x20;rel&#x3D;&quot;noopener&#x20;noreferrer&quot;&gt;may&#x20;be&lt;&#x2F;a&gt;&#x20;&lt;a&#x20;href&#x3D;&quot;https&#x3A;&#x2F;&#x2F;www.planned-obsolescence.org&#x2F;p&#x2F;six-milestones-for-ai-automation&quot;&#x20;target&#x3D;&quot;_blank&quot;&#x20;rel&#x3D;&quot;noopener&#x20;noreferrer&quot;&gt;very&lt;&#x2F;a&gt;&#x20;&lt;a&#x20;href&#x3D;&quot;https&#x3A;&#x2F;&#x2F;www.alignmentforum.org&#x2F;posts&#x2F;dKpC6wHFqDrGZwnah&#x2F;ais-can-now-often-do-massive-easy-to-verify-swe-tasks-and-i&quot;&#x20;target&#x3D;&quot;_blank&quot;&#x20;rel&#x3D;&quot;noopener&#x20;noreferrer&quot;&gt;short&lt;&#x2F;a&gt;.&#x20;And&#x20;we&#x20;expect&#x20;&lt;a&#x20;href&#x3D;&quot;https&#x3A;&#x2F;&#x2F;nanransohoff.substack.com&#x2F;p&#x2F;the-third-wave-of-american-philanthropy&quot;&#x20;target&#x3D;&quot;_blank&quot;&#x20;rel&#x3D;&quot;noopener&#x20;noreferrer&quot;&gt;much&#x20;more&#x20;funding&lt;&#x2F;a&gt;&#x20;for&#x20;this&#x20;work&#x20;could&#x20;arrive&#x20;soon.&lt;&#x2F;p&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;p&gt;Launching&#x20;new&#x20;initiatives&#x20;now&#x20;lays&#x20;the&#x20;groundwork&#x20;for&#x20;the&#x20;entire&#x20;ecosystem&#x20;to&#x20;scale.&#x20;Teams&#x20;that&#x20;received&#x20;&#x24;1&#x2013;2&#x20;million&#x20;from&#x20;us&#x20;four&#x20;years&#x20;ago&#x20;can&#x20;now&#x20;productively&#x20;deploy&#x20;20x&#x20;that&#x20;amount&#x20;every&#x20;year&#x3B;&#x20;we&#x2019;d&#x20;like&#x20;many&#x20;more&#x20;initiatives&#x20;to&#x20;scale&#x20;even&#x20;larger&#x20;and&#x20;faster&#x20;over&#x20;the&#x20;next&#x20;2&#x2013;3&#x20;years.&#x20;Yours&#x20;could&#x20;be&#x20;one&#x20;of&#x20;them.&lt;&#x2F;p&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&lt;&#x2F;div&gt;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&lt;&#x2F;div&gt;&#x0D;&#x0A;&#x20;&#x20;&lt;&#x2F;div&gt;&#x0D;&#x0A;&lt;&#x2F;div&gt;&#x0D;&#x0A;&#x0D;&#x0A;&lt;script&gt;&#x0D;&#x0A;&#x28;function&#x20;&#x28;&#x29;&#x20;&#x7B;&#x0D;&#x0A;&#x20;&#x20;&#x27;use&#x20;strict&#x27;&#x3B;&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x2F;&#x2A;&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x20;CONFIG&#x20;&#x2014;&#x20;tune&#x20;the&#x20;chart&#x20;here&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x20;&#x2A;&#x2F;&#x0D;&#x0A;&#x20;&#x20;var&#x20;CONFIG&#x20;&#x3D;&#x20;&#x7B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;pastAmount&#x3A;&#x20;350,&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2F;&#x2A;&#x20;&#x24;M&#x20;directed&#x20;last&#x20;year&#x20;&#x20;&#x20;&#x28;2025&#x20;column&#x29;&#x20;&#x20;&#x2A;&#x2F;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;nowAmount&#x3A;&#x20;1000,&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2F;&#x2A;&#x20;&#x24;M&#x20;projected&#x20;this&#x20;year&#x20;&#x20;&#x28;2026&#x20;column&#x29;&#x20;&#x20;&#x2A;&#x2F;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;showFuture&#x3A;&#x20;true,&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2F;&#x2A;&#x20;draw&#x20;the&#x20;wide&#x20;&quot;Future&quot;&#x20;field&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2A;&#x2F;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;proseNumeralsSans&#x3A;&#x20;false,&#x20;&#x2F;&#x2A;&#x20;set&#x20;true&#x20;for&#x20;sans&#x20;numerals&#x20;in&#x20;the&#x20;prose&#x20;&#x2A;&#x2F;&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;unit&#x3A;&#x20;5,&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2F;&#x2A;&#x20;&#x24;M&#x20;represented&#x20;by&#x20;one&#x20;cell&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2A;&#x2F;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;cell&#x3A;&#x20;10,&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2F;&#x2A;&#x20;cell&#x20;edge,&#x20;px&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#