    x-data="{
      styles: { '--width': 0 },
      init() {
        const nav = $el.querySelector('.subnav');
        const items = [...nav.querySelectorAll('.subnav__item')];
        items.forEach(item => {
          if (item.classList.contains('active')) {
            item.style.anchorName = '--hovered';
            const { width } = item.getBoundingClientRect();
            this.styles['--width'] = `${width}px`;
          } else {
            item.style.anchorName = '';
          }
        })
      },
      setWidth(e) {
        const nav = $el.querySelector('.subnav');
        const items = [...nav.querySelectorAll('.subnav__item')];
        items.forEach(item => {
          if (item == e.target) {
            item.style.anchorName = '--hovered';
          } else {
            item.style.anchorName = '';
          }
        })
        const { width } = e.target.getBoundingClientRect();
        this.styles['--width'] = `${width}px`;
      }
    }"
    x-init="init"
    :style="styles"
    @risize.window="init"
