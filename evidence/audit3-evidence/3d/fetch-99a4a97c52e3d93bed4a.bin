0;&#x20;&#x20;&#x20;&#x20;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x3D;&#x20;&#x2A;&#x2F;&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;var&#x20;OPTIONS&#x20;&#x3D;&#x20;&#x7B;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;heading&#x3A;&#x20;&quot;Take&#x20;&#x28;an&#x29;&#x20;initiative.&quot;,&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;&#x2F;&#x2F;&#x20;Subhead&#x20;supports&#x20;one&#x20;inline&#x20;link,&#x20;written&#x20;as&#x20;&#x7B;text&#x7C;url&#x7D;.&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;subhead&#x3A;&#x20;&quot;Coefficient&#x2019;s&#x20;grantmakers&#x20;have&#x20;curated&#x20;&#x7B;ideas&#x7C;https&#x3A;&#x2F;&#x2F;coefficientgiving.org&#x2F;tailwind&#x2F;initiatives&#x2F;&#x7D;&#x20;for&#x20;gaps&#x20;in&#x20;the&#x20;ecosystem&#x20;we&#x20;want&#x20;to&#x20;see&#x20;filled,&#x20;but&#x20;the&#x20;best&#x20;founders&#x20;will&#x20;bring&#x20;their&#x20;own&#x20;conviction.&quot;,&#x0D;&#x0A;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;scrollSpeed&#x3A;&#x20;22,&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2F;&#x2F;&#x20;px&#x2F;second&#x20;for&#x20;the&#x20;auto-scroll&#x20;ticker&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;autoScroll&#x3A;&#x20;true,&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2F;&#x2F;&#x20;false&#x20;&#x3D;&#x20;start&#x20;paused&#x20;&#x28;reduced-motion&#x20;also&#x20;starts&#x20;paused&#x29;&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;showPlayButton&#x3A;&#x20;true,&#x20;&#x20;&#x20;&#x2F;&#x2F;&#x20;pause&#x2F;play&#x20;control&#x20;between&#x20;the&#x20;two&#x20;arrows&#x0D;&#x0A;&#x20;&#x20;&#x20;&#x20;loop&#x3A;&#x20;true&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x20;&#x2